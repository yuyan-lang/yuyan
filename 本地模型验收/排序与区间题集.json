  {"id":81,"title":"合并重叠区间","signature":"化（「列」于（「整数」合「整数」））而（「列」于（「整数」合「整数」））","statement":"输入可无序；相交或端点相接的闭区间合并，结果按起点升序。","arg_types":["list_pair_int"],"result_type":"list_pair_int","cases":[{"args":[[[1,3],[2,6],[8,10],[15,18]]],"expected":[[1,6],[8,10],[15,18]]},{"args":[[[1,4],[4,5]]],"expected":[[1,5]]},{"args":[[]],"expected":[]},{"args":[[[1,2]]],"expected":[[1,2]]},{"args":[[[5,7],[1,3]]],"expected":[[1,3],[5,7]]}]},
  {"id":82,"title":"插入新区间","signature":"化（「列」于（「整数」合「整数」））而化（「整数」合「整数」）而（「列」于（「整数」合「整数」））","statement":"旧区间已按起点升序且互不重叠，插入新闭区间后合并重叠或相接部分并保持升序。","arg_types":["list_pair_int","pair_int"],"result_type":"list_pair_int","cases":[{"args":[[[1,3],[6,9]],[2,5]],"expected":[[1,5],[6,9]]},{"args":[[[1,2],[3,5],[6,7],[8,10],[12,16]],[4,8]],"expected":[[1,2],[3,10],[12,16]]},{"args":[[],[5,7]],"expected":[[5,7]]},{"args":[[[1,5]],[2,3]],"expected":[[1,5]]},{"args":[[[1,5]],[6,8]],"expected":[[1,5],[6,8]]}]},
  {"id":83,"title":"同时所需会议室数","signature":"化（「列」于（「整数」合「整数」））而「整数」","statement":"每对是半开时间段 [开始,结束)，结束时刻可立即供另一会议使用；返回最大同时进行数。","arg_types":["list_pair_int"],"result_type":"整数","cases":[{"args":[[[0,30],[5,10],[15,20]]],"expected":"2"},{"args":[[[7,10],[2,4]]],"expected":"1"},{"args":[[]],"expected":"0"},{"args":[[[0,1],[1,2]]],"expected":"1"},{"args":[[[0,5],[1,4],[2,3]]],"expected":"3"}]},
  {"id":84,"title":"第 k 大元素","signature":"化（「列」于「整数」）而化「整数」而「整数」","statement":"输入非空且 1≤k≤列表长度；按含重复元素的降序排序，第 k 项即答案。","arg_types":["list_int","整数"],"result_type":"整数","cases":[{"args":[[3,2,1,5,6,4],2],"expected":"5"},{"args":[[3,2,3,1,2,4,5,5,6],4],"expected":"4"},{"args":[[1],1],"expected":"1"},{"args":[[-1,-2],1],"expected":"-1"},{"args":[[2,2,2],2],"expected":"2"}]},
  {"id":85,"title":"出现频率最高的 k 项","signature":"化（「列」于「整数」）而化「整数」而（「列」于「整数」）","statement":"按频率降序取不同值；同频时较小整数先出现。0≤k≤不同值个数。","arg_types":["list_int","整数"],"result_type":"列整数","cases":[{"args":[[1,1,1,2,2,3],2],"expected":[1,2]},{"args":[[1],1],"expected":[1]},{"args":[[1,2,3],2],"expected":[1,2]},{"args":[[4,4,3,3,2],2],"expected":[3,4]},{"args":[[],0],"expected":[]}]},
  {"id":86,"title":"逆序对个数","signature":"化（「列」于「整数」）而「整数」","statement":"统计下标 i<j 且值 a[i]>a[j] 的配对数；相等不算。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[7,5,6,4]],"expected":"5"},{"args":[[1,2,3]],"expected":"0"},{"args":[[3,2,1]],"expected":"3"},{"args":[[]],"expected":"0"},{"args":[[1,1]],"expected":"0"}]},
  {"id":87,"title":"按参考次序排序","signature":"化（「列」于「整数」）而化（「列」于「整数」）而（「列」于「整数」）","statement":"参考列表值互不相同且均出现在第一列表；先按参考列表的值顺序放入第一列表中对应的所有出现项，剩余值升序放末尾。","arg_types":["list_int","list_int"],"result_type":"列整数","cases":[{"args":[[2,3,1,3,2,4,6,7,9,2,19],[2,1,4,3,9,6]],"expected":[2,2,2,1,4,3,3,9,6,7,19]},{"args":[[3,1,2],[]],"expected":[1,2,3]},{"args":[[1,1,2],[1]],"expected":[1,1,2]},{"args":[[],[]],"expected":[]},{"args":[[-1,2,-1,3],[3]],"expected":[3,-1,-1,2]}]},
  {"id":88,"title":"合并多个有序列表","signature":"化（「列」于（「列」于「整数」））而（「列」于「整数」）","statement":"各子列表均非递减，合并后仍非递减，保留重复值。","arg_types":["list_list_int"],"result_type":"列整数","cases":[{"args":[[[1,4,5],[1,3,4],[2,6]]],"expected":[1,1,2,3,4,4,5,6]},{"args":[[]],"expected":[]},{"args":[[[]]],"expected":[]},{"args":[[[0],[-1]]],"expected":[-1,0]},{"args":[[[1,1],[1]]],"expected":[1,1,1]}]},
  {"id":89,"title":"链表排序","signature":"化（「列」于「整数」）而（「列」于「整数」）","statement":"输入是持久单向链表，返回非递减排序的新列表。","arg_types":["list_int"],"result_type":"列整数","cases":[{"args":[[4,2,1,3]],"expected":[1,2,3,4]},{"args":[[-1,5,3,4,0]],"expected":[-1,0,3,4,5]},{"args":[[]],"expected":[]},{"args":[[1]],"expected":[1]},{"args":[[2,2,1]],"expected":[1,2,2]}]},
  {"id":90,"title":"数字拼接成最大值","signature":"化（「列」于「整数」）而「字符串」","statement":"输入非空且各值非负，重排后拼接各值的十进制表示，使所得字符串对应的整数最大；若全为零只返回 0。","arg_types":["list_int"],"result_type":"字符串","cases":[{"args":[[10,2]],"expected":"210"},{"args":[[3,30,34,5,9]],"expected":"9534330"},{"args":[[0,0]],"expected":"0"},{"args":[[1]],"expected":"1"},{"args":[[12,121]],"expected":"12121"}]}
]
