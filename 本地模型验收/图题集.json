  {"id":66,"title":"带权图网络延迟","signature":"化「整数」而化（「列」于（「整数」合「整数」合「整数」））而化「整数」而「整数」","statement":"节点编号 0 至 n-1，三元组为有向边起点、终点、正权重；从指定源发消息，返回所有节点最短到达时间的最大值，有节点不可达则负一。","arg_types":["整数","list_triple_int","整数"],"result_type":"整数","cases":[{"args":[4,[[1,0,1],[1,2,1],[2,3,1]],1],"expected":"2"},{"args":[2,[[0,1,5]],0],"expected":"5"},{"args":[2,[[0,1,5]],1],"expected":"-1"},{"args":[1,[],0],"expected":"0"},{"args":[3,[[0,1,2],[0,2,5],[1,2,1]],0],"expected":"3"}]},
  {"id":67,"title":"无权图最短路径长度","signature":"化（「列」于（「列」于「整数」））而化「整数」而化「整数」而「整数」","statement":"邻接表表示有向图，返回从起点到终点的最少边数；不可达返回负一。","arg_types":["list_list_int","整数","整数"],"result_type":"整数","cases":[{"args":[[[1,2],[2],[3],[]],0,3],"expected":"2"},{"args":[[[1,2],[2],[3],[]],1,0],"expected":"-1"},{"args":[[[]],0,0],"expected":"0"},{"args":[[[1],[2],[]],0,2],"expected":"2"},{"args":[[[1],[0]],1,0],"expected":"1"}]},
