{
  "name": "yuyan-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 测试/*.mjs",
    "检查配置": "WRANGLER_LOG_PATH=/tmp/yy-playground-wrangler.log wrangler deploy --config 云端配置.jsonc --dry-run",
    "部署": "wrangler deploy --config 云端配置.jsonc",
    "开发": "wrangler dev --config 云端配置.jsonc",
    "准备界面": "mkdir -p 网页/共用 && cp ../../网站/共用/* 网页/共用/",
    "pre检查配置": "npm run 准备界面",
    "pre部署": "npm run 准备界面",
    "pre开发": "npm run 准备界面"
  },
  "dependencies": {
    "binaryen": "132.0.0"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}
