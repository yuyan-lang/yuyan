# 古曰：取旧炉之验材，铸今本之器。
# 今释：复用已固定摘要的自举包，构建当前仓库编译器，不更改编译器语义。
FROM --platform=linux/amd64 debian:bookworm-slim AS builder
ARG YY_BOOTSTRAP_URL=https://github.com/yuyan-lang/yuyan/releases/download/continuous-bootstrap/yuyan-bootstrap-bundle.tar.gz
ARG YY_BOOTSTRAP_SHA256=27d465724cea97f9882cc768c3732b989846f93ec4f6447b5a6f0d1fea392933
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates clang curl llvm make tar && rm -rf /var/lib/apt/lists/*
WORKDIR /构建
RUN curl --fail --location --retry 3 --retry-all-errors "$YY_BOOTSTRAP_URL" --output 自举包.tar.gz \
    && echo "$YY_BOOTSTRAP_SHA256  自举包.tar.gz" | sha256sum --check - \
    && mkdir 自举包 && tar -xzf 自举包.tar.gz -C 自举包 --strip-components=1 \
    && if [ -x 自举包/构建.sh ]; then 自举包/构建.sh && cp 自举包/豫言自举编译器 yy稳定编译器; else 自举包/build.sh && cp 自举包/yy_bundled_bs yy稳定编译器; fi \
    && chmod 0755 yy稳定编译器
COPY Makefile /源码/Makefile
COPY 豫言编译器 /源码/豫言编译器
COPY 藏书阁 /源码/藏书阁
COPY 运行时支持库 /源码/运行时支持库
WORKDIR /源码
RUN make yy_runtime_lib && find 运行时支持库 -maxdepth 1 -type f -name '*.a' -exec ranlib {} +
RUN /构建/yy稳定编译器 豫言编译器/入口。豫 -o /构建/yy当前编译器

FROM --platform=linux/amd64 node:22-bookworm-slim AS sandbox-base
RUN apt-get update && apt-get install --yes --no-install-recommends clang llvm bubblewrap util-linux \
    && rm -rf /var/lib/apt/lists/*
FROM sandbox-base AS runtime
RUN apt-get update && apt-get install --yes --no-install-recommends make && rm -rf /var/lib/apt/lists/*
COPY --from=builder /构建/yy当前编译器 /opt/yuyan/yy
COPY --from=builder /源码/藏书阁 /opt/yuyan/藏书阁
COPY --from=builder /源码/运行时支持库 /opt/yuyan/运行时支持库
COPY 应用/豫言体验/预热。豫 /work/预热。豫
COPY 应用/豫言体验/构建规则 /opt/yuyan/构建规则
# 古曰：官书先编，其缓存恒封；每客取副本，用毕即弃。
# 今释：以与隔离空间相同的路径预热标准库，运行时仅复制可信缓存到各自工作目录。
RUN ln -s /opt/yuyan/藏书阁 /work/藏书阁 && ln -s /opt/yuyan/运行时支持库 /work/运行时支持库 && ln -s /opt/yuyan/构建规则 /work/Makefile \
    && cd /work && /opt/yuyan/yy 预热。豫 --compile-only --no-debug-print -o /work/yy预热 \
    && cp -a /work/.yybuild /opt/yuyan/预热缓存 && rm -rf /work
COPY 应用/豫言体验/源码 /app/源码
COPY 语言指南.汉语.md /app/语言指南.汉语.md
COPY 应用/豫言体验/知识 /app/知识
# 古曰：不以尊位行客事；别室不成，则闭门。
# 今释：服务使用非 root 用户；启动时必须成功建立所有 namespace，否则拒绝启动。
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["node", "/app/源码/服务.mjs"]
