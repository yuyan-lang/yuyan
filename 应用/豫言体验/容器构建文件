# 古曰：取旧炉之验材，铸今本之器。
# 今释：复用已固定摘要的自举包，构建当前仓库编译器，不更改编译器语义。
FROM --platform=linux/amd64 debian:bookworm-slim AS builder
ARG YY_BOOTSTRAP_URL=https://github.com/yuyan-lang/yuyan/releases/download/historical-bootstrap/bootstrap-pair-0e915ed65338da2734664b73124504ed07c21d00ccaf1627916000cc18d440f3.tar.gz
ARG YY_BOOTSTRAP_SHA256=0e915ed65338da2734664b73124504ed07c21d00ccaf1627916000cc18d440f3
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates clang curl llvm make tar && rm -rf /var/lib/apt/lists/*
WORKDIR /构建
RUN curl --fail --location --retry 3 --retry-all-errors "$YY_BOOTSTRAP_URL" --output 自举包.tar.gz \
    && echo "$YY_BOOTSTRAP_SHA256  自举包.tar.gz" | sha256sum --check - \
    && mkdir 自举包 && tar -xzf 自举包.tar.gz -C 自举包 --strip-components=1 \
    && find 自举包 -type f \( -name '._*' -o -name '.DS_Store' \) -delete \
    && test "$(cat 自举包/种子格式)" = "豫言双种子一" \
    && 自举包/构建.sh \
    && cp 自举包/yy_bs_stable yy稳定编译器 \
    && cp 自举包/yy豫构_stable yy稳定豫构 \
    && chmod 0755 yy稳定编译器
COPY Makefile /源码/Makefile
COPY 豫言编译器 /源码/豫言编译器
COPY 库 /源码/库
COPY 工具 /源码/工具
COPY 运行时支持库 /源码/运行时支持库
WORKDIR /源码
RUN make yy_runtime_lib && find 运行时支持库 -maxdepth 1 -type f -name '*.a' -exec ranlib {} +
RUN cp /构建/yy稳定编译器 ./yy_bs_stable && cp /构建/yy稳定豫构 ./yy豫构_stable \
    && make yy2_bs \
    && ./yy豫构_stable 构建 豫构 --编译器 ./yy2_bs --输出 yy豫构 \
    && cp yy2_bs /构建/yy当前编译器

FROM --platform=linux/amd64 node:22-bookworm-slim AS sandbox-base
RUN apt-get update && apt-get install --yes --no-install-recommends clang llvm bubblewrap util-linux \
    && rm -rf /var/lib/apt/lists/*
FROM sandbox-base AS runtime
COPY --from=builder /构建/yy当前编译器 /opt/yuyan/yy
COPY --from=builder /源码/yy豫构 /opt/yuyan/yy豫构
COPY --from=builder /源码/库 /opt/yuyan/库
COPY --from=builder /源码/运行时支持库 /opt/yuyan/运行时支持库
COPY 应用/豫言体验/预热。豫 /work/用户程序/入口。豫
# 古曰：官书先编，其缓存恒封；每客取副本，用毕即弃。
# 今释：以与隔离空间相同的路径预热标准库，运行时仅复制可信缓存到各自工作目录。
RUN cp -a /opt/yuyan/库 /work/库 && ln -s /opt/yuyan/运行时支持库 /work/运行时支持库 \
    && cp -p /opt/yuyan/yy /work/yy \
    && printf '「名称」者『用户程序』也。「所有者」者『访客』也。「版本」者『0.1.0』也。「简介」者『隔离执行的用户程序。』也。「类型」者「典」【「种类」者『可执行文件』也，「入口」者『入口』也，「文件名」者『yy程序』也，】也。「说明」者「典」【「汉语」者『说明.汉语.md』也，「文言」者『说明.文言.md』也，】也。「依赖」者「列」【「典」【「所有者」者『豫言』也，「包」者『标准库』也，】】也。' > /work/用户程序/用户程序。包。豫 \
    && printf '本包仅用于本次隔离运行。' > /work/用户程序/说明.汉语.md \
    && printf '此包惟供今次隔离之用。' > /work/用户程序/说明.文言.md \
    && cd /work && /opt/yuyan/yy豫构 构建 用户程序 --编译器 /work/yy --输出 /work/yy程序 -j 1 -- --compile-only --no-debug-print \
    && cp -a /work/.yybuild /opt/yuyan/预热缓存 && rm -rf /work

COPY 应用/豫言体验/源码 /app/源码
COPY 语言指南.汉语.md /app/语言指南.汉语.md
COPY 应用/豫言体验/知识 /app/知识
# 古曰：不以尊位行客事；别室不成，则闭门。
# 今释：服务使用非 root 用户；启动时必须成功建立所有 namespace，否则拒绝启动。
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["node", "/app/源码/服务.mjs"]
