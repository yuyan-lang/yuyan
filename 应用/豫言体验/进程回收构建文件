# 古曰：循已验之器，惟补收遗子之职。
# 今释：在已上线镜像上仅增加进程回收器，保留原编译器与应用，供本次故障修复发布。
FROM --platform=linux/amd64 registry.cloudflare.com/90c58fd531223290a358e4df01dadb5b/yy-playground@sha256:c105d869f1bac13cb49f2d9f6c0613f95d3eced0c9261c013c71f631d1608d8c
USER root
RUN apt-get update && apt-get install --yes --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/源码/服务.mjs"]
