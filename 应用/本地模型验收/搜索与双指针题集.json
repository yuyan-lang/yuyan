[
  {"id":31,"title":"旋转有序列表中查找","signature":"化（「列」于「整数」）而化「整数」而「整数」","statement":"列表原本严格递增，旋转零次或多次，无重复；返回目标的零起下标，未找到为负一。","arg_types":["list_int","整数"],"result_type":"整数","cases":[{"args":[[4,5,6,7,0,1,2],0],"expected":"4"},{"args":[[4,5,6,7,0,1,2],3],"expected":"-1"},{"args":[[1],0],"expected":"-1"},{"args":[[1],1],"expected":"0"},{"args":[[3,1],1],"expected":"1"}]},
  {"id":32,"title":"目标首末位置","signature":"化（「列」于「整数」）而化「整数」而（「整数」合「整数」）","statement":"列表非递减；返回目标的首、末零起位置，无目标返回负一与负一。","arg_types":["list_int","整数"],"result_type":"pair_int","cases":[{"args":[[5,7,7,8,8,10],8],"expected":[3,4]},{"args":[[5,7,7,8,8,10],6],"expected":[-1,-1]},{"args":[[],0],"expected":[-1,-1]},{"args":[[1],1],"expected":[0,0]},{"args":[[2,2],2],"expected":[0,1]}]},
  {"id":33,"title":"搜索插入位置","signature":"化（「列」于「整数」）而化「整数」而「整数」","statement":"列表严格递增；返回目标若已存在的下标，否则返回使列表仍有序的插入下标。","arg_types":["list_int","整数"],"result_type":"整数","cases":[{"args":[[1,3,5,6],5],"expected":"2"},{"args":[[1,3,5,6],2],"expected":"1"},{"args":[[1,3,5,6],7],"expected":"4"},{"args":[[1,3,5,6],0],"expected":"0"},{"args":[[],3],"expected":"0"}]},
  {"id":34,"title":"盛水最多的容器","signature":"化（「列」于「整数」）而「整数」","statement":"列表是各竖线的非负高度，任取两个不同下标，面积为下标差乘较小高度，返回最大面积。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[1,8,6,2,5,4,8,3,7]],"expected":"49"},{"args":[[1,1]],"expected":"1"},{"args":[[4,3,2,1,4]],"expected":"16"},{"args":[[1,2,1]],"expected":"2"},{"args":[[0,0]],"expected":"0"}]},
  {"id":35,"title":"接雨水总量","signature":"化（「列」于「整数」）而「整数」","statement":"各项为非负柱高，返回两端之间可积累的单位水量。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[0,1,0,2,1,0,1,3,2,1,2,1]],"expected":"6"},{"args":[[4,2,0,3,2,5]],"expected":"9"},{"args":[[]],"expected":"0"},{"args":[[1,2,3]],"expected":"0"},{"args":[[3,0,3]],"expected":"3"}]},
  {"id":36,"title":"三数之和为零","signature":"化（「列」于「整数」）而（「列」于（「整数」合「整数」合「整数」））","statement":"从三个不同下标选数，返回所有和为零的不同值三元组。每组三数升序排列，结果列表按三元组字典序排列，不重复。","arg_types":["list_int"],"result_type":"list_triple_int","cases":[{"args":[[-1,0,1,2,-1,-4]],"expected":[[-1,-1,2],[-1,0,1]]},{"args":[[0,1,1]],"expected":[]},{"args":[[0,0,0]],"expected":[[0,0,0]]},{"args":[[-2,0,1,1,2]],"expected":[[-2,0,2],[-2,1,1]]},{"args":[[]],"expected":[]}]},
  {"id":37,"title":"最接近目标的三数之和","signature":"化（「列」于「整数」）而化「整数」而「整数」","statement":"输入至少三项；从三个不同下标取数，返回与目标绝对差最小的和，同差取较小的和。","arg_types":["list_int","整数"],"result_type":"整数","cases":[{"args":[[-1,2,1,-4],1],"expected":"2"},{"args":[[0,0,0],1],"expected":"0"},{"args":[[1,1,1,0],-100],"expected":"2"},{"args":[[1,2,3],6],"expected":"6"},{"args":[[-2,-1,1,2],0],"expected":"-1"}]},
  {"id":38,"title":"删除指定值","signature":"化（「列」于「整数」）而化「整数」而（「列」于「整数」）","statement":"返回删除所有等于目标的项之后的列表，保留其他项的原顺序。","arg_types":["list_int","整数"],"result_type":"列整数","cases":[{"args":[[3,2,2,3],3],"expected":[2,2]},{"args":[[],0],"expected":[]},{"args":[[0,1,2,2,3,0,4,2],2],"expected":[0,1,3,0,4]},{"args":[[1,1],1],"expected":[]},{"args":[[1,2],3],"expected":[1,2]}]},
  {"id":39,"title":"三色排序","signature":"化（「列」于「整数」）而（「列」于「整数」）","statement":"每项只可能为 0、1、2，返回按非递减顺序排列的列表。","arg_types":["list_int"],"result_type":"列整数","cases":[{"args":[[2,0,2,1,1,0]],"expected":[0,0,1,1,2,2]},{"args":[[]],"expected":[]},{"args":[[2,0,1]],"expected":[0,1,2]},{"args":[[0]],"expected":[0]},{"args":[[1,1,0]],"expected":[0,1,1]}]},
  {"id":40,"title":"两个有序列表的中位数","signature":"化（「列」于「整数」）而化（「列」于「整数」）而「小数」","statement":"两个列表分别非递减，至少一个非空；返回合并后序列的中位数，偶数长度取中央两数的算术平均。","arg_types":["list_int","list_int"],"result_type":"小数","cases":[{"args":[[1,3],[2]],"expected":2.0},{"args":[[1,2],[3,4]],"expected":2.5},{"args":[[],[1]],"expected":1.0},{"args":[[0,0],[0,0]],"expected":0.0},{"args":[[1],[2,3,4]],"expected":2.5}]}
]
