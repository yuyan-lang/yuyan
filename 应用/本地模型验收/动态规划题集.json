[
  {"id":41,"title":"最少硬币数","signature":"化（「列」于「整数」）而化「整数」而「整数」","statement":"正整数面额列表中各面额不同，硬币可无限使用。返回凑成非负目标金额所需的最少硬币数；无解返回负一。","arg_types":["list_int","整数"],"result_type":"整数","cases":[{"args":[[1,2,5],11],"expected":"3"},{"args":[[2],3],"expected":"-1"},{"args":[[1],0],"expected":"0"},{"args":[[2,5,10],6],"expected":"3"},{"args":[[3,7],14],"expected":"2"}]},
  {"id":42,"title":"打家劫舍","signature":"化（「列」于「整数」）而「整数」","statement":"输入依次排列的非负收益，不可同时选择相邻项，返回能得到的最大总收益。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[]],"expected":"0"},{"args":[[1]],"expected":"1"},{"args":[[2,7,9,3,1]],"expected":"12"},{"args":[[1,2,3,1]],"expected":"4"},{"args":[[2,1,1,2]],"expected":"4"}]},
  {"id":43,"title":"爬楼梯最低费用","signature":"化（「列」于「整数」）而「整数」","statement":"列表至少两项，值为踏上对应阶的费用。可从第零或第一阶开始，每步一或两阶，到达最后一阶之后即完成，返回最低费用。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[10,15,20]],"expected":"15"},{"args":[[1,100,1,1,1,100,1,1,100,1]],"expected":"6"},{"args":[[0,0]],"expected":"0"},{"args":[[5,10]],"expected":"5"},{"args":[[3,4,1,2]],"expected":"4"}]},
  {"id":44,"title":"方格路径计数","signature":"化「整数」而化「整数」而「整数」","statement":"给定正整数行数与列数，从左上角只向右或向下到右下角，返回不同路径数。","arg_types":["整数","整数"],"result_type":"整数","cases":[{"args":[1,1],"expected":"1"},{"args":[3,7],"expected":"28"},{"args":[3,2],"expected":"3"},{"args":[2,2],"expected":"2"},{"args":[1,5],"expected":"1"}]},
  {"id":45,"title":"网格最小路径和","signature":"化（「列」于（「列」于「整数」））而「整数」","statement":"输入为非空的非负整数矩形网格，从左上角只向右或向下到右下角，返回经过各格值之和的最小值。","arg_types":["list_list_int"],"result_type":"整数","cases":[{"args":[[[1,3,1],[1,5,1],[4,2,1]]],"expected":"7"},{"args":[[[1,2,3],[4,5,6]]],"expected":"12"},{"args":[[[5]]],"expected":"5"},{"args":[[[1,1],[1,1]]],"expected":"3"},{"args":[[[0,0],[0,0]]],"expected":"0"}]},
  {"id":46,"title":"编辑距离","signature":"化「字符串」而化「字符串」而「整数」","statement":"一次操作可插入、删除或替换一个 ASCII 字符，返回把第一字符串变成第二字符串的最少操作次数。","arg_types":["字符串","字符串"],"result_type":"整数","cases":[{"args":["horse","ros"],"expected":"3"},{"args":["intention","execution"],"expected":"5"},{"args":["",""],"expected":"0"},{"args":["abc",""],"expected":"3"},{"args":["a","b"],"expected":"1"}]},
  {"id":47,"title":"最长严格递增子序列长度","signature":"化（「列」于「整数」）而「整数」","statement":"可跳过元素但保持原相对顺序，求严格递增子序列的最长长度；空列表返回零。","arg_types":["list_int"],"result_type":"整数","cases":[{"args":[[]],"expected":"0"},{"args":[[10,9,2,5,3,7,101,18]],"expected":"4"},{"args":[[0,1,0,3,2,3]],"expected":"4"},{"args":[[7,7,7]],"expected":"1"},{"args":[[1,2,3]],"expected":"3"}]},
  {"id":48,"title":"最长公共子序列长度","signature":"化「字符串」而化「字符串」而「整数」","statement":"字符按原顺序选取但可不连续，返回两字符串的最长公共子序列长度。","arg_types":["字符串","字符串"],"result_type":"整数","cases":[{"args":["abcde","ace"],"expected":"3"},{"args":["abc","abc"],"expected":"3"},{"args":["abc","def"],"expected":"0"},{"args":["","abc"],"expected":"0"},{"args":["bl","yby"],"expected":"1"}]},
  {"id":49,"title":"数字字符串解码数","signature":"化「字符串」而「整数」","statement":"输入非空数字串，1 至 26 各映射一个字母；前导零不能单独解码，返回不同解码方法数。","arg_types":["字符串"],"result_type":"整数","cases":[{"args":["12"],"expected":"2"},{"args":["226"],"expected":"3"},{"args":["06"],"expected":"0"},{"args":["10"],"expected":"1"},{"args":["11106"],"expected":"2"}]},
  {"id":50,"title":"等和分割","signature":"化（「列」于「整数」）而「爻」","statement":"输入非负整数列表，判断能否分为两个总和相等的子集；空列表算可以。","arg_types":["list_int"],"result_type":"爻","cases":[{"args":[[1,5,11,5]],"expected":"阳"},{"args":[[1,2,3,5]],"expected":"阴"},{"args":[[]],"expected":"阳"},{"args":[[2,2,3,5]],"expected":"阴"},{"args":[[3,3,3,4,5]],"expected":"阳"}]}
