[
  {
    "id": 21,
    "title": "字符串首次匹配位置",
    "signature": "化「字符串」而化「字符串」而「整数」",
    "statement": "第一参数为原串，第二参数为待找的连续子串；返回第一次出现的零起位置，未找到返回负一，空待找串返回零。",
    "result_type": "整数",
    "cases": [
      {
        "args": [
          "sadbutsad",
          "sad"
        ],
        "expected": "0"
      },
      {
        "args": [
          "leetcode",
          "leeto"
        ],
        "expected": "-1"
      },
      {
        "args": [
          "abc",
          ""
        ],
        "expected": "0"
      },
      {
        "args": [
          "aaaaa",
          "bba"
        ],
        "expected": "-1"
      },
      {
        "args": [
          "mississippi",
          "issip"
        ],
        "expected": "4"
      },
      {
        "args": [
          "abcabc",
          "cab"
        ],
        "expected": "2"
      }
    ],
    "arg_types": [
      "字符串",
      "字符串"
    ]
  },
