{
  // 文言：上游流三适配本地 workerd 复验之配置：SVC 绑于本 Worker 之 假服务 入口，DOS 绑于 假对象 类；须开 enable_request_signal。
  // 汉语：上游流三个适配本地 workerd（wrangler dev --local）复验用的配置：SVC 绑到本 Worker 的命名入口 假服务，DOS 绑到持久对象类 假对象；兼容标志 enable_request_signal 必须开启，客户端断开与取消才能传到请求信号。
  "name": "yy-upstream-conformance",
  "main": "上游流外壳.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["enable_request_signal"],
  "services": [{"binding": "SVC", "service": "yy-upstream-conformance", "entrypoint": "假服务"}],
  "durable_objects": {"bindings": [{"name": "DOS", "class_name": "假对象"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["假对象"]}]
}
