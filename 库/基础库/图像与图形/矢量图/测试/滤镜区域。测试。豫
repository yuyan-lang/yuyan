    『<svg><defs><filter id="滤" filterUnits="userSpaceOnUse" x="0" y="0" width="2" height="1" color-interpolation-filters="sRGB"><feOffset dx="1"/></filter></defs><g transform="translate(3 0) rotate(90)"><rect width="1" height="1" fill="red" filter="url(#滤)"/></g></svg>』
