　，（『0020_云端构建.sql』
　　　与『-- 文言：源码既上，云端构建；一任务一行，状迁有法，事件只增不改。汉语：云端构建发布（发布者只传源码）的任务表与事件表：任务按（用户、包名、版本、源码摘要）幂等；状态只能沿「排队 → 构建中 → 发布中 → 成功」前进，或落入「失败」（可重试）与「不支持」（终态）；事件表只追加。
CREATE TABLE "云端构建任务" (
  "编号" TEXT PRIMARY KEY CHECK (length("编号")=36),
  "用户编号" INTEGER NOT NULL REFERENCES "用户"("编号"),
  "所有者名" TEXT NOT NULL,
  "包名" TEXT NOT NULL,
  "版本" TEXT NOT NULL,
  "类型" TEXT NOT NULL,
  "源码摘要" TEXT NOT NULL CHECK (length("源码摘要")=64),
  "源码字节" INTEGER NOT NULL CHECK ("源码字节">0),
  "状态" TEXT NOT NULL DEFAULT '排队' CHECK ("状态" IN ('排队','构建中','发布中','成功','失败','不支持')),
  "阶段" TEXT NOT NULL DEFAULT '',
  "原因" TEXT NOT NULL DEFAULT '',
  "重试次数" INTEGER NOT NULL DEFAULT 0 CHECK ("重试次数">=0),
  "修订编号" TEXT,
  "构建器版本" TEXT NOT NULL DEFAULT '',
  "创建时间" INTEGER NOT NULL DEFAULT (unixepoch()),
  "更新时间" INTEGER NOT NULL DEFAULT (unixepoch()),
  UNIQUE ("用户编号","包名","版本","源码摘要")
);
CREATE INDEX "云端构建任务_用户" ON "云端构建任务" ("用户编号","创建时间" DESC);
CREATE INDEX "云端构建任务_状态" ON "云端构建任务" ("状态","更新时间");

-- 文言：状之迁，唯依此表；终态不复动，败者可重试而回排队。汉语：状态转移约束（触发器）：成功与不支持是终态；失败只能回「排队」（重试，重试次数加一）；其余只能按顺序前进或落入失败/不支持；身份字段（用户、包、版本、摘要、创建时间）不可改。
CREATE TRIGGER "云端构建任务_身份不改" BEFORE UPDATE OF "编号","用户编号","所有者名","包名","版本","类型","源码摘要","源码字节","创建时间" ON "云端构建任务" BEGIN
  SELECT RAISE(ABORT,'构建任务的身份字段不可修改');
END;
CREATE TRIGGER "云端构建任务_状态迁移" BEFORE UPDATE OF "状态" ON "云端构建任务" WHEN NEW."状态"<>OLD."状态" BEGIN
  SELECT RAISE(ABORT,'构建任务状态迁移不合法') WHERE NOT (
    (OLD."状态"='排队' AND NEW."状态" IN ('构建中','失败','不支持')) OR
    (OLD."状态"='构建中' AND NEW."状态" IN ('发布中','失败','不支持','排队')) OR
    (OLD."状态"='发布中' AND NEW."状态" IN ('成功','失败')) OR
    (OLD."状态"='失败' AND NEW."状态"='排队')
  );
END;

