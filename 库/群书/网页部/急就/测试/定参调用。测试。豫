　于『成员接收者与实参从左向右求值』
　于『let log="";let obj={x:7,get f(){log+="g";return function(a,b){return this.x+a+b;};}};function arg(n){log+=n;return n;}let r=obj.f(arg(1),arg(2));r===10&&log==="g12";』。
「验篇」于『零参与缺省剩余形参及实参对象』于『function f(a=3,...rest){return a+rest.length+arguments.length;}f()===3&&f(4,5,6)===9&&(()=>7)()===7;』。
「验篇」
　于『可选调用与嵌套实参』
　于『let n=0;let nil=null;let o={x:4,f(a,b){return this.x+a+b;}};function inc(){return ++n;}let a=nil?.f(inc());let b=o.missing?.(inc());let c=o.f?.(inc(),o.f(2,3));a===undefined&&b===undefined&&n===1&&c===14;』。
