　　　，『shadow』
　　　，『opacity』
　　　，『visibility』
　　　，『cursor』
　　　，『filter』
　　　，『transform』
　　　，『transition』
　　　，『animation』
　　　，『outline』
　　　，『text-decoration』
　　　，『radius』
　　　，『caret』
　　　，『accent』
　　　，『fill』
　　　，『stroke』
　　　，『z-index』
　　　，『pointer-events』
　　　】））则
