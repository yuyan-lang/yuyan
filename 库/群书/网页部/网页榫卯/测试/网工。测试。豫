终工.postMessage({cmd:"推", n:1});
终工.postMessage({cmd:"推", n:2});
终工.terminate();
var 闭工 = new Worker("https://example.test/worker.js");
闭工.onmessage = function(e){ window.__工.闭信.push(e.data); };
闭工.postMessage({cmd:"闭"});
闭工.postMessage({cmd:"推", n:3});』而
　令「无四」为「跑尽」于「六四」而
　「查」
　　于「境」
　　于「名」曰『往返消息都到』
　　于「式」曰『__工.信.length === 3 && __工.信[0].kind === "往返" && __工.信[1].kind === "往返" && __工.信[2].kind === "引"』而后
　「查」
　　于「境」
　　于「名」曰『结构化克隆保住嵌套、映射、日期、类型数组与环』
　　于「式」曰『__工.信[0].value.b[1] === 2 && __工.信[0].value.m.get("k") === 9 && __工.信[0].value.d.getFullYear() === 2020 && __工.信[0].value.t[1] === 6 && __工.信[0].value.self === __工.信[0].value』而后
　「查」
