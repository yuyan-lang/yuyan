ch.port1.postMessage({n:1});ch.port1.postMessage({n:2});
var ch2=new MessageChannel();__信.移=[];ch2.port2.onmessage=function(e){__信.移.push(new Uint8Array(e.data)[0]+":"+e.data.byteLength)};
var buf=new ArrayBuffer(4);new Uint8Array(buf)[0]=65;ch2.port1.postMessage(buf,{transfer:[buf]});__信.旧=function(){return buf.byteLength};
