「测试源」者『
; 低阶语言测试源
(常量 十 10)
(常量 掩码 (& 0xFF0 (<< 1 8)))
(宏 加一 (x) (+ x 1))
(宏 双倍加 (x y) (+ (加一 x) (加一 y)))
(宏 交换 (a b t) (块 (置 t a) (置 a b) (置 b t)))
(函数 斐波那契 (n)
  (若 (< n 2) (返回 n))
  (返回 (+ (斐波那契 (- n 1)) (斐波那契 (- n 2)))))
(函数 求和 (n)
  (局 i s)
  (当 (< i n) (置 s (+ s i)) (置 i (+ i 1)))
  (返回 s))
(函数 分类 (x)
  (分派 x
    (情形 (1 2 3) (返回 10))
    (情形 (100) (返回 20))
    (情形 (-5 -6) (返回 25))
    (否则 (返回 30))))
(函数 分类多 (x)
  (分派 (+ x 1)
    (情形 (1) (返回 1)) (情形 (2) (返回 2)) (情形 (3) (返回 3)) (情形 (4) (返回 4))
    (情形 (5) (返回 5)) (情形 (6) (返回 6)) (情形 (7) (返回 7)) (情形 (8 9 10) (返回 8))
    (情形 (11) (返回 11)) (情形 (12) (返回 12)) (情形 (13) (返回 13)) (情形 (14) (返回 14))
    (否则 (返回 0))))
(函数 短路 (a b)
  (返回 (选 (&& a (|| b 0)) 100 200)))
(函数 嵌套循环 (n)
  (局 i j c)
  (当 (< i n)
    (置 j 0)
    (当 1
      (若 (>= j n) (中断))
      (置 j (+ j 1))
      (若 (== j 3) (继续))
      (置 c (+ c 1)))
    (置 i (+ i 1)))
  (返回 c))
(函数 宏试 (p q)
  (局 t)
  (交换 p q t)
  (返回 (双倍加 p (* q 2))))
(函数 常量试 () (返回 (+ 十 掩码)))
(常量 字面串基 0x3000)
(内存 1 1)
(函数 串址甲 () (返回 "你好"))
(函数 串址乙 () (返回 "ab"))
(函数 串址同 () (返回 (- "你好" 0x3000)))
(函数 范围试 (x)
  (分派 x
    (情形 ((范围 10 13) 20) (返回 1))
    (情形 (0) (返回 2))
    (否则 (返回 3))))
(函数 位运算 (a b)
  (返回 (^ (& a b) (| (<< a 3) (>>u b 2)))))
(函数 无符号比较 (a b)
  (返回 (+ (<u a b) (* 2 (>=u a b)))))
(函数 多参 (a b c d e f g h)
  (返回 (- (+ a b c d) (+ e f g h))))
