; 块设备（虚拟变体）：现代 Virtio 块设备的用户态驱动，供文件系统使用
; 协议同 库/编译器核心/网页汇编核心/虚拟磁盘。豫：单队列（大小八）、一次一个请求、五百一十二字节扇区。
; 差别：执行器的线性内存会迁入动态块，设备只能经内核授予的静态窗口（用户空间静态区，设备地址 = 静态偏移 + 0x1000）DMA，
; 故队列、请求头、状态与数据缓冲都放在静态窗口内的固定偏移，用户态只经内核服务 搬入静态 / 搬出静态 存取。
(导入 配置读 "平台" "设备配置读" 1 1)
(导入 寄存器读 "平台" "设备寄存器读" 1 1)
(导入 寄存器写 "平台" "设备寄存器写" 2 1)
(导入 搬入静态 "平台" "搬入静态" 2 1)
(导入 搬出静态 "平台" "搬出静态" 2 1)

; ---- 静态窗口内的 DMA 区（静态偏移；设备地址再加 0x1000） ----
(常量 静_描述 0x70000)      ; 描述符表 8 项 × 16 B
(常量 静_可用 0x70080)      ; 可用环：标志、索引、8 项环
(常量 静_已用 0x700A0)      ; 已用环：标志、索引、8 项 × 8 B
(常量 静_头 0x70100)        ; 请求头 16 B，紧随其后的一字节是状态
(常量 静_状态 0x70110)
(常量 静_数据 0x70200)      ; 五百一十二字节数据缓冲
(常量 静_区长 0x200)
(常量 设备偏 0x1000)

; ---- 线性内存里的驱动状态格与暂存 ----
(常量 S_块态 0x940)         ; 0 未试 1 就绪 2 失败
(常量 S_块容量 0x944)       ; 扇区数（高位非零时饱和）
(常量 S_块只读 0x948)
(常量 S_块通知 0x94C)       ; 通知寄存器字（宽 2 | 偏移）
(常量 S_块序 0x950)         ; 已发布的可用索引（十六位）
(常量 块头暂存 0xA00)       ; 请求头 16 B + 状态 1 B
(常量 块描暂存 0xA20)       ; 描述符 3 项 48 B
(常量 块用暂存 0xA60)       ; 已用环副本 72 B
(常量 块杂暂存 0xAC0)       ; 环项与索引
(常量 块初暂存 0xC00)       ; 初始化时的 512 字节影像

(宏 寄存写检 (字 值) (若 (!= (寄存器写 字 值) 0) (返回 0)))

(函数 块初始化 ()
  (局 指 数 型 通知已见 设备已见 特 偏移 世 容低 容高 试 队通)
  (若 (<=u (内存页数) 8) (返回 0))
  (存4 S_块序 0)
  (若 (!= (寄存器读 0x10014) 0) (返回 0))
  (寄存写检 0x10014 1)
  (寄存写检 0x10014 3)
  (寄存写检 0x40000 1)
  (若 (!= (& (寄存器读 0x40004) 3) 3) (返回 0))
  (寄存写检 0x40000 0)
  (置 特 (& (寄存器读 0x40004) 0x220))
  (若 (!= (& 特 0x200) 0x200) (返回 0))
  (存4 S_块只读 (& 特 32))
  (寄存写检 0x40008 0)
  (寄存写检 0x4000C 特)
  (寄存写检 0x40008 1)
  (寄存写检 0x4000C 3)
  (寄存写检 0x10014 11)
  (若 (!= (寄存器读 0x10014) 11) (返回 0))
  ; 有界遍历 PCI 能力链，核对通知窗口与设备配置窗口
  (置 指 (& (配置读 52) 255))
  (置 数 0)
  (当 (!= 指 0)
    (若 (>=u 数 48) (返回 0))
    (置 数 (+ 数 1))
    (若 (|| (<u 指 64) (>u 指 252) (!= (& 指 3) 0)) (返回 0))
    (置 型 (配置读 指))
    (若 (&& (== (& 型 255) 9) (== (>>u 型 24) 2))
      (若 (|| (>u 指 236) (<u (& (>>u 型 16) 255) 20)) (返回 0))
      (若 (!= (& (配置读 (+ 指 4)) 255) 4) (返回 0))
      (若 (!= (配置读 (+ 指 8)) 0x3000) (返回 0))
      (若 (!= (配置读 (+ 指 12)) 0x1000) (返回 0))
      (若 (!= (配置读 (+ 指 16)) 4) (返回 0))
      (置 通知已见 1))
    (若 (&& (== (& 型 255) 9) (== (>>u 型 24) 4))
      (若 (|| (>u 指 240) (<u (& (>>u 型 16) 255) 16)) (返回 0))
      (若 (!= (& (配置读 (+ 指 4)) 255) 4) (返回 0))
      (若 (!= (配置读 (+ 指 8)) 0x2000) (返回 0))
      (若 (!= (配置读 (+ 指 12)) 0x1000) (返回 0))
      (置 设备已见 1))
    (置 指 (& (>>u 型 8) 255)))
  (若 (|| (! 通知已见) (! 设备已见)) (返回 0))
  ; 队列零
  (若 (== (寄存器读 0x20012) 0) (返回 0))
  (寄存写检 0x20016 0)
  (若 (<u (寄存器读 0x20018) 8) (返回 0))
  (寄存写检 0x20018 8)
  (若 (!= (寄存器读 0x20018) 8) (返回 0))
  (寄存写检 0x20010 0xFFFF)
  (寄存写检 0x2001A 0xFFFF)
  (置 队通 (寄存器读 0x2001E))
  (若 (>u 队通 0x3FF) (返回 0))
  (存4 S_块通知 (+ 0x23000 (* 队通 4)))
  ; 容量：配置世次前后一致才采信
  (置 试 0x400)
  (当 1
    (置 世 (寄存器读 0x10015))
    (置 容低 (寄存器读 0x42000))
    (置 容高 (寄存器读 0x42004))
    (若 (== (寄存器读 0x10015) 世) (中断))
    (置 试 (- 试 1))
    (若 (== 试 0) (返回 0)))
  (若 (== (| 容低 容高) 0) (返回 0))
  (存4 S_块容量 (选 容高 -1 容低))
  ; 静态窗口内清零并置可用环标志为“不要中断”
  (内存填充 块初暂存 0 静_区长)
  (存2 (+ 块初暂存 (- 静_可用 静_描述)) 1)
  (若 (!= (搬入静态 块初暂存 (| 静_描述 (<< 静_区长 20))) 0) (返回 0))
  (寄存写检 0x40020 (+ 静_描述 设备偏))
  (寄存写检 0x40024 0)
  (寄存写检 0x40028 (+ 静_可用 设备偏))
  (寄存写检 0x4002C 0)
  (寄存写检 0x40030 (+ 静_已用 设备偏))
  (寄存写检 0x40034 0)
  (寄存写检 0x2001C 1)
  (若 (!= (寄存器读 0x2001C) 1) (返回 0))
  (寄存写检 0x10014 15)
  (若 (!= (寄存器读 0x10014) 15) (返回 0))
  (返回 1))

(函数 块就绪 ()
  (若 (== (读4 S_块态) 0)
    (存4 S_块态 (选 (块初始化) 1 2)))
  (返回 (== (读4 S_块态) 1)))

(函数 块容量 ()
  (返回 (选 (== (读4 S_块态) 1) (读4 S_块容量) 0)))

; 操作：0 读、1 写、4 刷新。成功返回 0，设备报告错误返回其状态字节，拒绝或超时返回 -1
(函数 块传输 (操作 扇区 偏)
  (局 序 新序 试 槽址 状态)
  (若 (! (块就绪)) (返回 -1))
  (若 (&& (!= 操作 4) (>=u 扇区 (读4 S_块容量))) (返回 -1))
  (若 (&& (== 操作 1) (读4 S_块只读)) (返回 -1))
  (若 (&& (!= 操作 4) (>u (+ 偏 512) (* (内存页数) 65536))) (返回 -1))
  ; 请求头与状态字节
  (存4 块头暂存 操作)
  (存4 (+ 块头暂存 4) 0)
  (存4 (+ 块头暂存 8) (选 (== 操作 4) 0 扇区))
  (存4 (+ 块头暂存 12) 0)
  (存1 (+ 块头暂存 16) 255)
  (若 (!= (搬入静态 块头暂存 (| 静_头 (<< 17 20))) 0) (返回 -1))
  ; 描述符：头、数据（刷新时跳过）、状态
  (存4 块描暂存 (+ 静_头 设备偏))
  (存4 (+ 块描暂存 4) 0)
  (存4 (+ 块描暂存 8) 16)
  (存2 (+ 块描暂存 12) 1)
  (存2 (+ 块描暂存 14) (选 (== 操作 4) 2 1))
  (存4 (+ 块描暂存 16) (+ 静_数据 设备偏))
  (存4 (+ 块描暂存 20) 0)
  (存4 (+ 块描暂存 24) 512)
  (存2 (+ 块描暂存 28) (选 (== 操作 0) 3 1))
  (存2 (+ 块描暂存 30) 2)
  (存4 (+ 块描暂存 32) (+ 静_状态 设备偏))
  (存4 (+ 块描暂存 36) 0)
  (存4 (+ 块描暂存 40) 1)
  (存2 (+ 块描暂存 44) 2)
  (存2 (+ 块描暂存 46) 0)
  (若 (!= (搬入静态 块描暂存 (| 静_描述 (<< 48 20))) 0) (返回 -1))
  (若 (== 操作 1)
    (若 (!= (搬入静态 偏 (| 静_数据 (<< 512 20))) 0) (返回 -1)))
  ; 发布：环项先写，经寄存器读作屏障，再推进可用索引，最后通知
  (置 序 (读4 S_块序))
  (置 新序 (& (+ 序 1) 0xFFFF))
  (存2 块杂暂存 0)
  (若 (!= (搬入静态 块杂暂存 (| (+ 静_可用 4 (* (& 序 7) 2)) (<< 2 20))) 0) (返回 -1))
  (若 (!= (寄存器读 0x10014) 15) (返回 -1))
  (存2 (+ 块杂暂存 2) 新序)
  (若 (!= (搬入静态 (+ 块杂暂存 2) (| (+ 静_可用 2) (<< 2 20))) 0) (返回 -1))
  (若 (!= (寄存器写 (读4 S_块通知) 0) 0) (返回 -1))
  ; 轮询已用环
  (置 试 1000000)
  (当 1
    (若 (!= (寄存器读 0x10014) 15) (返回 -1))
    (若 (!= (搬出静态 块用暂存 (| 静_已用 (<< 72 20))) 0) (返回 -1))
    (若 (== (读2 (+ 块用暂存 2)) 新序) (中断))
    (置 试 (- 试 1))
    (若 (== 试 0) (返回 -1)))
  (若 (!= (寄存器读 0x10014) 15) (返回 -1))
  (置 槽址 (+ 块用暂存 4 (* (& 序 7) 8)))
  (若 (!= (读4 槽址) 0) (返回 -1))
  (存4 S_块序 新序)
  (若 (!= (搬出静态 块头暂存 (| 静_头 (<< 17 20))) 0) (返回 -1))
  (置 状态 (读1 (+ 块头暂存 16)))
  (若 (== 状态 0)
    (若 (!= (读4 (+ 槽址 4)) (选 (== 操作 0) 513 1)) (返回 -1))
    (若 (== 操作 0)
      (若 (!= (搬出静态 偏 (| 静_数据 (<< 512 20))) 0) (返回 -1))))
  (返回 状态))

(函数 块读 (扇区 偏) (返回 (块传输 0 扇区 偏)))
(函数 块写 (扇区 偏) (返回 (块传输 1 扇区 偏)))
(函数 块刷新 () (返回 (块传输 4 0 0)))
