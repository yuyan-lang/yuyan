; 客体执行器二号：解释器核心——边表扫描、调用与返回、分支、i32/i64 运算、访存

; ---- 块类型：设置 S_块参、S_块果，返回新位置 ----
(函数 读块类型 (p)
  (局 b t)
  (置 b (读1 p))
  (若 (== b 0x40) (存4 S_块参 0) (存4 S_块果 0) (返回 (+ p 1)))
  (若 (|| (== b 0x63) (== b 0x64))
    (弃 (读s32 (+ p 1)))
    (存4 S_块参 0)
    (存4 S_块果 1)
    (返回 (读4 S_读址)))
  (若 (&& (& b 0x40) (! (& b 0x80)))
    (存4 S_块参 0)
    (存4 S_块果 1)
    (返回 (+ p 1)))
  (置 t (读s32 p))
  (存4 S_块参 (读4 (+ (类型条 t) 4)))
  (存4 S_块果 (读4 (+ (类型条 t) 8)))
  (返回 (读4 S_读址)))

; ---- 立即数跳过（GC 与杂项前缀） ----
(函数 跳过GC立即数 (子 p)
  (分派 子
    (情形 (0 1 6 7 11 12 13 14 16 15) (若 (!= 子 15) (弃 (读u32 p)) (置 p (读4 S_读址))))
    (情形 (2 3 4 5 8 9 10 17 18 19)
      (弃 (读u32 p)) (置 p (读4 S_读址))
      (弃 (读u32 p)) (置 p (读4 S_读址)))
    (情形 (20 21 22 23) (弃 (读s32 p)) (置 p (读4 S_读址)))
    (情形 (24 25)
      (置 p (+ p 1))
      (弃 (读u32 p)) (置 p (读4 S_读址))
      (弃 (读s32 p)) (置 p (读4 S_读址))
      (弃 (读s32 p)) (置 p (读4 S_读址)))
    (否则))
  (返回 p))
(函数 跳过杂项立即数 (子 p)
  (分派 子
    (情形 (8) (弃 (读u32 p)) (置 p (读4 S_读址)) (置 p (+ p 1)))
    (情形 (9 13 15 16 17) (弃 (读u32 p)) (置 p (读4 S_读址)))
    (情形 (10) (置 p (+ p 2)))
    (情形 (11) (置 p (+ p 1)))
    (情形 (12 14) (弃 (读u32 p)) (置 p (读4 S_读址)) (弃 (读u32 p)) (置 p (读4 S_读址)))
    (否则))
  (返回 p))
; 跳过一条指令的立即数；p 指向操作码之后
(函数 跳过立即数 (op p)
  (局 子 n i k)
  (分派 op
    (情形 (0x02 0x03 0x04) (置 p (读块类型 p)))
    (情形 (0x08 0x0C 0x0D 0x10 0x12 0x14 0x15 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0xD2 0xD5 0xD6)
      (弃 (读u32 p)) (置 p (读4 S_读址)))
    (情形 (0x0E)
      (取u n p)
      (置 i 0)
      (当 (<= i n) (弃 (读u32 p)) (置 p (读4 S_读址)) (置 i (+ i 1))))
    (情形 (0x11 0x13) (弃 (读u32 p)) (置 p (读4 S_读址)) (弃 (读u32 p)) (置 p (读4 S_读址)))
    (情形 (0x1C)
      (取u n p)
      (置 i 0)
      (当 (< i n) (弃 (值类别 p)) (置 p (读4 S_读址)) (置 i (+ i 1))))
    (情形 (0x1F)
      (置 p (读块类型 p))
      (取u n p)
      (置 i 0)
      (当 (< i n)
        (置 k (读1 p))
        (置 p (+ p 1))
        (若 (< k 2) (弃 (读u32 p)) (置 p (读4 S_读址)))
        (弃 (读u32 p)) (置 p (读4 S_读址))
        (置 i (+ i 1))))
    (情形 ((范围 0x28 0x3E)) (弃 (读u32 p)) (置 p (读4 S_读址)) (弃 (读u32 p)) (置 p (读4 S_读址)))
    (情形 (0x3F 0x40) (置 p (+ p 1)))
    (情形 (0x41) (弃 (读s32 p)) (置 p (读4 S_读址)))
    (情形 (0x42) (弃 (读s64 p)) (置 p (读4 S_读址)))
    (情形 (0x43) (置 p (+ p 4)))
    (情形 (0x44) (置 p (+ p 8)))
    (情形 (0xD0) (弃 (读s32 p)) (置 p (读4 S_读址)))
    (情形 (0xFB) (取u 子 p) (置 p (跳过GC立即数 子 p)))
    (情形 (0xFC) (取u 子 p) (置 p (跳过杂项立即数 子 p)))
    (否则))
  (返回 p))

; ---- 边表：每个字节偏移 8 字节 [end 之后的位置, else 之后的位置] ----
(函数 扫描函数 (f)
  (局 E 起 止 p op 栈顶 边 n)
  (置 E (函数条 f))
  (置 起 (读4 (+ E 4)))
  (置 止 (读4 (+ E 8)))
  (置 n (* (- 止 起) 8))
  (置 边 (读4 S_边表池))
  (若 (>u (+ 边 n) (读4 S_边表尾)) (陷阱退出 123 "边表池不足"))
  (存4 S_边表池 (+ 边 n))
  (存4 (+ E 24) 边)
  (置 栈顶 扫描栈)
  (置 p 起)
  (当 (<u p 止)
    (置 op (读1 p))
    (置 p (+ p 1))
    (分派 op
      (情形 (0x02 0x03 0x04 0x1F)
        (若 (>=u 栈顶 扫描栈限) (陷阱退出 123 "控制嵌套过深"))
        (存4 栈顶 (- p 1))
        (存4 (+ 栈顶 4) 0)
        (置 栈顶 (+ 栈顶 8))
        (置 p (跳过立即数 op p)))
      (情形 (0x05)
        (若 (<=u 栈顶 扫描栈) (陷阱退出 123 "else 无对应 if"))
        (存4 (- 栈顶 4) (- p 1))
        (存4 (+ 边 (+ (* (- (读4 (- 栈顶 8)) 起) 8) 4)) p))
      (情形 (0x0B)
        (若否 (== 栈顶 扫描栈)
          ((置 p 止))
          ((置 栈顶 (- 栈顶 8))
           (存4 (+ 边 (* (- (读4 栈顶) 起) 8)) p)
           (若 (读4 (+ 栈顶 4))
             (存4 (+ 边 (* (- (读4 (+ 栈顶 4)) 起) 8)) p)))))
      (否则 (置 p (跳过立即数 op p)))))
  (若 (!= 栈顶 扫描栈) (陷阱退出 123 "控制结构未闭合")))
(函数 边偏 (f)
  (局 E)
  (若 (< f 0) (返回 0))
  (置 E (函数条 f))
  (返回 (- (读4 (+ E 24)) (* (读4 (+ E 4)) 8))))

; ---- 标签栈 ----
(宏 压标签 (目标 基 元数 种类)
  (块
    (令 L (读4 S_标签顶))
    (若 (>=u L (读4 S_标签栈限)) (陷阱退出 122 "标签栈溢出"))
    (存4 L 目标)
    (存4 (+ L 4) 基)
    (存4 (+ L 8) 元数)
    (存4 (+ L 12) 种类)
    (存4 S_标签顶 (+ L 16))))
; 分支到相对深度 n；返回新 sp；新 pc 在 S_新pc（0 = 函数级返回，结果已在栈顶）
(函数 分支 (n sp)
  (局 L 顶 种 元 基 新顶 j)
  (置 顶 (读4 S_标签顶))
  (置 L (- 顶 (* (+ n 1) 16)))
  (置 种 (读4 (+ L 12)))
  (若 (== 种 4) (存4 S_新pc 0) (返回 sp))
  (置 元 (读4 (+ L 8)))
  (置 基 (读4 (+ L 4)))
  (置 新顶 (选 (== 种 1) (+ L 16) L))
  (置 j 顶)
  (当 (>u j 新顶)
    (置 j (- j 16))
    (若 (== (读4 (+ j 12)) 3) (存4 S_处理顶 (- (读4 S_处理顶) 32))))
  (存4 S_标签顶 新顶)
  (若 (!= (+ 基 (* 元 8)) sp) (拷贝 基 (- sp (* 元 8)) (* 元 8)))
  (存4 S_新pc (读4 L))
  (返回 (+ 基 (* 元 8))))

; ---- 调用与返回 ----
(函数 返回处理 (sp fp)
  (局 E nr F)
  (置 E (函数条 (读4 S_函)))
  (置 nr (读4 (+ E 16)))
  (若 (!= (+ fp (* nr 8)) sp) (拷贝 fp (- sp (* nr 8)) (* nr 8)))
  (置 sp (+ fp (* nr 8)))
  (置 F (- (读4 S_帧顶) 32))
  (存4 S_帧顶 F)
  (存4 S_新pc (读4 F))
  (存4 S_新fp (读4 (+ F 4)))
  (存4 S_函 (读4 (+ F 8)))
  (存4 S_标签顶 (读4 (+ F 12)))
  (存4 S_处理顶 (读4 (+ F 16)))
  (存4 S_边偏 (边偏 (读4 S_函)))
  (返回 sp))
(函数 调用 (f sp pc fp)
  (局 E np nl F L)
  (置 E (函数条 f))
  (若 (& (读4 (+ E 28)) 1)
    (置 sp (调用导入 f sp))
    (存4 S_新pc pc)
    (存4 S_新fp fp)
    (存4 S_边偏 (边偏 (读4 S_函)))
    (返回 sp))
  (置 np (读4 (+ E 12)))
  (置 nl (读4 (+ E 20)))
  (若 (>u (+ (+ sp (* nl 8)) (* 栈余量槽 8)) (读4 S_值栈限)) (陷阱退出 122 "值栈溢出"))
  (置 F (读4 S_帧顶))
  (若 (>=u F (读4 S_帧栈限)) (陷阱退出 122 "帧栈溢出"))
  (存4 F pc)
  (存4 (+ F 4) fp)
  (存4 (+ F 8) (读4 S_函))
  (存4 (+ F 12) (读4 S_标签顶))
  (存4 (+ F 16) (读4 S_处理顶))
  (存4 S_帧顶 (+ F 32))
  (置 fp (- sp (* np 8)))
  (清零 sp (* (- nl np) 8))
  (存4 S_函 f)
  (若 (! (读4 (+ E 24))) (扫描函数 f))
  (压标签 0 fp (读4 (+ E 16)) 4)
  (存4 S_新pc (读4 (+ E 4)))
  (存4 S_新fp fp)
  (存4 S_边偏 (边偏 f))
  (返回 (+ fp (* nl 8))))
(函数 尾调用 (f sp fp)
  (局 E np nl 现 L)
  (置 E (函数条 f))
  (若 (& (读4 (+ E 28)) 1)
    (置 sp (调用导入 f sp))
    (返回 (返回处理 sp fp)))
  (置 np (读4 (+ E 12)))
  (置 nl (读4 (+ E 20)))
  (若 (!= (+ fp (* np 8)) sp) (拷贝 fp (- sp (* np 8)) (* np 8)))
  (置 sp (+ fp (* np 8)))
  (置 现 (- (读4 S_帧顶) 32))
  (存4 S_标签顶 (读4 (+ 现 12)))
  (存4 S_处理顶 (读4 (+ 现 16)))
  (若 (>u (+ (+ fp (* nl 8)) (* 栈余量槽 8)) (读4 S_值栈限)) (陷阱退出 122 "值栈溢出"))
  (清零 sp (* (- nl np) 8))
  (存4 S_函 f)
  (若 (! (读4 (+ E 24))) (扫描函数 f))
  (压标签 0 fp (读4 (+ E 16)) 4)
  (存4 S_新pc (读4 (+ E 4)))
  (存4 S_新fp fp)
  (存4 S_边偏 (边偏 f))
  (返回 (+ fp (* nl 8))))
; 表项 → 函数号（空项或越界陷阱）
(函数 表函数 (表 索引)
  (局 D 字)
  (若 (>=u 表 (读4 S_表数)) (陷阱退出 124 "表索引越界"))
  (置 D (+ (读4 S_表描述) (* 表 16)))
  (若 (>=u 索引 (读4 (+ D 4))) (陷阱退出 124 "未定义的表元素"))
  (置 字 (读4 (+ (读4 D) (* 索引 4))))
  (若 (!= (& 字 7) 2) (陷阱退出 124 "未初始化的表元素"))
  (返回 (>>u 字 3)))

; ---- 位计数 ----
(函数 前导零 (x)
  (局 n)
  (若 (! x) (返回 32))
  (当 (! (& x 0x80000000)) (置 x (<< x 1)) (置 n (+ n 1)))
  (返回 n))
(函数 尾随零 (x)
  (局 n)
  (若 (! x) (返回 32))
  (当 (! (& x 1)) (置 x (>>u x 1)) (置 n (+ n 1)))
  (返回 n))
(函数 一计数 (x)
  (局 n)
  (当 x (置 n (+ n (& x 1))) (置 x (>>u x 1)))
  (返回 n))

; ---- 宽整数运算 ----
(函数 拷槽 (d s)
  (存4 d (读4 s))
  (存4 (+ d 4) (读4 (+ s 4))))
(函数 除余64有 (q r a b)
  (局 na nb ta tb tq tr)
  (置 ta S_临时) (置 tb (+ S_临时 8)) (置 tq (+ S_临时 16)) (置 tr (+ S_临时 24))
  (置 na (< (读4 (+ a 4)) 0))
  (置 nb (< (读4 (+ b 4)) 0))
  (若否 na ((取负64 ta a)) ((拷槽 ta a)))
  (若否 nb ((取负64 tb b)) ((拷槽 tb b)))
  (除余64无 tq tr ta tb)
  (若否 (!= na nb) ((取负64 q tq)) ((拷槽 q tq)))
  (若否 na ((取负64 r tr)) ((拷槽 r tr))))
(函数 前导零64 (a)
  (局 hi)
  (置 hi (读4 (+ a 4)))
  (若 hi (返回 (前导零 hi)))
  (返回 (+ 32 (前导零 (读4 a)))))
(函数 尾随零64 (a)
  (局 lo)
  (置 lo (读4 a))
  (若 lo (返回 (尾随零 lo)))
  (返回 (+ 32 (尾随零 (读4 (+ a 4))))))
; i64 指令：返回新 sp
(函数 执行i64 (op sp)
  (局 a b r c)
  (分派 op
    (情形 (0x50)   ; i64.eqz
      (置 a (- sp 8))
      (存4 a (&& (! (读4 a)) (! (读4 (+ a 4)))))
      (返回 sp))
    (情形 ((范围 0x51 0x5A))
      (置 b (- sp 8)) (置 a (- sp 16))
      (置 c (选 (|| (== op 0x53) (|| (== op 0x55) (|| (== op 0x57) (== op 0x59)))) (比较64有 a b) (比较64无 a b)))
      (存4 a (选 (== op 0x51) (== c 0)
        (选 (== op 0x52) (!= c 0)
          (选 (|| (== op 0x53) (== op 0x54)) (< c 0)
            (选 (|| (== op 0x55) (== op 0x56)) (> c 0)
              (选 (|| (== op 0x57) (== op 0x58)) (<= c 0) (>= c 0)))))))
      (返回 (- sp 8)))
    (情形 (0x79) (置 a (- sp 8)) (存4 a (前导零64 a)) (存4 (+ a 4) 0) (返回 sp))
    (情形 (0x7A) (置 a (- sp 8)) (存4 a (尾随零64 a)) (存4 (+ a 4) 0) (返回 sp))
    (情形 (0x7B) (置 a (- sp 8)) (存4 a (+ (一计数 (读4 a)) (一计数 (读4 (+ a 4))))) (存4 (+ a 4) 0) (返回 sp))
    (情形 (0x7C) (加64 (- sp 16) (- sp 16) (- sp 8)) (返回 (- sp 8)))
    (情形 (0x7D) (减64 (- sp 16) (- sp 16) (- sp 8)) (返回 (- sp 8)))
    (情形 (0x7E) (乘64 (- sp 16) (- sp 16) (- sp 8)) (返回 (- sp 8)))
    (情形 (0x7F 0x81)
      (置 b (- sp 8)) (置 a (- sp 16))
      (若 (&& (! (读4 b)) (! (读4 (+ b 4)))) (陷阱退出 125 "整数除零"))
      (若 (&& (== op 0x7F) (&& (&& (! (读4 a)) (== (读4 (+ a 4)) 0x80000000)) (&& (== (读4 b) -1) (== (读4 (+ b 4)) -1))))
        (陷阱退出 125 "整数溢出"))
      (置 c (+ S_临时 32))
      (除余64有 (选 (== op 0x7F) a c) (选 (== op 0x7F) c a) a b)
      (返回 (- sp 8)))
    (情形 (0x80 0x82)
      (置 b (- sp 8)) (置 a (- sp 16))
      (若 (&& (! (读4 b)) (! (读4 (+ b 4)))) (陷阱退出 125 "整数除零"))
      (置 c (+ S_临时 32))
      (除余64无 (选 (== op 0x80) a c) (选 (== op 0x80) c a) a b)
      (返回 (- sp 8)))
    (情形 (0x83) (置 a (- sp 16)) (置 b (- sp 8)) (存4 a (& (读4 a) (读4 b))) (存4 (+ a 4) (& (读4 (+ a 4)) (读4 (+ b 4)))) (返回 (- sp 8)))
    (情形 (0x84) (置 a (- sp 16)) (置 b (- sp 8)) (存4 a (| (读4 a) (读4 b))) (存4 (+ a 4) (| (读4 (+ a 4)) (读4 (+ b 4)))) (返回 (- sp 8)))
    (情形 (0x85) (置 a (- sp 16)) (置 b (- sp 8)) (存4 a (^ (读4 a) (读4 b))) (存4 (+ a 4) (^ (读4 (+ a 4)) (读4 (+ b 4)))) (返回 (- sp 8)))
    (情形 (0x86) (左移64 (- sp 16) (- sp 16) (读4 (- sp 8))) (返回 (- sp 8)))
    (情形 (0x87) (右移64有 (- sp 16) (- sp 16) (读4 (- sp 8))) (返回 (- sp 8)))
    (情形 (0x88) (右移64无 (- sp 16) (- sp 16) (读4 (- sp 8))) (返回 (- sp 8)))
    (情形 (0x89 0x8A)
      ; 循环移位：rotl(x,n) = (x<<n) | (x>>(64-n))
      (置 a (- sp 16))
      (置 c (& (读4 (- sp 8)) 63))
      (若 (== op 0x8A) (置 c (& (- 64 c) 63)))
      (拷槽 S_临时 a)
      (拷槽 (+ S_临时 8) a)
      (左移64 S_临时 S_临时 c)
      (右移64无 (+ S_临时 8) (+ S_临时 8) (& (- 64 c) 63))
      (若否 c
        ((存4 a (| (读4 S_临时) (读4 (+ S_临时 8))))
         (存4 (+ a 4) (| (读4 (+ S_临时 4)) (读4 (+ S_临时 12)))))
        ())
      (返回 (- sp 8)))
    (情形 (0xA7) (存4 (- sp 8) (读4 (- sp 8))) (返回 sp))          ; i32.wrap_i64：低字即结果
    (情形 (0xAC) (置 a (- sp 8)) (存4 (+ a 4) (>> (读4 a) 31)) (返回 sp))   ; i64.extend_i32_s
    (情形 (0xAD) (置 a (- sp 8)) (存4 (+ a 4) 0) (返回 sp))                 ; i64.extend_i32_u
    (情形 (0xC2) (置 a (- sp 8)) (存4 a (>> (<< (读4 a) 24) 24)) (存4 (+ a 4) (>> (读4 a) 31)) (返回 sp))
    (情形 (0xC3) (置 a (- sp 8)) (存4 a (>> (<< (读4 a) 16) 16)) (存4 (+ a 4) (>> (读4 a) 31)) (返回 sp))
    (情形 (0xC4) (置 a (- sp 8)) (存4 (+ a 4) (>> (读4 a) 31)) (返回 sp))
    (情形 (0xBD 0xBF) (返回 sp))                                            ; 重解释：位不变
    (否则 (陷阱退出 126 "不支持的数值指令")))
  (返回 sp))
(函数 执行浮点 (op sp)
  ; 浮点运算暂不支持；仅允许不改值的重解释与复制
  (陷阱退出 126 "浮点运算尚未支持")
  (返回 sp))

; ---- 客体线性内存 ----
(函数 客内存字节 () (返回 (* (读4 S_客页数) 65536)))
(函数 有效地址 (基址 偏移 宽)
  (局 ea)
  (置 ea (+ 基址 偏移))
  (若 (|| (<u ea 基址) (>u (+ ea 宽) (客内存字节)) (<u (+ ea 宽) ea)) (陷阱退出 127 "线性内存越界"))
  (返回 (+ (读4 S_客内存) ea)))
; 访存指令：pc 指向 memarg；返回新 sp；新 pc 在 S_新pc
(函数 执行访存 (op pc sp)
  (局 偏移 a v)
  (弃 (读u32 pc))
  (置 pc (读4 S_读址))
  (取u 偏移 pc)
  (存4 S_新pc pc)
  (分派 op
    (情形 (0x28 0x2A) (置 a (有效地址 (读4 (- sp 8)) 偏移 4)) (存4 (- sp 8) (读4 a)) (返回 sp))
    (情形 (0x29 0x2B) (置 a (有效地址 (读4 (- sp 8)) 偏移 8)) (存4 (- sp 8) (读4 a)) (存4 (- sp 4) (读4 (+ a 4))) (返回 sp))
    (情形 (0x2C) (置 a (有效地址 (读4 (- sp 8)) 偏移 1)) (存4 (- sp 8) (读1有 a)) (返回 sp))
    (情形 (0x2D) (置 a (有效地址 (读4 (- sp 8)) 偏移 1)) (存4 (- sp 8) (读1 a)) (返回 sp))
    (情形 (0x2E) (置 a (有效地址 (读4 (- sp 8)) 偏移 2)) (存4 (- sp 8) (读2有 a)) (返回 sp))
    (情形 (0x2F) (置 a (有效地址 (读4 (- sp 8)) 偏移 2)) (存4 (- sp 8) (读2 a)) (返回 sp))
    (情形 (0x30) (置 a (有效地址 (读4 (- sp 8)) 偏移 1)) (置 v (读1有 a)) (存4 (- sp 8) v) (存4 (- sp 4) (>> v 31)) (返回 sp))
    (情形 (0x31) (置 a (有效地址 (读4 (- sp 8)) 偏移 1)) (存4 (- sp 8) (读1 a)) (存4 (+ (- sp 8) 4) 0) (返回 sp))
    (情形 (0x32) (置 a (有效地址 (读4 (- sp 8)) 偏移 2)) (置 v (读2有 a)) (存4 (- sp 8) v) (存4 (+ (- sp 8) 4) (>> v 31)) (返回 sp))
    (情形 (0x33) (置 a (有效地址 (读4 (- sp 8)) 偏移 2)) (存4 (- sp 8) (读2 a)) (存4 (+ (- sp 8) 4) 0) (返回 sp))
    (情形 (0x34) (置 a (有效地址 (读4 (- sp 8)) 偏移 4)) (置 v (读4 a)) (存4 (- sp 8) v) (存4 (+ (- sp 8) 4) (>> v 31)) (返回 sp))
    (情形 (0x35) (置 a (有效地址 (读4 (- sp 8)) 偏移 4)) (存4 (- sp 8) (读4 a)) (存4 (+ (- sp 8) 4) 0) (返回 sp))
    (情形 (0x36 0x38) (置 a (有效地址 (读4 (- sp 16)) 偏移 4)) (存4 a (读4 (- sp 8))) (返回 (- sp 16)))
    (情形 (0x37 0x39) (置 a (有效地址 (读4 (- sp 16)) 偏移 8)) (存4 a (读4 (- sp 8))) (存4 (+ a 4) (读4 (+ (- sp 8) 4))) (返回 (- sp 16)))
    (情形 (0x3A 0x3C) (置 a (有效地址 (读4 (- sp 16)) 偏移 1)) (存1 a (读4 (- sp 8))) (返回 (- sp 16)))
    (情形 (0x3B 0x3D) (置 a (有效地址 (读4 (- sp 16)) 偏移 2)) (存2 a (读4 (- sp 8))) (返回 (- sp 16)))
    (情形 (0x3E) (置 a (有效地址 (读4 (- sp 16)) 偏移 4)) (存4 a (读4 (- sp 8))) (返回 (- sp 16)))
    (否则 (陷阱退出 126 "未知访存指令")))
  (返回 sp))

; ---- 杂项前缀（0xFC）：批量内存与表操作；浮点饱和转换不支持 ----
(函数 执行杂项 (子 pc sp)
  (局 段 表 d s n 条 甲 乙)
  (分派 子
    (情形 ((范围 0 7)) (陷阱退出 126 "浮点转换尚未支持"))
    (情形 (8)     ; memory.init 数据段号 内存号
      (取u 段 pc) (置 pc (+ pc 1))
      (存4 S_新pc pc)
      (置 n (读4 (- sp 8))) (置 s (读4 (- sp 16))) (置 d (读4 (- sp 24)))
      (置 条 (+ (读4 S_数据段表) (* 段 20)))
      (若 (|| (>u (+ s n) (选 (读4 (+ 条 12)) 0 (读4 (+ 条 4)))) (|| (<u (+ s n) s) (>u (+ d n) (客内存字节)))) (陷阱退出 127 "memory.init 越界"))
      (拷贝 (+ (读4 S_客内存) d) (+ (读4 条) s) n)
      (返回 (- sp 24)))
    (情形 (9)     ; data.drop
      (取u 段 pc)
      (存4 S_新pc pc)
      (存4 (+ (+ (读4 S_数据段表) (* 段 20)) 12) 1)
      (返回 sp))
    (情形 (10)    ; memory.copy
      (置 pc (+ pc 2))
      (存4 S_新pc pc)
      (置 n (读4 (- sp 8))) (置 s (读4 (- sp 16))) (置 d (读4 (- sp 24)))
      (若 (|| (|| (>u (+ s n) (客内存字节)) (<u (+ s n) s)) (|| (>u (+ d n) (客内存字节)) (<u (+ d n) d))) (陷阱退出 127 "memory.copy 越界"))
      (拷贝 (+ (读4 S_客内存) d) (+ (读4 S_客内存) s) n)
      (返回 (- sp 24)))
    (情形 (11)    ; memory.fill
      (置 pc (+ pc 1))
      (存4 S_新pc pc)
      (置 n (读4 (- sp 8))) (置 s (读4 (- sp 16))) (置 d (读4 (- sp 24)))
      (若 (|| (>u (+ d n) (客内存字节)) (<u (+ d n) d)) (陷阱退出 127 "memory.fill 越界"))
      (若 (> n 0) (内存填充 (+ (读4 S_客内存) d) s n))
      (返回 (- sp 24)))
    (情形 (16)    ; table.size
      (取u 表 pc)
      (存4 S_新pc pc)
      (存4 sp (读4 (+ (+ (读4 S_表描述) (* 表 16)) 4)))
      (返回 (+ sp 8)))
    (否则 (陷阱退出 126 "不支持的杂项指令")))
  (返回 sp))
