; 客体执行器二号：持久文件系统——双区追加日志 + 内存索引 + 紧缩
; 磁盘：扇区 0/1 为交替写的超级块；其后两个等长区，每区是记录序列。
; 记录 = 头扇区（含路径）+ 数据扇区 + 提交扇区；头扇区：+0 魔数 'YYR1' +4 代 +8 序号 +12 类型(1建目录 2写文件 3删除)
;   +16 路径长 +20 数据长 +24 数据扇区数 +28 数据校验 +32 头校验(覆盖0..31) +36 起为路径字节
; 提交扇区：+0 魔数 'YYC1' +4 代 +8 序号 +12 头校验 +16 数据校验 +20 提交校验(覆盖0..19)
; 挂载：选最高代的有效超级块，顺序验证记录，遇到无效头或缺提交扇区即为日志尾；已提交却校验失败的数据使挂载失败。
(常量 魔数超级 0x53465959)
(常量 魔数头 0x31525959)
(常量 魔数提交 0x31435959)
(常量 条目字节 32)
(常量 条目上限值 4096)
(常量 路径池字节 262144)
(常量 路径上限 440)
; 错误码
(常量 错_无 0)
(常量 错_不存在 1)
(常量 错_类型 2)
(常量 错_已存在 3)
(常量 错_非空 4)
(常量 错_空间 5)
(常量 错_参数 6)
(常量 错_输入输出 7)
(常量 错_未挂载 8)

; ---- 校验（FNV-1a） ----
(函数 校验 (址 长 种子)
  (局 h i)
  (置 h 种子)
  (置 i 0)
  (当 (< i 长)
    (置 h (* (^ h (读1 (+ 址 i))) 16777619))
    (置 i (+ i 1)))
  (返回 h))
(函数 上取扇区 (字节) (返回 (>>u (+ 字节 511) 9)))

; ---- 条目表：每项 32 字节 [路径址 路径长 种类(0已删 1文件 2目录) 数据扇区 数据长 序号 保留 保留] ----
(宏 条 (i) (+ (读4 S_FS_条目) (* i 32)))
(函数 相同路径 (甲址 甲长 乙址 乙长)
  (若 (!= 甲长 乙长) (返回 0))
  (返回 (相同字节 甲址 乙址 甲长)))
(函数 索引查 (址 长)
  (局 i n e)
  (置 n (读4 S_FS_条目数))
  (置 i 0)
  (当 (< i n)
    (置 e (条 i))
    (若 (&& (!= (读4 (+ e 8)) 0) (相同路径 (读4 e) (读4 (+ e 4)) 址 长)) (返回 i))
    (置 i (+ i 1)))
  (返回 -1))
(函数 池存串 (址 长)
  (局 p)
  (置 p (读4 S_FS_池顶))
  (若 (>u (+ p 长) (读4 S_FS_池限)) (返回 0))
  (拷贝 p 址 长)
  (存4 S_FS_池顶 (+ p 长))
  (返回 p))
; 新增或更新条目；返回条目号，-1 表示表或池已满
(函数 索引置 (址 长 种类 数据扇区 数据长 序)
  (局 i e p)
  (置 i (索引查 址 长))
  (若 (>= i 0)
    (置 e (条 i))
    (存4 (+ e 8) 种类)
    (存4 (+ e 12) 数据扇区)
    (存4 (+ e 16) 数据长)
    (存4 (+ e 20) 序)
    (返回 i))
  (若 (>=u (读4 S_FS_条目数) (读4 S_FS_条目限)) (返回 -1))
  (置 p (池存串 址 长))
  (若 (! p) (返回 -1))
  (置 i (读4 S_FS_条目数))
  (存4 S_FS_条目数 (+ i 1))
  (置 e (条 i))
  (存4 e p)
  (存4 (+ e 4) 长)
  (存4 (+ e 8) 种类)
  (存4 (+ e 12) 数据扇区)
  (存4 (+ e 16) 数据长)
  (存4 (+ e 20) 序)
  (返回 i))
; 是否有存活子项
(函数 有子项 (址 长)
  (局 i n e pa pl 起)
  (置 n (读4 S_FS_条目数))
  (置 起 (选 (== 长 1) 1 (+ 长 1)))
  (置 i 0)
  (当 (< i n)
    (置 e (条 i))
    (置 pa (读4 e))
    (置 pl (读4 (+ e 4)))
    (若 (&& (!= (读4 (+ e 8)) 0) (&& (> pl 起) (相同字节 pa 址 长)))
      ; 前缀相同；根目录时 前缀为 "/"，其他为 路径+"/"
      (若 (|| (== 长 1) (== (读1 (+ pa 长)) 47)) (返回 1)))
    (置 i (+ i 1)))
  (返回 0))
; 父路径长度（不含末尾斜线；根的子项父长为 1，即 "/"）
(函数 父长 (址 长)
  (局 i)
  (置 i (- 长 1))
  (当 (&& (> i 0) (!= (读1 (+ 址 i)) 47)) (置 i (- i 1)))
  (返回 (选 (== i 0) 1 i)))

; ---- 超级块 ----
(函数 写超级块 (槽 代 活 区长)
  (局 b)
  (置 b (读4 S_FS_扇区))
  (清零 b 512)
  (存4 b 魔数超级)
  (存4 (+ b 4) 1)
  (存4 (+ b 8) 代)
  (存4 (+ b 12) 活)
  (存4 (+ b 16) 2)
  (存4 (+ b 20) 区长)
  (存4 (+ b 24) (读4 S_FS_容量))
  (存4 (+ b 28) (校验 b 28 校验初值))
  (返回 (块写 槽 b)))
; 读超级块到缓冲 缓；有效返回代（>0），无效返回 0
(函数 读超级块 (槽 缓)
  (若 (!= (块读 槽 缓) 0) (返回 0))
  (若 (!= (读4 缓) 魔数超级) (返回 0))
  (若 (!= (读4 (+ 缓 28)) (校验 缓 28 校验初值)) (返回 0))
  (若 (!= (读4 (+ 缓 4)) 1) (返回 0))
  (返回 (读4 (+ 缓 8))))

; ---- 记录读写 ----
; 追加一条记录。数据来源：旧扇区 < 0 时取自内存 数据址，否则取自磁盘上的旧数据区（紧缩用）。
; 成功返回 0，并把记录起始扇区存入 S_FS_读扇区。
(函数 写记录 (类型 路径址 路径长 数据址 数据长 旧扇区)
  (局 p ds 头 提交 缓 缓三 h dsum 序 代 k 余)
  (置 p (读4 S_FS_尾))
  (置 ds (上取扇区 数据长))
  (置 序 (读4 S_FS_序))
  (置 代 (读4 S_FS_代))
  (若 (>u (+ p (+ ds 2)) (+ (读4 S_FS_区起) (读4 S_FS_区长))) (返回 错_空间))
  (置 缓 (读4 S_FS_扇区二))
  (置 缓三 (读4 S_FS_扇区三))
  ; 数据校验
  (置 dsum 校验初值)
  (若否 (>= 旧扇区 0)
    ((置 k 0)
     (当 (< k ds)
       (若 (!= (块读 (+ 旧扇区 k) 缓三) 0) (返回 错_输入输出))
       (置 余 (- 数据长 (* k 512)))
       (置 dsum (校验 缓三 (选 (>= 余 512) 512 余) dsum))
       (置 k (+ k 1))))
    ((若 (> 数据长 0) (置 dsum (校验 数据址 数据长 校验初值)))))
  ; 写数据扇区
  (置 k 0)
  (当 (< k ds)
    (置 余 (- 数据长 (* k 512)))
    (若否 (>= 旧扇区 0)
      ((若 (!= (块读 (+ 旧扇区 k) 缓三) 0) (返回 错_输入输出))
       (若 (< 余 512) (清零 (+ 缓三 余) (- 512 余)))
       (若 (!= (块写 (+ (+ p 1) k) 缓三) 0) (返回 错_输入输出)))
      ((若否 (>= 余 512)
         ((若 (!= (块写 (+ (+ p 1) k) (+ 数据址 (* k 512))) 0) (返回 错_输入输出)))
         ((清零 缓 512)
          (拷贝 缓 (+ 数据址 (* k 512)) 余)
          (若 (!= (块写 (+ (+ p 1) k) 缓) 0) (返回 错_输入输出))))))
    (置 k (+ k 1)))
  ; 头扇区
  (置 头 (读4 S_FS_扇区))
  (清零 头 512)
  (存4 头 魔数头)
  (存4 (+ 头 4) 代)
  (存4 (+ 头 8) 序)
  (存4 (+ 头 12) 类型)
  (存4 (+ 头 16) 路径长)
  (存4 (+ 头 20) 数据长)
  (存4 (+ 头 24) ds)
  (存4 (+ 头 28) dsum)
  (存4 (+ 头 32) (校验 头 32 校验初值))
  (拷贝 (+ 头 36) 路径址 路径长)
  (若 (!= (块写 p 头) 0) (返回 错_输入输出))
  (置 h (读4 (+ 头 32)))
  (块刷新)
  ; 提交扇区
  (置 提交 (读4 S_FS_扇区))
  (清零 提交 512)
  (存4 提交 魔数提交)
  (存4 (+ 提交 4) 代)
  (存4 (+ 提交 8) 序)
  (存4 (+ 提交 12) h)
  (存4 (+ 提交 16) dsum)
  (存4 (+ 提交 20) (校验 提交 20 校验初值))
  (若 (!= (块写 (+ (+ p 1) ds) 提交) 0) (返回 错_输入输出))
  (块刷新)
  (存4 S_FS_读扇区 p)
  (存4 S_FS_尾 (+ p (+ ds 2)))
  (存4 S_FS_序 (+ 序 1))
  (返回 0))

; 应用一条已验证记录到索引：p 为记录起始扇区
(函数 应用记录 (类型 路径址 路径长 数据扇区 数据长 序)
  (局 i)
  (若否 (== 类型 1)
    ((若 (< (索引置 路径址 路径长 2 0 0 序) 0) (返回 错_空间)))
    ((若否 (== 类型 2)
      ((若 (< (索引置 路径址 路径长 1 数据扇区 数据长 序) 0) (返回 错_空间)))
      ((置 i (索引查 路径址 路径长))
       (若 (>= i 0) (存4 (+ (条 i) 8) 0))))))
  (返回 0))

; 扫描一个区：验证记录并重建索引；返回 0 成功、-1 数据损坏、正数为应用错误
(函数 扫描区 (区起 区长 代)
  (局 p 序 头 提交 缓 ds 数据长 类型 路径长 dsum 期 k 余 h 果 缓二 路径址)
  (置 缓 (读4 S_FS_扇区))
  (置 缓二 (读4 S_FS_扇区二))
  (置 p 区起)
  (置 序 1)
  (当 1
    (若 (>u (+ p 2) (+ 区起 区长)) (中断))
    (若 (!= (块读 p 缓) 0) (返回 -1))
    (若 (!= (读4 缓) 魔数头) (中断))
    (若 (!= (读4 (+ 缓 4)) 代) (中断))
    (若 (!= (读4 (+ 缓 8)) 序) (中断))
    (若 (!= (读4 (+ 缓 32)) (校验 缓 32 校验初值)) (中断))
    (置 类型 (读4 (+ 缓 12)))
    (置 路径长 (读4 (+ 缓 16)))
    (置 数据长 (读4 (+ 缓 20)))
    (置 ds (读4 (+ 缓 24)))
    (置 dsum (读4 (+ 缓 28)))
    (若 (|| (< 类型 1) (> 类型 3)) (中断))
    (若 (|| (> 路径长 路径上限) (< 路径长 1)) (中断))
    (若 (!= ds (上取扇区 数据长)) (中断))
    (若 (>u (+ p (+ ds 2)) (+ 区起 区长)) (中断))
    (置 h (读4 (+ 缓 32)))
    ; 路径复制到路径缓冲（缓冲二会被复用，先把路径拷出）
    (置 路径址 (读4 S_FS_路径缓))
    (拷贝 路径址 (+ 缓 36) 路径长)
    ; 提交扇区
    (若 (!= (块读 (+ (+ p 1) ds) 缓) 0) (返回 -1))
    (若 (|| (!= (读4 缓) 魔数提交) (|| (!= (读4 (+ 缓 4)) 代) (|| (!= (读4 (+ 缓 8)) 序) (|| (!= (读4 (+ 缓 12)) h) (!= (读4 (+ 缓 20)) (校验 缓 20 校验初值))))))
      (中断))
    ; 已提交：数据校验必须一致
    (若 (!= (读4 (+ 缓 16)) dsum) (返回 -1))
    (置 期 校验初值)
    (置 k 0)
    (当 (< k ds)
      (若 (!= (块读 (+ (+ p 1) k) 缓二) 0) (返回 -1))
      (置 余 (- 数据长 (* k 512)))
      (置 期 (校验 缓二 (选 (>= 余 512) 512 余) 期))
      (置 k (+ k 1)))
    (若 (!= 期 dsum) (返回 -1))
    (置 果 (应用记录 类型 路径址 路径长 (+ p 1) 数据长 序))
    (若 果 (返回 果))
    (置 p (+ p (+ ds 2)))
    (置 序 (+ 序 1)))
  (存4 S_FS_尾 p)
  (存4 S_FS_序 序)
  (返回 0))

; ---- 挂载与格式化 ----
(函数 文件系统清空索引 ()
  (存4 S_FS_条目数 0)
  (存4 S_FS_池顶 (读4 S_FS_池))
  ; 根目录
  (弃 (索引置 "/" 1 2 0 0 0)))
(函数 文件系统初始化 ()
  (存4 S_FS_条目 (取区域 (* 条目上限值 条目字节)))
  (存4 S_FS_条目限 条目上限值)
  (存4 S_FS_池 (取区域 路径池字节))
  (存4 S_FS_池限 (+ (读4 S_FS_池) 路径池字节))
  (存4 S_FS_扇区 (取区域 512))
  (存4 S_FS_扇区二 (取区域 512))
  (存4 S_FS_扇区三 (取区域 512))
  (存4 S_FS_路径缓 (取区域 2048))
  (存4 S_FS_当前目录 (取区域 1024))
  (存1 (读4 S_FS_当前目录) 47)
  (存4 S_FS_当前长 1)
  (存4 S_FS_错误码 0)
  (存4 S_FS_已挂载 0))
(函数 文件系统挂载 ()
  (局 甲 乙 代 活 区长 区起 果 缓一 缓二)
  (存4 S_FS_已挂载 0)
  (若 (! (块就绪)) (返回 错_输入输出))
  (存4 S_FS_容量 (块容量))
  (置 缓一 (取区域 512))
  (置 缓二 (取区域 512))
  (置 甲 (读超级块 0 缓一))
  (置 乙 (读超级块 1 缓二))
  (若 (&& (== 甲 0) (== 乙 0)) (返回 错_未挂载))
  (若否 (>u 甲 乙)
    ((置 代 甲) (置 活 (读4 (+ 缓一 12))) (置 区长 (读4 (+ 缓一 20))))
    ((置 代 乙) (置 活 (读4 (+ 缓二 12))) (置 区长 (读4 (+ 缓二 20)))))
  (若 (|| (> 活 1) (< 区长 8)) (返回 错_输入输出))
  (置 区起 (+ 2 (* 活 区长)))
  (若 (>u (+ 区起 区长) (读4 S_FS_容量)) (返回 错_输入输出))
  (存4 S_FS_活区 活)
  (存4 S_FS_区起 区起)
  (存4 S_FS_区长 区长)
  (存4 S_FS_代 代)
  (文件系统清空索引)
  (置 果 (扫描区 区起 区长 代))
  (若 果 (返回 果))
  (存4 S_FS_已挂载 1)
  (返回 0))
(函数 文件系统格式化 ()
  (局 甲 乙 代 区长 缓 容)
  (若 (! (块就绪)) (返回 错_输入输出))
  (置 容 (块容量))
  (存4 S_FS_容量 容)
  (若 (< 容 20) (返回 错_空间))
  (置 缓 (取区域 512))
  (置 甲 (读超级块 0 缓))
  (置 乙 (读超级块 1 缓))
  (置 代 (+ (选 (>u 甲 乙) 甲 乙) 1))
  (置 区长 (>>u (- 容 2) 1))
  ; 使两个区起点失效
  (清零 缓 512)
  (若 (!= (块写 2 缓) 0) (返回 错_输入输出))
  (若 (!= (块写 (+ 2 区长) 缓) 0) (返回 错_输入输出))
  (若 (!= (写超级块 (& 代 1) 代 0 区长) 0) (返回 错_输入输出))
  (块刷新)
  (返回 (文件系统挂载)))

; ---- 紧缩：把存活条目写入另一区并切换超级块 ----
(函数 紧缩 ()
  (局 旧起 旧代 旧尾 旧序 新区 新起 区长 新代 i n e 类 果 路径址 路径长 旧扇区 数据长)
  (置 区长 (读4 S_FS_区长))
  (置 新区 (- 1 (读4 S_FS_活区)))
  (置 新起 (+ 2 (* 新区 区长)))
  (置 新代 (+ (读4 S_FS_代) 1))
  (置 旧起 (读4 S_FS_区起))
  (置 旧代 (读4 S_FS_代))
  (置 旧尾 (读4 S_FS_尾))
  (置 旧序 (读4 S_FS_序))
  ; 使新区起点失效
  (清零 (读4 S_FS_扇区二) 512)
  (若 (!= (块写 新起 (读4 S_FS_扇区二)) 0) (返回 错_输入输出))
  (存4 S_FS_区起 新起)
  (存4 S_FS_尾 新起)
  (存4 S_FS_序 1)
  (存4 S_FS_代 新代)
  (置 n (读4 S_FS_条目数))
  (置 i 1)
  (置 果 0)
  (当 (&& (< i n) (! 果))
    (置 e (条 i))
    (置 类 (读4 (+ e 8)))
    (若 类
      (置 路径址 (读4 e))
      (置 路径长 (读4 (+ e 4)))
      (置 旧扇区 (读4 (+ e 12)))
      (置 数据长 (读4 (+ e 16)))
      (若否 (== 类 2)
        ((置 果 (写记录 1 路径址 路径长 0 0 -1)))
        ((置 果 (写记录 2 路径址 路径长 0 数据长 旧扇区))
         (若 (! 果) (存4 (+ e 12) (+ (读4 S_FS_读扇区) 1))))))
    (置 i (+ i 1)))
  (若 果
    ; 失败：恢复旧状态（部分条目的数据位置可能已改，重新挂载可恢复）
    (存4 S_FS_区起 旧起)
    (存4 S_FS_代 旧代)
    (存4 S_FS_尾 旧尾)
    (存4 S_FS_序 旧序)
    (返回 果))
  (若 (!= (写超级块 (& 新代 1) 新代 新区 区长) 0) (返回 错_输入输出))
  (块刷新)
  (存4 S_FS_活区 新区)
  (返回 0))

; ---- 对外操作（路径均为已规范化的绝对路径） ----
(函数 追加记录 (类型 路径址 路径长 数据址 数据长)
  (局 果 需)
  (置 果 (写记录 类型 路径址 路径长 数据址 数据长 -1))
  (若 (== 果 错_空间)
    (置 果 (紧缩))
    (若 果 (返回 果))
    (置 果 (写记录 类型 路径址 路径长 数据址 数据长 -1)))
  (返回 果))
(函数 fs建目录 (路径址 路径长)
  (局 果 父 父项)
  (若 (! (读4 S_FS_已挂载)) (返回 错_未挂载))
  (若 (|| (< 路径长 2) (> 路径长 路径上限)) (返回 错_参数))
  (若 (>= (索引查 路径址 路径长) 0) (返回 错_已存在))
  (置 父项 (索引查 路径址 (父长 路径址 路径长)))
  (若 (< 父项 0) (返回 错_不存在))
  (若 (!= (读4 (+ (条 父项) 8)) 2) (返回 错_类型))
  (置 果 (追加记录 1 路径址 路径长 0 0))
  (若 果 (返回 果))
  (若 (< (索引置 路径址 路径长 2 0 0 (- (读4 S_FS_序) 1)) 0) (返回 错_空间))
  (返回 0))
(函数 fs写文件 (路径址 路径长 数据址 数据长)
  (局 果 父项 旧)
  (若 (! (读4 S_FS_已挂载)) (返回 错_未挂载))
  (若 (|| (< 路径长 2) (> 路径长 路径上限)) (返回 错_参数))
  (置 旧 (索引查 路径址 路径长))
  (若 (&& (>= 旧 0) (== (读4 (+ (条 旧) 8)) 2)) (返回 错_类型))
  (置 父项 (索引查 路径址 (父长 路径址 路径长)))
  (若 (< 父项 0) (返回 错_不存在))
  (若 (!= (读4 (+ (条 父项) 8)) 2) (返回 错_类型))
  (置 果 (追加记录 2 路径址 路径长 数据址 数据长))
  (若 果 (返回 果))
  (若 (< (索引置 路径址 路径长 1 (+ (读4 S_FS_读扇区) 1) 数据长 (- (读4 S_FS_序) 1)) 0) (返回 错_空间))
  (返回 0))
(函数 fs删除 (路径址 路径长)
  (局 果 项)
  (若 (! (读4 S_FS_已挂载)) (返回 错_未挂载))
  (若 (< 路径长 2) (返回 错_参数))
  (置 项 (索引查 路径址 路径长))
  (若 (< 项 0) (返回 错_不存在))
  (若 (&& (== (读4 (+ (条 项) 8)) 2) (有子项 路径址 路径长)) (返回 错_非空))
  (置 果 (追加记录 3 路径址 路径长 0 0))
  (若 果 (返回 果))
  (存4 (+ (条 项) 8) 0)
  (返回 0))
; 读文件内容到 目的址（须至少容纳 长 字节，向上取整到 512 的倍数以内可写）；成功返回 0
(函数 fs读文件 (项 目的址)
  (局 e 扇区 长 ds k 余 缓)
  (若 (! (读4 S_FS_已挂载)) (返回 错_未挂载))
  (置 e (条 项))
  (置 扇区 (读4 (+ e 12)))
  (置 长 (读4 (+ e 16)))
  (置 ds (上取扇区 长))
  (置 缓 (读4 S_FS_扇区二))
  (置 k 0)
  (当 (< k ds)
    (置 余 (- 长 (* k 512)))
    (若否 (>= 余 512)
      ((若 (!= (块读 (+ 扇区 k) (+ 目的址 (* k 512))) 0) (返回 错_输入输出)))
      ((若 (!= (块读 (+ 扇区 k) 缓) 0) (返回 错_输入输出))
       (拷贝 (+ 目的址 (* k 512)) 缓 余)))
    (置 k (+ k 1)))
  (返回 0))
