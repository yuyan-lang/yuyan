; 客体执行器二号：宿主调用（yuyan:gc-host/v1.call）——按名字分派到内置原语
; 值表示（见 运行时.wat）：整数 = i31 或 $big struct(i64)；字节串 = $bytes array(i8)；元组 = $tuple array(eqref)

; ---- 宿主对象类型：由导出的原型全局取得 ----
(函数 取原型类型 (导出名)
  (局 g)
  (置 g (查导出 导出名))
  (若 (< g 0) (返回 -1))
  (返回 (& (读4 (读4 (+ (读4 S_全局表) (* g 8)))) 0xFFFFFF)))
(函数 发现宿主类型 ()
  (存4 S_型字节 (取原型类型 串_字节数组))
  (存4 S_型元组 (取原型类型 串_元组))
  (存4 S_型大整 (取原型类型 串_大整))
  (存4 S_型浮点 (取原型类型 串_浮点)))

; ---- 对象构造 ----
(函数 新字节数组 (长)
  (局 t o)
  (置 t (读4 S_型字节))
  (置 o (分配对象 (数组字节 t 长) 种类数组 t))
  (存4 (+ o 8) 长)
  (返回 o))
(函数 新元组 (长)
  (局 t o)
  (置 t (读4 S_型元组))
  (置 o (分配对象 (数组字节 t 长) 种类数组 t))
  (存4 (+ o 8) 长)
  (返回 o))
(函数 装箱 (lo hi)
  (局 o t)
  (若 (&& (== hi (>> lo 31)) (|| (== (>> lo 30) 0) (== (>> lo 30) -1)))
    (返回 (| (<< lo 1) 1)))
  (置 t (读4 S_型大整))
  (置 o (分配对象 (结构字节 t) 种类结构 t))
  (存4 (+ o 8) lo)
  (存4 (+ o 12) hi)
  (返回 o))
(函数 装箱整 (v) (返回 (装箱 v (>> v 31))))
(函数 拆箱 (引 槽)
  (空引用检 引)
  (若 (& 引 1)
    (存4 槽 (>> 引 1))
    (存4 (+ 槽 4) (>> 引 31))
    (返回))
  (存4 槽 (读4 (+ 引 8)))
  (存4 (+ 槽 4) (读4 (+ 引 12))))
(函数 字节数组长 (o) (返回 (读4 (+ o 8))))
(函数 字节数组址 (o) (返回 (+ o 16)))
(函数 打印字节数组 (o)
  (局 i 长)
  (空引用检 o)
  (置 长 (读4 (+ o 8)))
  (置 i 0)
  (当 (< i 长)
    (写字节 (读1 (+ (+ o 16) i)))
    (置 i (+ i 1))))
(函数 元组项 (元组 i)
  (空引用检 元组)
  (若 (>=u i (读4 (+ 元组 8))) (陷阱退出 127 "宿主参数个数不足"))
  (返回 (读4 (+ (+ 元组 16) (* i 4)))))
(函数 设元组项 (元组 i v)
  (存4 (+ (+ 元组 16) (* i 4)) v))
(函数 主机名相同 (名 串)
  (若 (!= (字节数组长 名) (零串长 串)) (返回 0))
  (返回 (相同字节 (字节数组址 名) 串 (字节数组长 名))))
; 字面量字节串对象
(函数 字节串常量 (串)
  (局 长 o)
  (置 长 (零串长 串))
  (置 o (新字节数组 长))
  (拷贝 (+ o 16) 串 长)
  (返回 o))

; ---- 整数与十进制串 ----
(函数 整数转串 (引)
  (局 槽 非负 i 长 o 十 商 余 缓)
  (置 槽 (+ S_临时 40))
  (置 十 (+ S_临时 48))
  (置 商 (+ S_临时 56))
  (置 余 (+ S_临时 64))
  (拆箱 引 槽)
  (置 非负 (>= (读4 (+ 槽 4)) 0))
  (若 (! 非负) (取负64 槽 槽))
  (存4 十 10) (存4 (+ 十 4) 0)
  (置 缓 (+ 暂存缓冲 64))
  (置 i 0)
  (当 1
    (除余64无 商 余 槽 十)
    (置 i (+ i 1))
    (存1 (- 缓 i) (+ 48 (读4 余)))
    (拷槽 槽 商)
    (若 (&& (! (读4 槽)) (! (读4 (+ 槽 4)))) (中断)))
  (若 (! 非负) (置 i (+ i 1)) (存1 (- 缓 i) 45))
  (置 o (新字节数组 i))
  (拷贝 (+ o 16) (+ (- 缓 i) 1) i)
  (返回 o))
(函数 串转整 (o)
  (局 i 长 槽 十 位 负 c 已有)
  (空引用检 o)
  (置 长 (读4 (+ o 8)))
  (置 槽 (+ S_临时 40))
  (置 十 (+ S_临时 48))
  (置 位 (+ S_临时 56))
  (存4 槽 0) (存4 (+ 槽 4) 0)
  (存4 十 10) (存4 (+ 十 4) 0)
  (置 i 0)
  (当 (&& (< i 长) (|| (== (读1 (+ (+ o 16) i)) 32) (|| (== (读1 (+ (+ o 16) i)) 9) (|| (== (读1 (+ (+ o 16) i)) 10) (== (读1 (+ (+ o 16) i)) 13)))))
    (置 i (+ i 1)))
  (若 (< i 长)
    (置 c (读1 (+ (+ o 16) i)))
    (若 (== c 45) (置 负 1) (置 i (+ i 1)))
    (若 (&& (! 负) (== c 43)) (置 i (+ i 1))))
  (当 (< i 长)
    (置 c (读1 (+ (+ o 16) i)))
    (若 (|| (< c 48) (> c 57)) (中断))
    (乘64 槽 槽 十)
    (存4 位 (- c 48)) (存4 (+ 位 4) 0)
    (加64 槽 槽 位)
    (置 i (+ i 1)))
  (若 负 (取负64 槽 槽))
  (返回 (装箱 (读4 槽) (读4 (+ 槽 4)))))

; ---- 控制台行输入：回显、退格（按 UTF-8 字符删除）；返回行长度，内容在 S_行缓冲 ----
(函数 读行 ()
  (局 c n 缓)
  (置 缓 (读4 S_行缓冲))
  (当 1
    (置 c (读字节))
    (若否 (< c 0)
      ()
      ((分派 c
         (情形 (10) (写字节 10) (返回 n))
         (情形 (13))
         (情形 (8 127)
           (若 (> n 0)
             (当 (&& (> n 1) (== (& (读1 (+ 缓 (- n 1))) 192) 128)) (置 n (- n 1)))
             (置 n (- n 1))
             (写字节 8) (写字节 32) (写字节 8)))
         (否则
           (若 (< n (- 行缓冲大小 1)) (存1 (+ 缓 n) c) (置 n (+ n 1)))
           (写字节 c))))))
  (返回 n))

; ---- 原语号 ----
(函数 原语号 (名)
  (若 (主机名相同 名 名_打印行) (返回 1))
  (若 (主机名相同 名 名_打印字符串) (返回 2))
  (若 (主机名相同 名 名_标准错误打印行) (返回 3))
  (若 (主机名相同 名 名_打印通用值) (返回 4))
  (若 (主机名相同 名 名_退出进程) (返回 5))
  (若 (主机名相同 名 名_获取命令行程序名) (返回 6))
  (若 (主机名相同 名 名_获取命令行参数) (返回 7))
  (若 (主机名相同 名 名_获取当前工作目录) (返回 8))
  (若 (主机名相同 名 名_获取环境变量) (返回 9))
  (若 (|| (主机名相同 名 名_运行于Windows) (|| (主机名相同 名 名_运行于MacOS) (|| (主机名相同 名 名_运行于Linux) (|| (主机名相同 名 名_标准输出是终端) (主机名相同 名 名_标准输入是终端))))) (返回 10))
  (若 (主机名相同 名 名_尝试读取标准输入行) (返回 11))
  (若 (主机名相同 名 名_字节转字符串) (返回 12))
  (若 (主机名相同 名 名_字节串_空) (返回 13))
  (若 (主机名相同 名 名_字节串_长度) (返回 14))
  (若 (主机名相同 名 名_字节串_取字节) (返回 15))
  (若 (主机名相同 名 名_字节串_从字符串) (返回 16))
  (若 (主机名相同 名 名_字节串_单字节) (返回 17))
  (若 (主机名相同 名 名_字节串_拼接) (返回 18))
  (若 (主机名相同 名 名_整数加) (返回 19))
  (若 (主机名相同 名 名_整数乘) (返回 20))
  (若 (主机名相同 名 名_整数除) (返回 21))
  (若 (主机名相同 名 名_整数转字符串) (返回 22))
  (若 (主机名相同 名 名_字符串转整数) (返回 23))
  (返回 0))

; 调用宿主原语：名 与 参数元组 均为引用字；返回结果引用字
(函数 宿主调用 (名 参)
  (局 号 a b c o 长 i r)
  (空引用检 名)
  (置 号 (原语号 名))
  (存4 S_回收禁 (+ (读4 S_回收禁) 1))
  (分派 号
    (情形 (1 3 4) (打印字节数组 (元组项 参 0)) (写字节 10))
    (情形 (2) (打印字节数组 (元组项 参 0)))
    (情形 (5) (拆箱 (元组项 参 0) S_临时) (退出任务 (读4 S_临时)))
    (情形 (6) (置 r (字节串常量 "/程序.wasm")))
    (情形 (7)
      (置 o (新元组 2))
      (设元组项 o 0 (新元组 0))
      (设元组项 o 1 (装箱整 0))
      (置 r o))
    (情形 (8) (置 r (字节串常量 "/")))
    (情形 (9)
      (置 o (新元组 2))
      (设元组项 o 0 (装箱整 0))
      (设元组项 o 1 (新字节数组 0))
      (置 r o))
    (情形 (11)
      (置 长 (读行))
      (置 o (新元组 2))
      (设元组项 o 0 (装箱整 1))
      (置 a (新字节数组 长))
      (拷贝 (+ a 16) (读4 S_行缓冲) 长)
      (设元组项 o 1 a)
      (置 r o))
    (情形 (10) (置 r (装箱整 0)))
    (情形 (12)
      (拆箱 (元组项 参 0) S_临时)
      (置 a (读4 S_临时))
      (若 (|| (<= a 0) (> a 255)) (陷阱退出 127 "字节值越界"))
      (置 o (新字节数组 1))
      (存1 (+ o 16) a)
      (置 r o))
    (情形 (13) (置 r (新字节数组 0)))
    (情形 (14) (置 r (装箱整 (字节数组长 (元组项 参 0)))))
    (情形 (15)
      (置 a (元组项 参 0))
      (空引用检 a)
      (拆箱 (元组项 参 1) S_临时)
      (若 (|| (!= (读4 (+ S_临时 4)) 0) (>=u (读4 S_临时) (字节数组长 a))) (陷阱退出 127 "字节串索引越界"))
      (置 r (装箱整 (读1 (+ (+ a 16) (读4 S_临时))))))
    (情形 (16) (置 r (元组项 参 0)))
    (情形 (17)
      (拆箱 (元组项 参 0) S_临时)
      (置 a (读4 S_临时))
      (若 (|| (!= (读4 (+ S_临时 4)) 0) (>u a 255)) (陷阱退出 127 "字节值越界"))
      (置 o (新字节数组 1))
      (存1 (+ o 16) a)
      (置 r o))
    (情形 (18)
      (置 a (元组项 参 0))
      (置 b (元组项 参 1))
      (空引用检 a)
      (空引用检 b)
      (置 长 (+ (字节数组长 a) (字节数组长 b)))
      (置 o (新字节数组 长))
      (拷贝 (+ o 16) (+ a 16) (字节数组长 a))
      (拷贝 (+ (+ o 16) (字节数组长 a)) (+ b 16) (字节数组长 b))
      (置 r o))
    (情形 (19 20 21)
      (拆箱 (元组项 参 0) (+ S_临时 72))
      (拆箱 (元组项 参 1) (+ S_临时 80))
      (若否 (== 号 19)
        ((加64 (+ S_临时 72) (+ S_临时 72) (+ S_临时 80)))
        ((若否 (== 号 20)
           ((乘64 (+ S_临时 72) (+ S_临时 72) (+ S_临时 80)))
           ((若 (&& (! (读4 (+ S_临时 80))) (! (读4 (+ S_临时 84)))) (陷阱退出 125 "整数除零"))
            (除余64有 (+ S_临时 72) (+ S_临时 88) (+ S_临时 72) (+ S_临时 80))))))
      (置 r (装箱 (读4 (+ S_临时 72)) (读4 (+ S_临时 76)))))
    (情形 (22) (置 r (整数转串 (元组项 参 0))))
    (情形 (23) (置 r (串转整 (元组项 参 0))))
    (否则
      (打印零串 "未实现的宿主原语：")
      (打印字节数组 名)
      (写字节 10)
      (退出任务 136)))
  (存4 S_回收禁 (- (读4 S_回收禁) 1))
  (返回 r))

; 导入调用：返回新 sp
(函数 调用导入 (f sp)
  (局 E 号 结果)
  (存4 S_sp sp)
  (置 E (函数条 f))
  (置 号 (>>u (读4 (+ E 28)) 8))
  (若 (== 号 1)
    (置 结果 (宿主调用 (读4 (- sp 16)) (读4 (- sp 8))))
    (存4 (- sp 16) 结果)
    (存4 (- sp 12) 0)
    (返回 (- sp 8)))
  (陷阱退出 132 "调用了未连接的导入")
  (返回 sp))
