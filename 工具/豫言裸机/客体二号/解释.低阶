; 客体执行器二号：主解释循环

(宏 二元 (式) (块 (置 sp (- sp 8)) (存4 (- sp 8) 式)))
(宏 一元 (式) (存4 (- sp 8) 式))
(宏 甲低 () (读4 (- sp 8)))
(宏 乙低 () (读4 sp))
(宏 拷槽内 (d s) (块 (存4 d (读4 s)) (存4 (+ d 4) (读4 (+ s 4)))))
(宏 局址 (t) (+ fp (* t 8)))
(宏 全局址 (t) (+ (读4 S_全局表) (* t 8)))
; 分支后的公共收尾：pc 为 0 表示函数级返回
(宏 分支后 ()
  (块
    (置 pc (读4 S_新pc))
    (若 (! pc) (做返回))))
(宏 做返回 ()
  (块
    (置 sp (返回处理 sp fp))
    (置 pc (读4 S_新pc))
    (置 fp (读4 S_新fp))
    (置 sb (读4 S_边偏))
    (若 (! pc) (存4 S_sp sp) (返回 sp))))
(宏 调用后 ()
  (块
    (置 pc (读4 S_新pc))
    (置 fp (读4 S_新fp))
    (置 sb (读4 S_边偏))))

; 运行函数 f，参数在 sp 之下，返回时结果在新 sp 之下（返回新 sp）
(函数 运行函数 (f sp)
  (局 pc fp sb op oa t a b i e n base)
  ; 伪帧：返回地址 0 表示运行结束
  (令 F (读4 S_帧顶))
  (存4 F 0)
  (存4 (+ F 4) 0)
  (存4 (+ F 8) -1)
  (存4 (+ F 12) (读4 S_标签顶))
  (存4 (+ F 16) (读4 S_处理顶))
  (存4 S_帧顶 (+ F 32))
  (存4 S_函 -1)
  (置 sp (调用 f sp 0 0))
  (调用后)
  (当 1
    (置 oa pc)
    (置 op (读1 pc))
    (置 pc (+ pc 1))
    (跟踪点)
    (分派 op
      (情形 (0x00) (陷阱退出 128 "unreachable"))
      (情形 (0x01))
      (情形 (0x02)
        (置 pc (读块类型 pc))
        (置 e (+ sb (* oa 8)))
        (压标签 (读4 e) (- sp (* (读4 S_块参) 8)) (读4 S_块果) 0))
      (情形 (0x03)
        (置 pc (读块类型 pc))
        (压标签 pc (- sp (* (读4 S_块参) 8)) (读4 S_块参) 1))
      (情形 (0x04)
        (置 pc (读块类型 pc))
        (置 sp (- sp 8))
        (置 e (+ sb (* oa 8)))
        (置 base (- sp (* (读4 S_块参) 8)))
        (压标签 (读4 e) base (读4 S_块果) 2)
        (若 (! (读4 sp))
          (若否 (读4 (+ e 4))
            ((置 pc (读4 (+ e 4))))
            ((置 pc (- (读4 e) 1))))))
      (情形 (0x05)
        (置 pc (- (读4 (+ sb (* oa 8))) 1)))
      (情形 (0x0B)
        (若否 (== (读4 (- (读4 S_标签顶) 4)) 4)
          ((做返回))
          ((置 e (- (读4 S_标签顶) 16))
           (若 (== (读4 (+ e 12)) 3) (存4 S_处理顶 (- (读4 S_处理顶) 32)))
           (存4 S_标签顶 e))))
      (情形 (0x08)
        (取u t pc)
        (置 sp (执行抛出 t sp))
        (调用后)
        (若 (! pc) (做返回)))
      (情形 (0x0A)
        (置 sp (执行再抛 sp))
        (调用后)
        (若 (! pc) (做返回)))
      (情形 (0x1F)
        (置 pc (读块类型 pc))
        (取u n pc)
        (置 base (- sp (* (读4 S_块参) 8)))
        (置 e (读4 S_处理顶))
        (若 (>=u e (读4 S_处理栈限)) (陷阱退出 122 "处理器栈溢出"))
        (存4 e pc)
        (存4 (+ e 4) n)
        (存4 (+ e 8) (读4 S_帧顶))
        (存4 (+ e 12) base)
        (存4 (+ e 16) (读4 S_标签顶))
        (存4 (+ e 20) fp)
        (存4 (+ e 24) (读4 S_函))
        (存4 S_处理顶 (+ e 32))
        (置 i 0)
        (当 (< i n)
          (置 t (读1 pc))
          (置 pc (+ pc 1))
          (若 (< t 2) (弃 (读u32 pc)) (置 pc (读4 S_读址)))
          (弃 (读u32 pc))
          (置 pc (读4 S_读址))
          (置 i (+ i 1)))
        (置 e (+ sb (* oa 8)))
        (压标签 (读4 e) base (读4 S_块果) 3))
      (情形 (0x0C)
        (取u t pc)
        (置 sp (分支 t sp))
        (分支后))
      (情形 (0x0D)
        (取u t pc)
        (置 sp (- sp 8))
        (若 (读4 sp)
          (置 sp (分支 t sp))
          (分支后)))
      (情形 (0x0E)
        (取u n pc)
        (置 sp (- sp 8))
        (置 i (读4 sp))
        (置 e 0)
        (当 (<= e n)
          (取u t pc)
          (若 (|| (== e i) (== e n))
            (中断))
          (置 e (+ e 1)))
        ; 若 i 越过向量，取默认（最后一个）——上面循环在 e==n 时停在默认项
        (置 sp (分支 t sp))
        (分支后))
      (情形 (0x0F) (做返回))
      (情形 (0x10)
        (取u t pc)
        (置 sp (调用 t sp pc fp))
        (调用后))
      (情形 (0x11)
        (取u t pc)
        (取u i pc)
        (置 sp (- sp 8))
        (置 e (表函数 i (读4 sp)))
        (若 (! (函数类型等价 (读4 (函数条 e)) t)) (陷阱退出 124 "间接调用签名不符"))
        (置 sp (调用 e sp pc fp))
        (调用后))
      (情形 (0x12)
        (取u t pc)
        (置 sp (尾调用 t sp fp))
        (调用后)
        (若 (! pc) (做返回)))
      (情形 (0x13)
        (取u t pc)
        (取u i pc)
        (置 sp (- sp 8))
        (置 e (表函数 i (读4 sp)))
        (若 (! (函数类型等价 (读4 (函数条 e)) t)) (陷阱退出 124 "间接调用签名不符"))
        (置 sp (尾调用 e sp fp))
        (调用后)
        (若 (! pc) (做返回)))
      (情形 (0x14 0x15)
        (弃 (读u32 pc))
        (置 pc (读4 S_读址))
        (置 sp (- sp 8))
        (置 a (读4 sp))
        (若 (!= (& a 7) 2) (陷阱退出 124 "空函数引用"))
        (若否 (== op 0x14)
          ((置 sp (调用 (>>u a 3) sp pc fp)))
          ((置 sp (尾调用 (>>u a 3) sp fp))))
        (调用后)
        (若 (! pc) (做返回)))
      (情形 (0x1A) (置 sp (- sp 8)))
      (情形 (0x1B 0x1C)
        (若 (== op 0x1C) (取u n pc) (置 i 0) (当 (< i n) (弃 (值类别 pc)) (置 pc (读4 S_读址)) (置 i (+ i 1))))
        (置 sp (- sp 16))
        (若 (! (读4 (+ sp 8))) (拷槽内 (- sp 8) sp)))
      (情形 (0x20) (取u t pc) (拷槽内 sp (局址 t)) (置 sp (+ sp 8)))
      (情形 (0x21) (取u t pc) (置 sp (- sp 8)) (拷槽内 (局址 t) sp))
      (情形 (0x22) (取u t pc) (拷槽内 (局址 t) (- sp 8)))
      (情形 (0x23) (取u t pc) (拷槽内 sp (全局址 t)) (置 sp (+ sp 8)))
      (情形 (0x24) (取u t pc) (置 sp (- sp 8)) (拷槽内 (全局址 t) sp))
      (情形 (0x25)
        (取u t pc)
        (置 e (+ (读4 S_表描述) (* t 16)))
        (置 a (读4 (- sp 8)))
        (若 (>=u a (读4 (+ e 4))) (陷阱退出 124 "表索引越界"))
        (存4 (- sp 8) (读4 (+ (读4 e) (* a 4))))
        (存4 (- sp 4) 0))
      (情形 (0x26)
        (取u t pc)
        (置 e (+ (读4 S_表描述) (* t 16)))
        (置 sp (- sp 16))
        (置 a (读4 sp))
        (若 (>=u a (读4 (+ e 4))) (陷阱退出 124 "表索引越界"))
        (存4 (+ (读4 e) (* a 4)) (读4 (+ sp 8))))
      (情形 (0x3F) (置 pc (+ pc 1)) (存4 sp (读4 S_客页数)) (置 sp (+ sp 8)))
      (情形 (0x40)
        (置 pc (+ pc 1))
        (置 n (读4 (- sp 8)))
        (若否 (<=u (+ (读4 S_客页数) n) (读4 S_客页上限))
          ((存4 (- sp 8) (读4 S_客页数)) (存4 S_客页数 (+ (读4 S_客页数) n)))
          ((存4 (- sp 8) -1))))
      (情形 ((范围 0x28 0x3E))
        (置 sp (执行访存 op pc sp))
        (置 pc (读4 S_新pc)))
      (情形 (0x41) (取s t pc) (存4 sp t) (置 sp (+ sp 8)))
      (情形 (0x42)
        (置 t (读s64 pc))
        (置 pc (读4 S_读址))
        (存4 sp t)
        (存4 (+ sp 4) (读4 S_读高))
        (置 sp (+ sp 8)))
      (情形 (0x43) (存4 sp (读4 pc)) (置 pc (+ pc 4)) (置 sp (+ sp 8)))
      (情形 (0x44) (存4 sp (读4 pc)) (存4 (+ sp 4) (读4 (+ pc 4))) (置 pc (+ pc 8)) (置 sp (+ sp 8)))
      ; ---- i32 ----
      (情形 (0x45) (一元 (! (读4 (- sp 8)))))
      (情形 (0x46) (二元 (== (甲低) (乙低))))
      (情形 (0x47) (二元 (!= (甲低) (乙低))))
      (情形 (0x48) (二元 (< (甲低) (乙低))))
      (情形 (0x49) (二元 (<u (甲低) (乙低))))
      (情形 (0x4A) (二元 (> (甲低) (乙低))))
      (情形 (0x4B) (二元 (>u (甲低) (乙低))))
      (情形 (0x4C) (二元 (<= (甲低) (乙低))))
      (情形 (0x4D) (二元 (<=u (甲低) (乙低))))
      (情形 (0x4E) (二元 (>= (甲低) (乙低))))
      (情形 (0x4F) (二元 (>=u (甲低) (乙低))))
      (情形 (0x67) (一元 (前导零 (读4 (- sp 8)))))
      (情形 (0x68) (一元 (尾随零 (读4 (- sp 8)))))
      (情形 (0x69) (一元 (一计数 (读4 (- sp 8)))))
      (情形 (0x6A) (二元 (+ (甲低) (乙低))))
      (情形 (0x6B) (二元 (- (甲低) (乙低))))
      (情形 (0x6C) (二元 (* (甲低) (乙低))))
      (情形 (0x6D)
        (置 sp (- sp 8))
        (置 a (读4 (- sp 8))) (置 b (读4 sp))
        (若 (! b) (陷阱退出 125 "整数除零"))
        (若 (&& (== a 0x80000000) (== b -1)) (陷阱退出 125 "整数溢出"))
        (存4 (- sp 8) (/ a b)))
      (情形 (0x6E)
        (置 sp (- sp 8))
        (置 a (读4 (- sp 8))) (置 b (读4 sp))
        (若 (! b) (陷阱退出 125 "整数除零"))
        (存4 (- sp 8) (/u a b)))
      (情形 (0x6F)
        (置 sp (- sp 8))
        (置 a (读4 (- sp 8))) (置 b (读4 sp))
        (若 (! b) (陷阱退出 125 "整数除零"))
        (若否 (== b -1) ((存4 (- sp 8) 0)) ((存4 (- sp 8) (% a b)))))
      (情形 (0x70)
        (置 sp (- sp 8))
        (置 a (读4 (- sp 8))) (置 b (读4 sp))
        (若 (! b) (陷阱退出 125 "整数除零"))
        (存4 (- sp 8) (%u a b)))
      (情形 (0x71) (二元 (& (甲低) (乙低))))
      (情形 (0x72) (二元 (| (甲低) (乙低))))
      (情形 (0x73) (二元 (^ (甲低) (乙低))))
      (情形 (0x74) (二元 (<< (甲低) (乙低))))
      (情形 (0x75) (二元 (>> (甲低) (乙低))))
      (情形 (0x76) (二元 (>>u (甲低) (乙低))))
      (情形 (0x77) (二元 (rotl (甲低) (乙低))))
      (情形 (0x78) (二元 (rotr (甲低) (乙低))))
      (情形 (0xC0) (一元 (>> (<< (读4 (- sp 8)) 24) 24)))
      (情形 (0xC1) (一元 (>> (<< (读4 (- sp 8)) 16) 16)))
      (情形 (0xBC 0xBE))
      ; ---- i64 与浮点 ----
      (情形 ((范围 0x50 0x5A) (范围 0x79 0x8A) 0xA7 0xAC 0xAD 0xBD 0xBF 0xC2 0xC3 0xC4)
        (置 sp (执行i64 op sp)))
      (情形 ((范围 0x5B 0x66) (范围 0x8B 0xA6) (范围 0xA8 0xAB) (范围 0xAE 0xBB))
        (置 sp (执行浮点 op sp)))
      ; ---- 引用 ----
      (情形 (0xD0) (弃 (读s32 pc)) (置 pc (读4 S_读址)) (存4 sp 0) (存4 (+ sp 4) 0) (置 sp (+ sp 8)))
      (情形 (0xD1) (一元 (! (读4 (- sp 8)))))
      (情形 (0xD2) (取u t pc) (存4 sp (| (<< t 3) 2)) (存4 (+ sp 4) 0) (置 sp (+ sp 8)))
      (情形 (0xD3) (二元 (== (甲低) (乙低))))
      (情形 (0xD4) (若 (! (读4 (- sp 8))) (陷阱退出 129 "空引用")))
      (情形 (0xD5)
        (取u t pc)
        (若 (! (读4 (- sp 8)))
          (置 sp (- sp 8))
          (置 sp (分支 t sp))
          (分支后)))
      (情形 (0xD6)
        (取u t pc)
        (若否 (读4 (- sp 8))
          ((置 sp (分支 t sp))
           (分支后))
          ((置 sp (- sp 8)))))
      (情形 (0xFB)
        (取u t pc)
        (置 sp (执行GC t pc sp))
        (置 pc (读4 S_新pc))
        (若 (! pc) (做返回)))
      (情形 (0xFC)
        (取u t pc)
        (置 sp (执行杂项 t pc sp))
        (置 pc (读4 S_新pc)))
      (否则 (陷阱退出 130 "未知操作码"))))
  (返回 sp))
