; 客体执行器二号：异常处理（throw / throw_ref / try_table）
; 处理器栈项（32 字节）：+0 子句起点 +4 子句数 +8 帧顶 +12 值栈基 +16 标签顶（压 try 标签之前）+20 fp +24 当前函数
(常量 种类异常 4)

; 新建异常对象：[头][大小][标签 4][个数 4][载荷 n×8]；载荷取自 S_例外载荷
(函数 新异常对象 ()
  (局 n o i)
  (置 n (读4 S_例外数))
  (置 o (分配对象 (+ 16 (* n 8)) 种类异常 0))
  (存4 (+ o 8) (读4 S_例外标签))
  (存4 (+ o 12) n)
  (拷贝 (+ o 16) S_例外载荷 (* n 8))
  (返回 o))
; 展开：使用 S_例外标签、S_例外数、S_例外载荷，找到处理器后转移控制；返回新 sp
(函数 分发例外 (sp)
  (局 H p 子句数 i k 标签 tg 匹配 n 引 基)
  (置 n (读4 S_例外数))
  (置 H (读4 S_处理顶))
  (当 (>u H (读4 S_处理栈基))
    (置 H (- H 32))
    (置 p (读4 H))
    (置 子句数 (读4 (+ H 4)))
    (置 i 0)
    (当 (< i 子句数)
      (置 k (读1 p))
      (置 p (+ p 1))
      (置 匹配 0)
      (若否 (< k 2)
        ((取u tg p)
         (取u 标签 p)
         (若 (== tg (读4 S_例外标签)) (置 匹配 1)))
        ((取u 标签 p)
         (置 匹配 1)))
      (若 匹配
        (存4 S_处理顶 H)
        (存4 S_帧顶 (读4 (+ H 8)))
        (存4 S_函 (读4 (+ H 24)))
        (存4 S_标签顶 (读4 (+ H 16)))
        (置 基 (读4 (+ H 12)))
        (存4 S_新fp (读4 (+ H 20)))
        (若 (|| (== k 0) (== k 1))
          (拷贝 基 S_例外载荷 (* n 8))
          (置 基 (+ 基 (* n 8))))
        (若 (|| (== k 1) (== k 3))
          (置 引 (新异常对象))
          (存4 基 引)
          (存4 (+ 基 4) 0)
          (置 基 (+ 基 8)))
        (置 sp (分支 标签 基))
        (存4 S_边偏 (边偏 (读4 S_函)))
        (返回 sp))
      (置 i (+ i 1))))
  (陷阱退出 137 "未捕获的异常")
  (返回 sp))
; throw 标签：弹出参数作载荷
(函数 执行抛出 (tag sp)
  (局 n)
  (存4 S_sp sp)
  (置 n (读4 (+ (+ (读4 S_标签表) (* tag 8)) 4)))
  (若 (> n 例外载荷槽) (陷阱退出 137 "异常载荷过大"))
  (拷贝 S_例外载荷 (- sp (* n 8)) (* n 8))
  (置 sp (- sp (* n 8)))
  (存4 S_例外数 n)
  (存4 S_例外标签 tag)
  (返回 (分发例外 sp)))
; throw_ref：栈顶为异常引用
(函数 执行再抛 (sp)
  (局 引 n)
  (置 引 (读4 (- sp 8)))
  (空引用检 引)
  (置 sp (- sp 8))
  (存4 S_sp sp)
  (置 n (读4 (+ 引 12)))
  (存4 S_例外数 n)
  (存4 S_例外标签 (读4 (+ 引 8)))
  (拷贝 S_例外载荷 (+ 引 16) (* n 8))
  (返回 (分发例外 sp)))
