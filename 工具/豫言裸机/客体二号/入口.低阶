; 入口：解析模块、建立区域、按测试约定调用导出函数并打印结果
(常量 测试名 0x2400)       ; 要调用的导出名（零结尾；为空则用 _start）
(常量 测试参数数 0x2440)
(常量 测试参数 0x2444)     ; 至多 8 个 i32 参数
(常量 测试结果数 0x2470)

(函数 初始化区域 ()
  (局 n)
  (置 n (* 值栈槽数 8))
  (存4 S_值栈基 (取区域 n))
  (存4 S_值栈限 (+ (读4 S_值栈基) n))
  (置 n (* 标签栈项数 16))
  (存4 S_标签栈基 (取区域 n))
  (存4 S_标签栈限 (+ (读4 S_标签栈基) n))
  (存4 S_标签顶 (读4 S_标签栈基))
  (置 n (* 帧栈项数 32))
  (存4 S_帧栈基 (取区域 n))
  (存4 S_帧栈限 (+ (读4 S_帧栈基) n))
  (存4 S_帧顶 (读4 S_帧栈基))
  (置 n (* 处理栈项数 32))
  (存4 S_处理栈基 (取区域 n))
  (存4 S_处理栈限 (+ (读4 S_处理栈基) n))
  (存4 S_处理顶 (读4 S_处理栈基))
  (存4 S_行缓冲 (取区域 行缓冲大小))
  (置 n (* 标记栈项数 4))
  (存4 S_标记栈基 (取区域 n))
  (存4 S_标记栈限 (+ (读4 S_标记栈基) n))
  (存4 S_标记栈顶 (读4 S_标记栈基))
  ; 边表池：代码段每字节 8 字节
  (置 n (* (节长 10) 8))
  (存4 S_边表池 (取区域 n))
  (存4 S_边表尾 (+ (读4 S_边表池) n)))

; 全局初始化：按序求值常量表达式（可含 GC 构造）
(函数 初始化全局 ()
  (局 p n i 槽)
  (置 p (节起 6))
  (若 (! p) (返回))
  (取u n p)
  (置 i 0)
  (当 (< i n)
    (弃 (值类别 p))
    (置 p (读4 S_读址))
    (置 p (+ p 1))
    (置 槽 (+ (读4 S_全局表) (* i 8)))
    (置 p (求值常量式 p 槽))
    (置 i (+ i 1))))
; 表元素段初始化（主动段）
(函数 初始化元素 ()
  (局 i 条 标志 个数 p j 表 偏 描述 值)
  (置 i 0)
  (当 (< i (读4 S_元素段数))
    (置 条 (+ (读4 S_元素段表) (* i 24)))
    (置 标志 (读4 (+ 条 8)))
    (若 (|| (== 标志 0) (== 标志 2) (== 标志 4) (== 标志 6))
      (弃 (求值常量式 (读4 (+ 条 16)) S_临时))
      (置 偏 (读4 S_临时))
      (置 描述 (+ (读4 S_表描述) (* (读4 (+ 条 20)) 16)))
      (置 个数 (读4 (+ 条 4)))
      (若 (|| (>u (+ 偏 个数) (读4 (+ 描述 4))) (<u (+ 偏 个数) 偏)) (陷阱退出 124 "元素段越界"))
      (置 p (读4 条))
      (置 j 0)
      (当 (< j 个数)
        (若否 (< 标志 4)
          ((取u 值 p)
           (存4 (+ (读4 描述) (* (+ 偏 j) 4)) (| (<< 值 3) 2)))
          ((置 p (求值常量式 p S_临时))
           (存4 (+ (读4 描述) (* (+ 偏 j) 4)) (读4 S_临时))))
        (置 j (+ j 1)))
      (存4 (+ 条 12) 1))
    (置 i (+ i 1))))
; 数据段初始化（主动段写入客体线性内存）
(函数 初始化数据 ()
  (局 i 条 偏)
  (置 i 0)
  (当 (< i (读4 S_数据段数))
    (置 条 (+ (读4 S_数据段表) (* i 20)))
    (若 (! (读4 (+ 条 8)))
      (弃 (求值常量式 (读4 (+ 条 16)) S_临时))
      (置 偏 (读4 S_临时))
      (若 (|| (>u (+ 偏 (读4 (+ 条 4))) (客内存字节)) (<u (+ 偏 (读4 (+ 条 4))) 偏)) (陷阱退出 127 "数据段越界"))
      (拷贝 (+ (读4 S_客内存) 偏) (读4 条) (读4 (+ 条 4)))
      (存4 (+ 条 12) 1))
    (置 i (+ i 1))))

(函数 启动 ()
  (局 f sp 条 i n)
  (存4 S_区域顶 区域起)
  (存4 S_页数 (内存页数))
  (存4 S_页上限 512)
  (读节)
  (存4 S_元数据池 (取区域 (+ (节长 1) 64)))
  (存4 S_元数据顶 (读4 S_元数据池))
  (解析类型段)
  (建函数表)
  (解析导入段)
  (解析函数段)
  (解析代码段)
  (解析全局段)
  (解析表段)
  (解析标签段)
  (解析元素段)
  (解析数据段)
  (解析内存段)
  (解析起始)
  (类型表调试)
  (初始化区域)
  (初始化堆)
  (初始化全局)
  (发现宿主类型)
  (初始化元素)
  (初始化数据)
  (置 f (查导出 (选 (读1 测试名) 测试名 串_启动)))
  (若 (< f 0) (陷阱退出 134 "找不到导出函数"))
  (置 sp (读4 S_值栈基))
  (置 n (读4 测试参数数))
  (置 i 0)
  (当 (< i n)
    (存4 sp (读4 (+ 测试参数 (* i 4))))
    (存4 (+ sp 4) 0)
    (置 sp (+ sp 8))
    (置 i (+ i 1)))
  (置 sp (运行函数 f sp))
  (置 条 (函数条 f))
  (置 n (读4 (+ 条 16)))
  (置 i 0)
  (当 (< i n)
    (打印数 (读4 (- (+ sp (* i 8)) (* n 8))))
    (写字节 10)
    (置 i (+ i 1))))
(导出 "启动" 启动)
(内存 8 512)
