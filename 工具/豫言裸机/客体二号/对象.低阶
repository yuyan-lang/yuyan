; 客体执行器二号：GC 指令（0xFB 前缀）与常量表达式求值

; ---- 元素与字段访问 ----
; 元素类别：0 四字节数值 1 八字节数值 2 引用 3 字节 4 半字
(函数 载入元素 (a c 有符 d)
  (分派 c
    (情形 (0 2) (存4 d (读4 a)) (存4 (+ d 4) 0))
    (情形 (1) (存4 d (读4 a)) (存4 (+ d 4) (读4 (+ a 4))))
    (情形 (3) (存4 d (选 有符 (读1有 a) (读1 a))) (存4 (+ d 4) 0))
    (情形 (4) (存4 d (选 有符 (读2有 a) (读2 a))) (存4 (+ d 4) 0))
    (否则)))
(函数 存入元素 (a c d)
  (分派 c
    (情形 (0 2) (存4 a (读4 d)))
    (情形 (1) (存4 a (读4 d)) (存4 (+ a 4) (读4 (+ d 4))))
    (情形 (3) (存1 a (读4 d)))
    (情形 (4) (存2 a (读4 d)))
    (否则)))
; 结构字段：统一 8 字节槽；压缩字段只用低字（存入时截断）
(函数 存入字段 (a c d)
  (分派 c
    (情形 (3) (存4 a (& (读4 d) 255)) (存4 (+ a 4) 0))
    (情形 (4) (存4 a (& (读4 d) 65535)) (存4 (+ a 4) 0))
    (否则 (存4 a (读4 d)) (存4 (+ a 4) (读4 (+ d 4))))))

; ---- 类型关系 ----
(函数 是子类型 (t ht)
  (当 (>= t 0)
    (若 (== t ht) (返回 1))
    (置 t (读4 (+ (类型条 t) 12))))
  (返回 0))
; 引用 w 是否属于堆类型 ht（s33）；可空 表示 null 是否通过
(函数 引用属于 (w ht 可空)
  (局 头 种 t)
  (若 (! w) (返回 可空))
  (若 (>= ht 0)
    (若 (== (& w 7) 2) (返回 (函数类型等价 (读4 (函数条 (>>u w 3))) ht)))
    (若 (& w 1) (返回 0))
    (置 头 (读4 w))
    (返回 (是子类型 (& 头 0xFFFFFF) ht)))
  (分派 ht
    (情形 (-18) (返回 (!= (& w 7) 2)))      ; any：不含函数引用
    (情形 (-19) (返回 (|| (& w 1) (== (& w 7) 0))))    ; eq：i31 与对象
    (情形 (-20) (返回 (& w 1)))             ; i31
    (情形 (-21)                             ; struct
      (若 (|| (& w 1) (!= (& w 7) 0)) (返回 0))
      (返回 (== (& (>>u (读4 w) 24) 7) 种类结构)))
    (情形 (-22)                             ; array
      (若 (|| (& w 1) (!= (& w 7) 0)) (返回 0))
      (返回 (== (& (>>u (读4 w) 24) 7) 种类数组)))
    (情形 (-16) (返回 (== (& w 7) 2)))      ; func
    (情形 (-17) (返回 1))                   ; extern
    (否则 (返回 0)))
  (返回 0))

(函数 空引用检 (a)
  (若 (! a) (陷阱退出 129 "空引用")))

; ---- 指令 ----
; 子：GC 子操作码；pc 指向立即数；sp 为栈顶；返回新 sp；新 pc 存 S_新pc
(函数 执行GC (子 pc sp)
  (局 t f 长 o 数 a b c d w i 描述 段 条 字节 s2 t2 ht 标志 层 h1 h2 ok 起 基)
  (存4 S_sp sp)
  (分派 子
    (情形 (0)    ; struct.new
      (取u t pc)
      (存4 S_新pc pc)
      (置 数 (读4 (+ (类型条 t) 4)))
      (置 o (分配对象 (结构字节 t) 种类结构 t))
      (置 基 (- sp (* 数 8)))
      (置 描述 (读4 (+ (类型条 t) 16)))
      (置 i 0)
      (当 (< i 数)
        (存入字段 (+ (+ o 8) (* i 8)) (读1 (+ 描述 i)) (+ 基 (* i 8)))
        (置 i (+ i 1)))
      (存4 基 o)
      (存4 (+ 基 4) 0)
      (返回 (+ 基 8)))
    (情形 (1)    ; struct.new_default
      (取u t pc)
      (存4 S_新pc pc)
      (置 o (分配对象 (结构字节 t) 种类结构 t))
      (存4 sp o)
      (存4 (+ sp 4) 0)
      (返回 (+ sp 8)))
    (情形 (2 3 4)    ; struct.get / get_s / get_u
      (取u t pc)
      (取u f pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 8)))
      (空引用检 a)
      (置 c (读1 (+ (读4 (+ (类型条 t) 16)) f)))
      (置 w (+ (+ a 8) (* f 8)))
      (若否 (>= c 3)
        ((若否 (== 子 3)
           ((存4 (- sp 8) (选 (== c 3) (>> (<< (读4 w) 24) 24) (>> (<< (读4 w) 16) 16))))
           ((存4 (- sp 8) (选 (== c 3) (& (读4 w) 255) (& (读4 w) 65535)))))
         (存4 (- sp 4) 0))
        ((拷槽 (- sp 8) w)))
      (返回 sp))
    (情形 (5)    ; struct.set
      (取u t pc)
      (取u f pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 16)))
      (空引用检 a)
      (置 c (读1 (+ (读4 (+ (类型条 t) 16)) f)))
      (存入字段 (+ (+ a 8) (* f 8)) c (- sp 8))
      (返回 (- sp 16)))
    (情形 (6 7)    ; array.new / array.new_default
      (取u t pc)
      (存4 S_新pc pc)
      (置 长 (读4 (- sp 8)))
      (置 c (读4 (+ (类型条 t) 4)))
      (置 d (读4 (+ (类型条 t) 8)))
      (置 o (分配对象 (数组字节 t 长) 种类数组 t))
      (存4 (+ o 8) 长)
      (若否 (== 子 6)
        ((置 b (- sp 16))
         (置 i 0)
         (若否 (&& (== c 3) (> 长 0))
           ((内存填充 (+ o 16) (读4 b) 长))
           ((当 (< i 长)
              (存入元素 (+ (+ o 16) (* i d)) c b)
              (置 i (+ i 1)))))
         (存4 b o)
         (存4 (+ b 4) 0)
         (返回 (- sp 8)))
        ((存4 (- sp 8) o)
         (存4 (- sp 4) 0)
         (返回 sp))))
    (情形 (8)    ; array.new_fixed t N
      (取u t pc)
      (取u 数 pc)
      (存4 S_新pc pc)
      (置 c (读4 (+ (类型条 t) 4)))
      (置 d (读4 (+ (类型条 t) 8)))
      (置 o (分配对象 (数组字节 t 数) 种类数组 t))
      (存4 (+ o 8) 数)
      (置 基 (- sp (* 数 8)))
      (置 i 0)
      (当 (< i 数)
        (存入元素 (+ (+ o 16) (* i d)) c (+ 基 (* i 8)))
        (置 i (+ i 1)))
      (存4 基 o)
      (存4 (+ 基 4) 0)
      (返回 (+ 基 8)))
    (情形 (9)    ; array.new_data t d
      (取u t pc)
      (取u 段 pc)
      (存4 S_新pc pc)
      (置 起 (读4 (- sp 16)))
      (置 长 (读4 (- sp 8)))
      (置 d (读4 (+ (类型条 t) 8)))
      (置 条 (+ (读4 S_数据段表) (* 段 20)))
      (置 字节 (* 长 d))
      (若 (|| (>u (+ 起 字节) (选 (读4 (+ 条 12)) 0 (读4 (+ 条 4)))) (|| (<u (+ 起 字节) 起) (>u 长 (/u 0x10000000 (选 (> d 0) d 1)))))
        (陷阱退出 127 "array.new_data 越界"))
      (置 o (分配对象 (数组字节 t 长) 种类数组 t))
      (存4 (+ o 8) 长)
      (拷贝 (+ o 16) (+ (读4 条) 起) 字节)
      (置 基 (- sp 16))
      (存4 基 o)
      (存4 (+ 基 4) 0)
      (返回 (- sp 8)))
    (情形 (11 12 13)    ; array.get / get_s / get_u
      (取u t pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 16)))
      (置 i (读4 (- sp 8)))
      (空引用检 a)
      (若 (>=u i (读4 (+ a 8))) (陷阱退出 127 "数组索引越界"))
      (置 c (读4 (+ (类型条 t) 4)))
      (置 d (读4 (+ (类型条 t) 8)))
      (载入元素 (+ (+ a 16) (* i d)) c (== 子 12) (- sp 16))
      (返回 (- sp 8)))
    (情形 (14)    ; array.set
      (取u t pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 24)))
      (置 i (读4 (- sp 16)))
      (空引用检 a)
      (若 (>=u i (读4 (+ a 8))) (陷阱退出 127 "数组索引越界"))
      (置 c (读4 (+ (类型条 t) 4)))
      (置 d (读4 (+ (类型条 t) 8)))
      (存入元素 (+ (+ a 16) (* i d)) c (- sp 8))
      (返回 (- sp 24)))
    (情形 (15)    ; array.len
      (存4 S_新pc pc)
      (置 a (读4 (- sp 8)))
      (空引用检 a)
      (存4 (- sp 8) (读4 (+ a 8)))
      (返回 sp))
    (情形 (16)    ; array.fill t：[ref][off][val][n]
      (取u t pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 32)))
      (置 起 (读4 (- sp 24)))
      (置 长 (读4 (- sp 8)))
      (空引用检 a)
      (若 (|| (>u (+ 起 长) (读4 (+ a 8))) (<u (+ 起 长) 起)) (陷阱退出 127 "array.fill 越界"))
      (置 c (读4 (+ (类型条 t) 4)))
      (置 d (读4 (+ (类型条 t) 8)))
      (置 i 0)
      (当 (< i 长)
        (存入元素 (+ (+ a 16) (* (+ 起 i) d)) c (- sp 16))
        (置 i (+ i 1)))
      (返回 (- sp 32)))
    (情形 (17)    ; array.copy t1 t2：[dst][dsto][src][srco][n]
      (取u t pc)
      (取u t2 pc)
      (存4 S_新pc pc)
      (置 a (读4 (- sp 40)))
      (置 起 (读4 (- sp 32)))
      (置 b (读4 (- sp 24)))
      (置 s2 (读4 (- sp 16)))
      (置 长 (读4 (- sp 8)))
      (空引用检 a)
      (空引用检 b)
      (若 (|| (|| (>u (+ 起 长) (读4 (+ a 8))) (<u (+ 起 长) 起)) (|| (>u (+ s2 长) (读4 (+ b 8))) (<u (+ s2 长) s2))) (陷阱退出 127 "array.copy 越界"))
      (置 d (读4 (+ (类型条 t) 8)))
      (拷贝 (+ (+ a 16) (* 起 d)) (+ (+ b 16) (* s2 d)) (* 长 d))
      (返回 (- sp 40)))
    (情形 (20 21 22 23)    ; ref.test / ref.cast
      (置 ht (读s32 pc))
      (置 pc (读4 S_读址))
      (存4 S_新pc pc)
      (置 w (读4 (- sp 8)))
      (置 ok (引用属于 w ht (& 子 1)))
      (若否 (< 子 22)
        ((存4 (- sp 8) ok) (存4 (- sp 4) 0))
        ((若 (! ok) (转换失败 w ht))))
      (返回 sp))
    (情形 (24 25)    ; br_on_cast / br_on_cast_fail：标志 层 类型1 类型2
      (置 标志 (读1 pc))
      (置 pc (+ pc 1))
      (取u 层 pc)
      (置 h1 (读s32 pc))
      (置 pc (读4 S_读址))
      (置 h2 (读s32 pc))
      (置 pc (读4 S_读址))
      (存4 S_新pc pc)
      (置 w (读4 (- sp 8)))
      (置 ok (引用属于 w h2 (& (>>u 标志 1) 1)))
      (若 (== ok (== 子 24))
        (置 sp (分支 层 sp)))
      (返回 sp))
    (情形 (26 27) (存4 S_新pc pc) (返回 sp))
    (情形 (28)    ; ref.i31
      (存4 S_新pc pc)
      (存4 (- sp 8) (| (<< (读4 (- sp 8)) 1) 1))
      (返回 sp))
    (情形 (29)    ; i31.get_s
      (存4 S_新pc pc)
      (置 w (读4 (- sp 8)))
      (空引用检 w)
      (存4 (- sp 8) (>> w 1))
      (返回 sp))
    (情形 (30)    ; i31.get_u
      (存4 S_新pc pc)
      (置 w (读4 (- sp 8)))
      (空引用检 w)
      (存4 (- sp 8) (>>u w 1))
      (返回 sp))
    (否则 (陷阱退出 131 "不支持的 GC 指令")))
  (返回 sp))

; ---- 常量表达式求值：结果写入 目标槽，返回 end 之后的位置 ----
(函数 求值常量式 (p 目标)
  (局 sp op 子 v)
  (置 sp (读4 S_值栈基))
  (当 1
    (置 op (读1 p))
    (置 p (+ p 1))
    (分派 op
      (情形 (0x0B)
        (拷槽 目标 (- sp 8))
        (返回 p))
      (情形 (0x41) (取s v p) (存4 sp v) (存4 (+ sp 4) 0) (置 sp (+ sp 8)))
      (情形 (0x42) (置 v (读s64 p)) (置 p (读4 S_读址)) (存4 sp v) (存4 (+ sp 4) (读4 S_读高)) (置 sp (+ sp 8)))
      (情形 (0x43) (存4 sp (读4 p)) (存4 (+ sp 4) 0) (置 p (+ p 4)) (置 sp (+ sp 8)))
      (情形 (0x44) (存4 sp (读4 p)) (存4 (+ sp 4) (读4 (+ p 4))) (置 p (+ p 8)) (置 sp (+ sp 8)))
      (情形 (0xD0) (弃 (读s32 p)) (置 p (读4 S_读址)) (存4 sp 0) (存4 (+ sp 4) 0) (置 sp (+ sp 8)))
      (情形 (0xD2) (取u v p) (存4 sp (| (<< v 3) 2)) (存4 (+ sp 4) 0) (置 sp (+ sp 8)))
      (情形 (0x23) (取u v p) (拷槽 sp (+ (读4 S_全局表) (* v 8))) (置 sp (+ sp 8)))
      (情形 (0x6A) (置 sp (- sp 8)) (存4 (- sp 8) (+ (读4 (- sp 8)) (读4 sp))))
      (情形 (0x6B) (置 sp (- sp 8)) (存4 (- sp 8) (- (读4 (- sp 8)) (读4 sp))))
      (情形 (0x6C) (置 sp (- sp 8)) (存4 (- sp 8) (* (读4 (- sp 8)) (读4 sp))))
      (情形 (0x7C) (加64 (- sp 16) (- sp 16) (- sp 8)) (置 sp (- sp 8)))
      (情形 (0x7D) (减64 (- sp 16) (- sp 16) (- sp 8)) (置 sp (- sp 8)))
      (情形 (0x7E) (乘64 (- sp 16) (- sp 16) (- sp 8)) (置 sp (- sp 8)))
      (情形 (0xFB)
        (取u 子 p)
        (置 sp (执行GC 子 p sp))
        (置 p (读4 S_新pc)))
      (否则 (陷阱退出 133 "不支持的常量表达式指令")))))
