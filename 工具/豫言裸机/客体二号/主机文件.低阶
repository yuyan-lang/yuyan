; 客体执行器二号：文件相关宿主原语（名字与语义对齐标准库 文件系统 的原语；路径先规范化为绝对路径）

; 规范化：合并相对路径与当前目录，处理 . 与 ..、重复斜线；输出到 出（至少 2048 字节），返回长度，失败 -1
(函数 规范路径 (址 长 出)
  (局 输出长 i 段起 c)
  (若否 (&& (> 长 0) (== (读1 址) 47))
    ((置 输出长 0))
    ((置 输出长 (读4 S_FS_当前长))
     (拷贝 出 (读4 S_FS_当前目录) 输出长)
     (若 (== 输出长 1) (置 输出长 0))))
  (置 i 0)
  (当 (< i 长)
    (当 (&& (< i 长) (== (读1 (+ 址 i)) 47)) (置 i (+ i 1)))
    (置 段起 i)
    (当 (&& (< i 长) (!= (读1 (+ 址 i)) 47)) (置 i (+ i 1)))
    (置 c (- i 段起))
    (若 (> c 0)
      (若否 (&& (== c 1) (== (读1 (+ 址 段起)) 46))
        ()
        ((若否 (&& (== c 2) (&& (== (读1 (+ 址 段起)) 46) (== (读1 (+ 址 (+ 段起 1))) 46)))
           ((当 (&& (> 输出长 0) (!= (读1 (+ 出 (- 输出长 1))) 47)) (置 输出长 (- 输出长 1)))
            (若 (> 输出长 0) (置 输出长 (- 输出长 1))))
           ((若 (> (+ (+ 输出长 1) c) 路径上限) (返回 -1))
            (存1 (+ 出 输出长) 47)
            (拷贝 (+ 出 (+ 输出长 1)) (+ 址 段起) c)
            (置 输出长 (+ (+ 输出长 1) c))))))))
  (若 (== 输出长 0) (存1 出 47) (置 输出长 1))
  (返回 输出长))
(函数 规范参数 (引用 出)
  (空引用检 引用)
  (返回 (规范路径 (+ 引用 16) (字节数组长 引用) 出)))
; 创建路径的全部缺失祖先目录（不含路径自身）；成功返回 0
(函数 建祖先 (址 长)
  (局 i 果)
  (置 i 1)
  (当 (< i 长)
    (若 (== (读1 (+ 址 i)) 47)
      (若 (< (索引查 址 i) 0)
        (置 果 (fs建目录 址 i))
        (若 果 (返回 果))))
    (置 i (+ i 1)))
  (返回 0))
(函数 当前目录对象 ()
  (局 o)
  (置 o (新字节数组 (读4 S_FS_当前长)))
  (拷贝 (+ o 16) (读4 S_FS_当前目录) (读4 S_FS_当前长))
  (返回 o))
; 目录的子项数
(函数 子项数 (址 长)
  (局 i n e pa pl 数)
  (置 n (读4 S_FS_条目数))
  (置 i 1)
  (当 (< i n)
    (置 e (条 i))
    (置 pa (读4 e))
    (置 pl (读4 (+ e 4)))
    (若 (&& (!= (读4 (+ e 8)) 0) (&& (> pl 长) (&& (== (父长 pa pl) 长) (相同字节 pa 址 长))))
      (置 数 (+ 数 1)))
    (置 i (+ i 1)))
  (返回 数))
(函数 列目录对象 (址 长)
  (局 i n e pa pl 数 外 内 名起 名 k)
  (置 数 (子项数 址 长))
  (置 内 (新元组 (+ 数 2)))
  (置 名 (新字节数组 1))
  (存1 (+ 名 16) 46)
  (设元组项 内 0 名)
  (置 名 (新字节数组 2))
  (存1 (+ 名 16) 46)
  (存1 (+ 名 17) 46)
  (设元组项 内 1 名)
  (置 n (读4 S_FS_条目数))
  (置 i 1)
  (置 k 2)
  (当 (< i n)
    (置 e (条 i))
    (置 pa (读4 e))
    (置 pl (读4 (+ e 4)))
    (若 (&& (!= (读4 (+ e 8)) 0) (&& (> pl 长) (&& (== (父长 pa pl) 长) (相同字节 pa 址 长))))
      (置 名起 (选 (== 长 1) 1 (+ 长 1)))
      (置 名 (新字节数组 (- pl 名起)))
      (拷贝 (+ 名 16) (+ pa 名起) (- pl 名起))
      (设元组项 内 k 名)
      (置 k (+ k 1)))
    (置 i (+ i 1)))
  (置 外 (新元组 2))
  (设元组项 外 0 内)
  (设元组项 外 1 (装箱整 (+ 数 2)))
  (返回 外))

(函数 宿主文件调用 (号 参)
  (局 a b 出 长 项 e 果 r o)
  (置 出 (读4 S_FS_路径缓))
  (置 r 0)
  (分派 号
    (情形 (原_路径存在 原_路径是文件夹 原_路径是普通文件)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 项 -1)
      (若 (>= 长 0) (置 项 (索引查 出 长)))
      (置 果 0)
      (若 (>= 项 0)
        (置 e (读4 (+ (条 项) 8)))
        (若否 (== 号 原_路径存在) ((置 果 1))
          ((若否 (== 号 原_路径是文件夹) ((置 果 (== e 2))) ((置 果 (== e 1)))))))
      (置 r (装箱整 果)))
    (情形 (原_同步读取文件 原_同步读取文件字节串)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 项 -1)
      (若 (>= 长 0) (置 项 (索引查 出 长)))
      (若否 (&& (>= 项 0) (== (读4 (+ (条 项) 8)) 1))
        ((置 长 (读4 (+ (条 项) 16)))
         (置 o (新字节数组 长))
         (置 果 (fs读文件 项 (+ o 16)))
         (存4 S_FS_错误码 果)
         (置 r o))
        ((存4 S_FS_错误码 错_不存在)
         (置 r (新字节数组 0)))))
    (情形 (原_同步写入文件 原_同步写入文件字节串)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 b (元组项 参 1))
      (空引用检 b)
      (置 果 错_参数)
      (若 (>= 长 0)
        (置 果 (建祖先 出 长))
        (若 (! 果) (置 果 (fs写文件 出 长 (+ b 16) (字节数组长 b)))))
      (存4 S_FS_错误码 果))
    (情形 (原_同步删除文件)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 果 错_参数)
      (若 (>= 长 0) (置 果 (fs删除 出 长)))
      (存4 S_FS_错误码 果))
    (情形 (原_同步创建文件夹)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 果 错_参数)
      (若 (>= 长 0)
        (置 果 (建祖先 出 长))
        (若 (! 果) (若否 (>= (索引查 出 长) 0) ((置 果 0)) ((置 果 (fs建目录 出 长))))))
      (存4 S_FS_错误码 果)
      (置 r (装箱整 果)))
    (情形 (原_同步列出文件夹)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 项 -1)
      (若 (>= 长 0) (置 项 (索引查 出 长)))
      (若否 (&& (>= 项 0) (== (读4 (+ (条 项) 8)) 2))
        ((置 r (列目录对象 出 长)))
        ((存4 S_FS_错误码 错_不存在)
         (置 o (新元组 0))
         (置 r (新元组 2))
         (设元组项 r 0 o)
         (设元组项 r 1 (装箱整 0)))))
    (情形 (原_获取文件修改时间) (置 r (装箱整 0)))
    (情形 (原_切换当前工作目录)
      (置 长 (规范参数 (元组项 参 0) 出))
      (置 果 错_参数)
      (若 (>= 长 0)
        (置 项 (索引查 出 长))
        (若否 (< 项 0) ((置 果 错_不存在))
          ((若否 (!= (读4 (+ (条 项) 8)) 2) ((置 果 错_类型))
             ((拷贝 (读4 S_FS_当前目录) 出 长)
              (存4 S_FS_当前长 长)
              (置 果 0))))))
      (置 r (新元组 2))
      (设元组项 r 0 (装箱整 果))
      (设元组项 r 1 (新字节数组 0)))
    (情形 (原_文件系统格式化)
      (置 果 (文件系统格式化))
      (存4 S_FS_错误码 果)
      (置 r (装箱整 果)))
    (情形 (原_文件系统挂载)
      (置 果 (文件系统挂载))
      (存4 S_FS_错误码 果)
      (置 r (装箱整 果)))
    (情形 (原_文件系统错误码) (置 r (装箱整 (读4 S_FS_错误码))))
    (否则
      (打印零串 "未实现的宿主文件原语")
      (写字节 10)
      (退出任务 136)))
  (文件系统调试 号 (读4 S_FS_错误码))
  (返回 r))
