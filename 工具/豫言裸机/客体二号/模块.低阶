; ---- 表格布局 ----
; 类型条目（32 字节）：+0 种类(1函数 2结构 3数组) +4 甲 +8 乙 +12 超类 +16 编码起 +20 结果编码起 +24 编码止 +28 终类
; 函数条目（32 字节）：+0 类型 +4 代码起 +8 代码止 +12 参数数 +16 结果数 +20 局部总数 +24 边表 +28 标志(1=导入，导入号在高位)
(常量 类型条长 32)
(常量 函数条长 32)

(函数 相同字节 (p q n)
  (局 i)
  (当 (< i n)
    (若 (!= (读1 (+ p i)) (读1 (+ q i))) (返回 0))
    (置 i (+ i 1)))
  (返回 1))
(函数 零串长 (p)
  (局 n)
  (当 (读1 (+ p n)) (置 n (+ n 1)))
  (返回 n))
(函数 名相同 (p n s)   ; 模块内字节 (p,n) 与零结尾串 s 是否相同
  (若 (!= n (零串长 s)) (返回 0))
  (返回 (相同字节 p s n)))

(函数 读节 ()
  (局 p 末 id 长)
  (置 p (+ 模块基 8))
  (置 末 (+ 模块基 (读4 S_模块长)))
  (当 (<u p 末)
    (置 id (读1 p))
    (置 p (+ p 1))
    (取u 长 p)
    (若 (<u id 14)
      (存4 (+ S_节表 (* id 8)) p)
      (存4 (+ S_节表 (+ (* id 8) 4)) 长))
    (置 p (+ p 长))))
(宏 节起 (id) (读4 (+ S_节表 (* id 8))))
(宏 节长 (id) (读4 (+ S_节表 (+ (* id 8) 4))))

; 值类型类别：0=四字节数值 1=八字节数值 2=引用；新位置在 S_读址
(函数 值类别 (p)
  (局 b)
  (置 b (读1 p))
  (若 (|| (== b 0x63) (== b 0x64))
    (弃 (读s32 (+ p 1)))
    (返回 2))
  (存4 S_读址 (+ p 1))
  (若 (|| (== b 0x7E) (== b 0x7C)) (返回 1))
  (若 (== b 0x7B) (返回 1))
  (若 (|| (== b 0x7F) (== b 0x7D)) (返回 0))
  (返回 2))
; 字段存储类别：0 四字节 1 八字节 2 引用 3 字节 4 半字
(函数 存储类别 (p)
  (局 b)
  (置 b (读1 p))
  (若 (== b 0x78) (存4 S_读址 (+ p 1)) (返回 3))
  (若 (== b 0x77) (存4 S_读址 (+ p 1)) (返回 4))
  (返回 (值类别 p)))

(函数 解析复合类型 (p e)
  (局 k n i c)
  (置 k (读1 p))
  (置 p (+ p 1))
  (若否 (== k 0x60)
    ((存4 e 1)
     (取u n p)
     (存4 (+ e 4) n)
     (存4 (+ e 16) p)
     (置 i 0)
     (当 (< i n) (弃 (值类别 p)) (置 p (读4 S_读址)) (置 i (+ i 1)))
     (取u c p)
     (存4 (+ e 8) c)
     (存4 (+ e 20) p)
     (置 i 0)
     (当 (< i c) (弃 (值类别 p)) (置 p (读4 S_读址)) (置 i (+ i 1)))
     (存4 (+ e 24) p))
    ((若否 (== k 0x5F)
       ((存4 e 2)
        (取u n p)
        (存4 (+ e 4) n)
        (存4 (+ e 8) n)
        (存4 (+ e 16) (读4 S_元数据顶))
        (置 i 0)
        (当 (< i n)
          (置 c (存储类别 p))
          (置 p (读4 S_读址))
          (置 p (+ p 1))
          (存1 (读4 S_元数据顶) c)
          (存4 S_元数据顶 (+ (读4 S_元数据顶) 1))
          (置 i (+ i 1))))
       ((若 (!= k 0x5E) (陷阱退出 121 "未知复合类型"))
        (存4 e 3)
        (置 c (存储类别 p))
        (置 p (读4 S_读址))
        (置 p (+ p 1))
        (存4 (+ e 4) c)
        (存4 (+ e 8) (选 (== c 0) 4 (选 (== c 1) 8 (选 (== c 2) 4 (选 (== c 3) 1 2)))))))))
  (返回 p))
(函数 解析子类型 (p e)
  (局 b n i t)
  (存4 (+ e 12) -1)
  (存4 (+ e 28) 1)
  (置 b (读1 p))
  (若 (|| (== b 0x50) (== b 0x4F))
    (置 p (+ p 1))
    (存4 (+ e 28) (== b 0x4F))
    (取u n p)
    (置 i 0)
    (当 (< i n)
      (取u t p)
      (若 (== i 0) (存4 (+ e 12) t))
      (置 i (+ i 1))))
  (返回 (解析复合类型 p e)))
(函数 解析类型段 ()
  (局 p n i k 表 j b)
  (置 p (节起 1))
  (若 (! p) (返回))
  (取u n p)
  (置 表 (取区域 (* (节长 1) 32)))
  (存4 S_类型表 表)
  (置 i 0)
  (当 (< i n)
    (置 b (读1 p))
    (若否 (== b 0x4E)
      ((置 p (+ p 1))
       (取u j p)
       (当 j
         (置 p (解析子类型 p (+ 表 (* k 32))))
         (置 k (+ k 1))
         (置 j (- j 1))))
      ((置 p (解析子类型 p (+ 表 (* k 32))))
       (置 k (+ k 1))))
    (置 i (+ i 1)))
  (存4 S_类型数 k))
(宏 类型条 (t) (+ (读4 S_类型表) (* t 32)))
(宏 函数条 (f) (+ (读4 S_函数表) (* f 32)))

; 函数类型是否等价（结构比较参数与结果编码）
(函数 函数类型等价 (甲 乙)
  (局 a b)
  (若 (== 甲 乙) (返回 1))
  (置 a (类型条 甲))
  (置 b (类型条 乙))
  (若 (|| (!= (读4 a) 1) (!= (读4 b) 1)) (返回 0))
  (若 (!= (读4 (+ a 4)) (读4 (+ b 4))) (返回 0))
  (若 (!= (读4 (+ a 8)) (读4 (+ b 8))) (返回 0))
  (若 (!= (- (读4 (+ a 24)) (读4 (+ a 16))) (- (读4 (+ b 24)) (读4 (+ b 16)))) (返回 0))
  (返回 (相同字节 (读4 (+ a 16)) (读4 (+ b 16)) (- (读4 (+ a 24)) (读4 (+ a 16))))))

; 节内向量元素个数，节不存在为 0
(函数 读计数 (id)
  (局 p n)
  (置 p (节起 id))
  (若 (! p) (返回 0))
  (取u n p)
  (返回 n))
(函数 建函数表 ()
  (局 导 定)
  (置 导 (读计数 2))
  (置 定 (读计数 3))
  (存4 S_导入数 导)
  (存4 S_函数数 (+ 导 定))
  (存4 S_函数表 (取区域 (* (+ (+ 导 定) 1) 32))))
; 导入：只支持函数；宿主函数号 1 = gc-host.call
(函数 解析导入段 ()
  (局 p n i 名长 宿长 宿址 名址 种 类型 条)
  (置 p (节起 2))
  (若 (! p) (返回))
  (取u n p)
  (置 i 0)
  (当 (< i n)
    (取u 宿长 p) (置 宿址 p) (置 p (+ p 宿长))
    (取u 名长 p) (置 名址 p) (置 p (+ p 名长))
    (置 种 (读1 p)) (置 p (+ p 1))
    (若 (!= 种 0) (陷阱退出 121 "只支持函数导入"))
    (取u 类型 p)
    (置 条 (函数条 i))
    (存4 条 类型)
    (存4 (+ 条 12) (读4 (+ (类型条 类型) 4)))
    (存4 (+ 条 16) (读4 (+ (类型条 类型) 8)))
    (存4 (+ 条 20) (读4 (+ (类型条 类型) 4)))
    (存4 (+ 条 28) (| 1 (<< (选 (&& (名相同 宿址 宿长 串_导入宿) (名相同 名址 名长 串_导入名)) 1 0) 8)))
    (置 i (+ i 1))))
(函数 解析函数段 ()
  (局 p n i 类型 条 导)
  (置 p (节起 3))
  (若 (! p) (返回))
  (取u n p)
  (置 导 (读4 S_导入数))
  (置 i 0)
  (当 (< i n)
    (取u 类型 p)
    (置 条 (函数条 (+ 导 i)))
    (存4 条 类型)
    (存4 (+ 条 12) (读4 (+ (类型条 类型) 4)))
    (存4 (+ 条 16) (读4 (+ (类型条 类型) 8)))
    (置 i (+ i 1))))
(函数 解析代码段 ()
  (局 p n i 条 导 长 体止 组数 j 个数 总)
  (置 p (节起 10))
  (若 (! p) (返回))
  (取u n p)
  (置 导 (读4 S_导入数))
  (置 i 0)
  (当 (< i n)
    (取u 长 p)
    (置 体止 (+ p 长))
    (置 条 (函数条 (+ 导 i)))
    (取u 组数 p)
    (置 总 0)
    (置 j 0)
    (当 (< j 组数)
      (取u 个数 p)
      (弃 (值类别 p))
      (置 p (读4 S_读址))
      (置 总 (+ 总 个数))
      (置 j (+ j 1)))
    (存4 (+ 条 4) p)
    (存4 (+ 条 8) 体止)
    (存4 (+ 条 20) (+ (读4 (+ 条 12)) 总))
    (置 p 体止)
    (置 i (+ i 1))))
(函数 解析全局段 ()
  (局 p n)
  (置 p (节起 6))
  (若 (! p) (存4 S_全局数 0) (返回))
  (取u n p)
  (存4 S_全局数 n)
  (存4 S_全局表 (取区域 (* n 8))))
; 表：描述 16 字节 [数据指针 大小 上限 元素类别]；元素每项 4 字节
(函数 解析表段 ()
  (局 p n i 标志 最小 最大 类别 描述 上限)
  (置 p (节起 4))
  (若 (! p) (返回))
  (取u n p)
  (存4 S_表数 n)
  (存4 S_表描述 (取区域 (* n 16)))
  (置 i 0)
  (当 (< i n)
    (置 类别 (值类别 p))
    (置 p (读4 S_读址))
    (置 标志 (读1 p))
    (置 p (+ p 1))
    (取u 最小 p)
    (置 最大 -1)
    (若 (& 标志 1) (取u 最大 p))
    (置 上限 (选 (& 标志 1) 最大 (+ 最小 1024)))
    (置 描述 (+ (读4 S_表描述) (* i 16)))
    (存4 描述 (取区域 (* 上限 4)))
    (存4 (+ 描述 4) 最小)
    (存4 (+ 描述 8) 上限)
    (存4 (+ 描述 12) 类别)
    (置 i (+ i 1))))
; 标签：每项 8 字节 [类型 参数数]
(函数 解析标签段 ()
  (局 p n i 类型 条)
  (置 p (节起 13))
  (若 (! p) (返回))
  (取u n p)
  (存4 S_标签数 n)
  (存4 S_标签表 (取区域 (* n 8)))
  (置 i 0)
  (当 (< i n)
    (置 p (+ p 1))
    (取u 类型 p)
    (置 条 (+ (读4 S_标签表) (* i 8)))
    (存4 条 类型)
    (存4 (+ 条 4) (读4 (+ (类型条 类型) 4)))
    (置 i (+ i 1))))
; 跳过常量表达式，返回 end 之后的位置
(函数 跳过常量式 (p)
  (局 op 子)
  (当 1
    (置 op (读1 p))
    (置 p (+ p 1))
    (分派 op
      (情形 (0x0B) (返回 p))
      (情形 (0x41 0xD0) (弃 (读s32 p)) (置 p (读4 S_读址)))
      (情形 (0x42) (弃 (读s64 p)) (置 p (读4 S_读址)))
      (情形 (0x43) (置 p (+ p 4)))
      (情形 (0x44) (置 p (+ p 8)))
      (情形 (0x23 0xD2) (弃 (读u32 p)) (置 p (读4 S_读址)))
      (情形 (0xFB)
        (取u 子 p)
        (分派 子
          (情形 (0 1 6 7) (弃 (读u32 p)) (置 p (读4 S_读址)))
          (情形 (8) (弃 (读u32 p)) (置 p (读4 S_读址)) (弃 (读u32 p)) (置 p (读4 S_读址)))))
      (否则))))
; 元素段描述 24 字节 [向量起 个数 标志 已弃 偏移式指针 表号]；标志 = 元素段种类 0..7
(函数 解析元素段 ()
  (局 p n i 标志 个数 j 条 表号 式)
  (置 p (节起 9))
  (若 (! p) (返回))
  (取u n p)
  (存4 S_元素段数 n)
  (存4 S_元素段表 (取区域 (* n 24)))
  (置 i 0)
  (当 (< i n)
    (置 条 (+ (读4 S_元素段表) (* i 24)))
    (取u 标志 p)
    (存4 (+ 条 8) 标志)
    (置 表号 0)
    (置 式 0)
    (若 (|| (== 标志 2) (== 标志 6)) (取u 表号 p))
    (若 (|| (== 标志 0) (== 标志 2) (== 标志 4) (== 标志 6)) (置 式 p) (置 p (跳过常量式 p)))
    (若 (|| (== 标志 1) (== 标志 2) (== 标志 3)) (置 p (+ p 1)))
    (若 (|| (== 标志 5) (== 标志 6) (== 标志 7)) (弃 (值类别 p)) (置 p (读4 S_读址)))
    (取u 个数 p)
    (存4 条 p)
    (存4 (+ 条 4) 个数)
    (存4 (+ 条 16) 式)
    (存4 (+ 条 20) 表号)
    (若否 (< 标志 4)
      ((置 j 0) (当 (< j 个数) (弃 (读u32 p)) (置 p (读4 S_读址)) (置 j (+ j 1))))
      ((置 j 0) (当 (< j 个数) (置 p (跳过常量式 p)) (置 j (+ j 1)))))
    (置 i (+ i 1))))
; 数据段描述 16 字节 [数据指针 长度 种类(0主动 1被动) 已弃 偏移式指针]
(函数 解析数据段 ()
  (局 p n i 标志 长 条 式)
  (置 p (节起 11))
  (若 (! p) (返回))
  (取u n p)
  (存4 S_数据段数 n)
  (存4 S_数据段表 (取区域 (* n 20)))
  (置 i 0)
  (当 (< i n)
    (置 条 (+ (读4 S_数据段表) (* i 20)))
    (取u 标志 p)
    (置 式 0)
    (若 (== 标志 2) (弃 (读u32 p)) (置 p (读4 S_读址)))
    (若 (!= 标志 1) (置 式 p) (置 p (跳过常量式 p)))
    (取u 长 p)
    (存4 条 p)
    (存4 (+ 条 4) 长)
    (存4 (+ 条 8) (== 标志 1))
    (存4 (+ 条 16) 式)
    (置 p (+ p 长))
    (置 i (+ i 1))))
; 导出：按名字找，返回索引（没有为 -1）；种类存 S_读高
(函数 查导出 (串)
  (局 p n i 名长 种 索)
  (置 p (节起 7))
  (若 (! p) (返回 -1))
  (取u n p)
  (置 i 0)
  (当 (< i n)
    (取u 名长 p)
    (若 (名相同 p 名长 串)
      (置 p (+ p 名长))
      (存4 S_读高 (读1 p))
      (置 p (+ p 1))
      (取u 索 p)
      (返回 索))
    (置 p (+ p 名长))
    (置 p (+ p 1))
    (弃 (读u32 p))
    (置 p (读4 S_读址))
    (置 i (+ i 1)))
  (返回 -1))
(函数 解析起始 ()
  (局 p f)
  (存4 S_起始函数 -1)
  (置 p (节起 8))
  (若 p (取u f p) (存4 S_起始函数 f)))
; 客体线性内存声明（至多一个）
(函数 解析内存段 ()
  (局 p n 标志 最小 最大)
  (存4 S_客页数 0)
  (存4 S_客页上限 0)
  (置 p (节起 5))
  (若 (! p) (返回))
  (取u n p)
  (若 (< n 1) (返回))
  (置 标志 (读1 p))
  (置 p (+ p 1))
  (取u 最小 p)
  (置 最大 最小)
  (若 (& 标志 1) (取u 最大 p))
  (若 (> 最大 128) (置 最大 128))
  (若 (< 最大 最小) (置 最大 最小))
  (存4 S_客页数 最小)
  (存4 S_客页上限 最大)
  (存4 S_客内存 (取区域 (* 最大 65536))))
