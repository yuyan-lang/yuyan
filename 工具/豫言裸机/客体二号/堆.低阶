; 客体执行器二号：GC 堆——分配、位图、标记清扫
; 对象：头 8 字节 [字0：类型号(低24位) | 种类<<24 | 标记位(bit31)；字1：总字节数]
;   结构体：头 + 每字段 8 字节；数组：头 + [长度 4][填充 4] + 元素（按元素宽度）；空闲块：种类 3，+8 存下一块
(常量 头标记 0x80000000)
(常量 种类结构 1)
(常量 种类数组 2)
(常量 种类空闲 3)
(常量 小块上限 256)
(常量 堆增量 0x100000)      ; 每次向内存索取 1 MiB
(常量 初始堆字节 0x400000)  ; 初始堆容量 4 MiB
(常量 回收下限 0x200000)    ; 两次回收之间至少分配 2 MiB

(函数 位图位置 (a)   ; 返回字节地址，位号存 S_读高
  (局 序)
  (置 序 (>>u (- a (读4 S_堆基)) 3))
  (存4 S_读高 (& 序 7))
  (返回 (+ (读4 S_位图基) (>>u 序 3))))
(函数 位图置 (a)
  (局 p)
  (置 p (位图位置 a))
  (存1 p (| (读1 p) (<< 1 (读4 S_读高)))))
(函数 位图清 (a)
  (局 p)
  (置 p (位图位置 a))
  (存1 p (& (读1 p) (^ (<< 1 (读4 S_读高)) -1))))
(函数 位图取 (a)
  (局 p)
  (置 p (位图位置 a))
  (返回 (& (>>u (读1 p) (读4 S_读高)) 1)))

(函数 初始化堆 ()
  (局 起 顶限 最大字节 位图字节 页上限)
  (置 页上限 (读4 S_页上限))
  (置 起 (& (+ (读4 S_区域顶) 4095) -4096))
  ; 位图按最大内存估算：每 64 字节堆 1 字节
  (置 最大字节 (- (* 页上限 65536) 起))
  (置 位图字节 (+ (>>u 最大字节 6) 64))
  (存4 S_位图基 起)
  (存4 S_位图字节 位图字节)
  (置 起 (& (+ (+ 起 位图字节) 4095) -4096))
  (存4 S_区域顶 起)
  (存4 S_堆基 起)
  (存4 S_堆顶 起)
  (置 顶限 (+ 起 初始堆字节))
  (若 (>u 顶限 (* 页上限 65536)) (置 顶限 (* 页上限 65536)))
  (增长到 顶限)
  (存4 S_堆限 顶限)
  (若 (! (读4 S_回收下限)) (存4 S_回收下限 回收下限))
  (存4 S_回收阈 (读4 S_回收下限))
  (存4 S_分配计 0)
  (存4 S_回收禁 0))

; 尝试把堆限抬高至少 n 字节；成功返回 1
(函数 增长堆 (n)
  (局 新限 需页 现页 差)
  (置 新限 (+ (读4 S_堆限) (选 (>u n 堆增量) (& (+ n 65535) -65536) 堆增量)))
  (若 (>u 新限 (* (读4 S_页上限) 65536)) (置 新限 (* (读4 S_页上限) 65536)))
  (若 (<u 新限 (+ (读4 S_堆顶) n)) (返回 0))
  (置 需页 (/u (+ 新限 65535) 65536))
  (置 现页 (内存页数))
  (若 (>u 需页 现页)
    (置 差 (- 需页 现页))
    (若 (< (内存增长 差) 0) (返回 0)))
  (存4 S_页数 (内存页数))
  (存4 S_堆限 新限)
  (返回 1))

; ---- 自由链表 ----
(函数 放回空闲 (p n)
  (局 类)
  (存4 p (<< 种类空闲 24))
  (存4 (+ p 4) n)
  (若否 (<= n 小块上限)
    ((置 类 (+ S_自由表 (* (>>u n 3) 4)))
     (存4 (+ p 8) (读4 类))
     (存4 类 p))
    ((存4 (+ p 8) (读4 S_大自由))
     (存4 S_大自由 p))))
; 从自由链表取 n 字节的块（必要时分割）；没有返回 0
(函数 取空闲 (n)
  (局 p 类 大 余 前 k)
  ; 精确小类
  (若 (<= n 小块上限)
    (置 类 (+ S_自由表 (* (>>u n 3) 4)))
    (置 p (读4 类))
    (若 p (存4 类 (读4 (+ p 8))) (返回 p))
    ; 较大的小类：分割
    (置 k (+ n 16))
    (当 (<= k 小块上限)
      (置 类 (+ S_自由表 (* (>>u k 3) 4)))
      (置 p (读4 类))
      (若 p
        (存4 类 (读4 (+ p 8)))
        (放回空闲 (+ p n) (- k n))
        (存4 (+ p 4) n)
        (返回 p))
      (置 k (+ k 8))))
  ; 大块表：首次适应
  (置 前 0)
  (置 p (读4 S_大自由))
  (当 p
    (置 大 (读4 (+ p 4)))
    (若 (>=u 大 n)
      (若否 前 ((存4 (+ 前 8) (读4 (+ p 8)))) ((存4 S_大自由 (读4 (+ p 8)))))
      (置 余 (- 大 n))
      (若否 (>= 余 16)
        ((放回空闲 (+ p n) 余) (存4 (+ p 4) n))
        ((存4 (+ p 4) 大)))
      (返回 p))
    (置 前 p)
    (置 p (读4 (+ p 8))))
  (返回 0))
(函数 划出 (n)
  (局 p)
  (置 p (读4 S_堆顶))
  (若 (>u (+ p n) (读4 S_堆限)) (返回 0))
  (存4 S_堆顶 (+ p n))
  (返回 p))

; ---- 分配：返回对象头地址；头字 0/1 由本函数写入（种类、类型号、总字节数），载荷已清零 ----
(函数 分配对象 (n 种类 类型号)
  (局 p 试 实)
  (置 n (& (+ n 7) -8))
  (若 (< n 16) (置 n 16))
  (若 (&& (>=u (读4 S_分配计) (读4 S_回收阈)) (! (读4 S_回收禁))) (回收))
  (当 1
    (置 p (取空闲 n))
    (若 p (置 实 (读4 (+ p 4))) (清零 p 实) (置 n 实) (中断))
    (置 p (划出 n))
    (若 p (清零 p n) (中断))
    (若否 (&& (! (读4 S_回收禁)) (== 试 0))
      ((回收) (置 试 1))
      ((若 (! (增长堆 n)) (陷阱退出 120 "堆内存不足")))))
  (存4 p (| 类型号 (<< 种类 24)))
  (存4 (+ p 4) n)
  (位图置 p)
  (存4 S_分配计 (+ (读4 S_分配计) n))
  (返回 p))

; 结构体与数组的大小
(函数 结构字节 (t) (返回 (+ 8 (* (读4 (+ (类型条 t) 4)) 8))))
(函数 数组字节 (t 长)
  (局 宽)
  (置 宽 (读4 (+ (类型条 t) 8)))
  (若 (>u 长 (/u 0x10000000 (选 (> 宽 0) 宽 1))) (陷阱退出 120 "数组过大"))
  (返回 (+ 16 (& (+ (* 长 宽) 7) -8))))

; ---- 标记 ----
(函数 压标记栈 (p)
  (局 顶)
  (置 顶 (读4 S_标记栈顶))
  (若 (>=u 顶 (读4 S_标记栈限))
    (存4 S_标记溢出 1)
    (返回))
  (存4 顶 p)
  (存4 S_标记栈顶 (+ 顶 4)))
(函数 标记候选 (w)
  (若 (& w 7) (返回))
  (若 (<u w (读4 S_堆基)) (返回))
  (若 (>=u w (读4 S_堆顶)) (返回))
  (若 (! (位图取 w)) (野指针 w) (返回))
  (监视点 w)
  (若 (& (读4 w) 头标记) (返回))
  (存4 w (| (读4 w) 头标记))
  (压标记栈 w))
(函数 扫描对象 (p)
  (局 头 种 t 表 数 i 描述 长)
  (置 头 (读4 p))
  (存4 S_扫描中 p)
  (置 种 (& (>>u 头 24) 7))
  (置 t (& 头 0xFFFFFF))
  (若 (== 种 种类结构)
    (置 数 (读4 (+ (类型条 t) 4)))
    (置 描述 (读4 (+ (类型条 t) 16)))
    (置 i 0)
    (当 (< i 数)
      (若 (== (读1 (+ 描述 i)) 2) (标记候选 (读4 (+ (+ p 8) (* i 8)))))
      (置 i (+ i 1)))
    (返回))
  (若 (== 种 4)
    (置 长 (读4 (+ p 12)))
    (置 i 0)
    (当 (< i (* 长 2))
      (标记候选 (读4 (+ (+ p 16) (* i 4))))
      (置 i (+ i 1)))
    (返回))
  (若 (== 种 种类数组)
    (若 (== (读4 (+ (类型条 t) 4)) 2)
      (置 长 (读4 (+ p 8)))
      (置 i 0)
      (当 (< i 长)
        (标记候选 (读4 (+ (+ p 16) (* i 4))))
        (置 i (+ i 1))))))
(函数 清空标记栈 ()
  (局 顶 p)
  (当 1
    (当 (>u (读4 S_标记栈顶) (读4 S_标记栈基))
      (置 顶 (- (读4 S_标记栈顶) 4))
      (存4 S_标记栈顶 顶)
      (扫描对象 (读4 顶)))
    (若 (! (读4 S_标记溢出)) (中断))
    ; 溢出：线性重扫已标记对象
    (存4 S_标记溢出 0)
    (置 p (读4 S_堆基))
    (当 (<u p (读4 S_堆顶))
      (若 (&& (& (读4 p) 头标记) (!= (& (>>u (读4 p) 24) 7) 种类空闲))
        (扫描对象 p))
      (置 p (+ p (读4 (+ p 4)))))))
(函数 标记根区 (起 止 步)
  (局 p)
  (置 p 起)
  (当 (<u p 止)
    (标记候选 (读4 p))
    (置 p (+ p 步))))
(函数 回收 ()
  (局 p 头 大 存活 游起 游长 下一 表 i n)
  (回收前检查)
  ; 根：值栈（两字都保守）、全局、表、异常载荷
  (存4 S_标记栈顶 (读4 S_标记栈基))
  (存4 S_标记溢出 0)
  (标记根区 (读4 S_值栈基) (读4 S_sp) 4)
  (标记根区 (读4 S_全局表) (+ (读4 S_全局表) (* (读4 S_全局数) 8)) 8)
  (置 i 0)
  (当 (< i (读4 S_表数))
    (置 表 (+ (读4 S_表描述) (* i 16)))
    (标记根区 (读4 表) (+ (读4 表) (* (读4 (+ 表 4)) 4)) 4)
    (置 i (+ i 1)))
  (标记根区 S_例外载荷 (+ S_例外载荷 (* (读4 S_例外数) 8)) 4)
  (清空标记栈)
  (标记后检查)
  ; 清扫
  (清零 S_自由表 132)
  (存4 S_大自由 0)
  (置 p (读4 S_堆基))
  (置 游起 0)
  (置 游长 0)
  (当 (<u p (读4 S_堆顶))
    (置 头 (读4 p))
    (置 大 (读4 (+ p 4)))
    (置 下一 (+ p 大))
    (若否 (== (& (>>u 头 24) 7) 种类空闲)
      ((若否 游长 ((置 游长 (+ 游长 大))) ((置 游起 p) (置 游长 大))))
      ((若否 (& 头 头标记)
         ((存4 p (& 头 (^ 头标记 -1)))
          (置 存活 (+ 存活 大))
          (若 游长 (放回空闲 游起 游长) (置 游长 0)))
         ((清扫点 p)
          (位图清 p)
          (若否 游长 ((置 游长 (+ 游长 大))) ((置 游起 p) (置 游长 大)))))))
    (置 p 下一))
  (若否 游长
    ((若否 (== (+ 游起 游长) (读4 S_堆顶))
       ((放回空闲 游起 游长))
       ((存4 S_堆顶 游起))))
    ())
  (存4 S_活字节 存活)
  (回收记录 存活)
  (存4 S_分配计 0)
  (置 n 存活)
  (存4 S_回收阈 (选 (>u n (读4 S_回收下限)) n (读4 S_回收下限))))
