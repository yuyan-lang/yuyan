; ---- 输出助手 ----
(函数 打印串 (p n)
  (局 i)
  (当 (< i n) (写字节 (读1 (+ p i))) (置 i (+ i 1))))
(函数 打印数 (v)
  (局 n i d)
  (若 (< v 0) (写字节 45) (置 v (- 0 v)))
  (置 n v)
  (置 d 1)
  (当 (>=u (/u n d) 10) (置 d (* d 10)))
  (当 d
    (写字节 (+ 48 (%u (/u v d) 10)))
    (置 d (/u d 10))))
(函数 打印十六 (v)
  (局 i d)
  (置 i 28)
  (当 (>= i 0)
    (置 d (& (>>u v i) 15))
    (写字节 (选 (< d 10) (+ 48 d) (+ 87 d)))
    (置 i (- i 4))))
(函数 换行 () (写字节 10))
; 打印一个字符串常量（数据段里以零结尾）
(函数 打印零串 (p)
  (当 (读1 p) (写字节 (读1 p)) (置 p (+ p 1))))
(函数 陷阱退出 (码 说明)
  (打印零串 说明)
  (写字节 10)
  (退出任务 码)
  (陷阱))

; ---- LEB128 ----
(函数 读u32 (p)
  (局 b r s)
  (当 1
    (令 b (读1 p))
    (置 p (+ p 1))
    (置 r (| r (<< (& b 127) s)))
    (若 (! (& b 128)) (中断))
    (置 s (+ s 7)))
  (存4 S_读址 p)
  (返回 r))
(函数 读s32 (p)
  (局 b r s)
  (当 1
    (令 b (读1 p))
    (置 p (+ p 1))
    (置 r (| r (<< (& b 127) s)))
    (置 s (+ s 7))
    (若 (! (& b 128)) (中断)))
  (若 (&& (< s 32) (& b 64)) (置 r (| r (<< -1 s))))
  (存4 S_读址 p)
  (返回 r))
; 有符号 64 位：返回低字，高字存 S_读高
(函数 读s64 (p)
  (局 b lo hi s x)
  (当 1
    (令 b (读1 p))
    (置 p (+ p 1))
    (置 x (& b 127))
    (若否 (< s 32)
      ((置 lo (| lo (<< x s)))
       (若 (> s 25) (置 hi (| hi (>>u x (- 32 s))))))
      ((置 hi (| hi (<< x (- s 32))))))
    (置 s (+ s 7))
    (若 (! (& b 128)) (中断)))
  (若 (& b 64)
    (若否 (< s 32)
      ((置 lo (| lo (<< -1 s))) (置 hi -1))
      ((若 (< s 64) (置 hi (| hi (<< -1 (- s 32))))))))
  (存4 S_读高 hi)
  (存4 S_读址 p)
  (返回 lo))
; 有符号 33 位（块类型、堆类型）：返回低 32 位，足够用（类型索引非负、抽象类型为小负数）
(函数 读s33 (p) (返回 (读s32 p)))

; 取 LEB 并推进游标的宏：变量 v 与游标 p
(宏 取u (v p) (块 (置 v (读u32 p)) (置 p (读4 S_读址))))
(宏 取s (v p) (块 (置 v (读s32 p)) (置 p (读4 S_读址))))

; ---- 内存助手 ----
(函数 清零 (p n)
  (若 (> n 0) (内存填充 p 0 n)))
(函数 拷贝 (d s n)
  (若 (> n 0) (内存复制 d s n)))
; 从动态区域取 n 字节（8 字节对齐），按需增长内存；返回地址（已清零，因新内存为零）
(函数 增长到 (顶)
  (局 需 现 差)
  (置 需 (/u (+ 顶 65535) 65536))
  (置 现 (内存页数))
  (若 (>u 需 现)
    (置 差 (- 需 现))
    (若 (< (内存增长 差) 0) (陷阱退出 120 "内存不足")))
  (存4 S_页数 (内存页数)))
(函数 取区域 (n)
  (局 p)
  (置 n (& (+ n 7) -8))
  (置 p (读4 S_区域顶))
  (增长到 (+ p n))
  (存4 S_区域顶 (+ p n))
  (返回 p))

; ---- 宽整数（64 位）助手：槽为 [低字, 高字]，地址 a、b、d ----
(函数 乘高 (x y)
  (局 xl xh yl yh ll lh hl hh mid)
  (置 xl (& x 65535)) (置 xh (>>u x 16))
  (置 yl (& y 65535)) (置 yh (>>u y 16))
  (置 ll (* xl yl)) (置 lh (* xl yh)) (置 hl (* xh yl)) (置 hh (* xh yh))
  (置 mid (+ (+ (>>u ll 16) (& lh 65535)) (& hl 65535)))
  (返回 (+ (+ hh (>>u lh 16)) (+ (>>u hl 16) (>>u mid 16)))))
(函数 加64 (d a b)
  (局 lo hi)
  (置 lo (+ (读4 a) (读4 b)))
  (置 hi (+ (+ (读4 (+ a 4)) (读4 (+ b 4))) (<u lo (读4 a))))
  (存4 d lo) (存4 (+ d 4) hi))
(函数 减64 (d a b)
  (局 lo hi)
  (置 lo (- (读4 a) (读4 b)))
  (置 hi (- (- (读4 (+ a 4)) (读4 (+ b 4))) (<u (读4 a) (读4 b))))
  (存4 d lo) (存4 (+ d 4) hi))
(函数 乘64 (d a b)
  (局 al ah bl bh lo hi)
  (置 al (读4 a)) (置 ah (读4 (+ a 4))) (置 bl (读4 b)) (置 bh (读4 (+ b 4)))
  (置 lo (* al bl))
  (置 hi (+ (乘高 al bl) (+ (* al bh) (* ah bl))))
  (存4 d lo) (存4 (+ d 4) hi))
; 比较：返回 -1/0/1（有符号）
(函数 比较64有 (a b)
  (局 ah bh al bl)
  (置 ah (读4 (+ a 4))) (置 bh (读4 (+ b 4)))
  (若 (< ah bh) (返回 -1))
  (若 (> ah bh) (返回 1))
  (置 al (读4 a)) (置 bl (读4 b))
  (若 (<u al bl) (返回 -1))
  (若 (>u al bl) (返回 1))
  (返回 0))
(函数 比较64无 (a b)
  (局 ah bh al bl)
  (置 ah (读4 (+ a 4))) (置 bh (读4 (+ b 4)))
  (若 (<u ah bh) (返回 -1))
  (若 (>u ah bh) (返回 1))
  (置 al (读4 a)) (置 bl (读4 b))
  (若 (<u al bl) (返回 -1))
  (若 (>u al bl) (返回 1))
  (返回 0))
; 左移 n 位（0..63）
(函数 左移64 (d a n)
  (局 lo hi)
  (置 n (& n 63))
  (置 lo (读4 a)) (置 hi (读4 (+ a 4)))
  (若否 (== n 0) ()
    ((若否 (< n 32)
       ((置 hi (| (<< hi n) (>>u lo (- 32 n)))) (置 lo (<< lo n)))
       ((置 hi (<< lo (- n 32))) (置 lo 0)))))
  (存4 d lo) (存4 (+ d 4) hi))
(函数 右移64无 (d a n)
  (局 lo hi)
  (置 n (& n 63))
  (置 lo (读4 a)) (置 hi (读4 (+ a 4)))
  (若否 (== n 0) ()
    ((若否 (< n 32)
       ((置 lo (| (>>u lo n) (<< hi (- 32 n)))) (置 hi (>>u hi n)))
       ((置 lo (>>u hi (- n 32))) (置 hi 0)))))
  (存4 d lo) (存4 (+ d 4) hi))
(函数 右移64有 (d a n)
  (局 lo hi)
  (置 n (& n 63))
  (置 lo (读4 a)) (置 hi (读4 (+ a 4)))
  (若否 (== n 0) ()
    ((若否 (< n 32)
       ((置 lo (| (>>u lo n) (<< hi (- 32 n)))) (置 hi (>> hi n)))
       ((置 lo (>> hi (- n 32))) (置 hi (>> hi 31))))))
  (存4 d lo) (存4 (+ d 4) hi))
; 无符号 64 位除法（商 q，余 r 均为槽地址；除数非零）
(函数 除余64无 (q r a b)
  (局 nl nh dl dh ql qh rl rh i cmp bit)
  (置 nl (读4 a)) (置 nh (读4 (+ a 4)))
  (置 dl (读4 b)) (置 dh (读4 (+ b 4)))
  (若否 (&& (== nh 0) (== dh 0))
    ((置 ql (/u nl dl)) (置 rl (%u nl dl)))
    ((置 i 64)
     (当 i
       ; r = (r << 1) | 最高位；n <<= 1
       (置 rh (| (<< rh 1) (>>u rl 31)))
       (置 rl (| (<< rl 1) (>>u nh 31)))
       (置 nh (| (<< nh 1) (>>u nl 31)))
       (置 nl (<< nl 1))
       ; 若 r >= d 则 r -= d 并将商位置一
       (置 cmp (|| (>u rh dh) (&& (== rh dh) (>=u rl dl))))
       (置 qh (| (<< qh 1) (>>u ql 31)))
       (置 ql (<< ql 1))
       (若 cmp
         (置 rh (- (- rh dh) (<u rl dl)))
         (置 rl (- rl dl))
         (置 ql (| ql 1)))
       (置 i (- i 1)))))
  (存4 q ql) (存4 (+ q 4) qh)
  (存4 r rl) (存4 (+ r 4) rh))
(函数 取负64 (d a)
  (局 lo hi)
  (置 lo (- 0 (读4 a)))
  (置 hi (- (- 0 (读4 (+ a 4))) (!= (读4 a) 0)))
  (存4 d lo) (存4 (+ d 4) hi))
