; 调试构建：逐指令跟踪（S_跟踪 非零时输出）
(宏 跟踪点 () (若 (读4 S_跟踪) (跟踪 oa op sp fp)))
(函数 跟踪 (pc op sp fp)
  (局 E)
  (若 (&& (读4 S_监视) (== (读4 (- sp 8)) (读4 S_监视)) (< (读4 0x878) 3))
    (存4 0x878 (+ (读4 0x878) 1))
    (打印零串 "监视出现于栈顶 前一指令之后，将执行 ") (打印十六 op) (写字节 32) (打印数 (读4 S_函)) (写字节 58) (打印数 (- pc (读4 (+ (函数条 (读4 S_函)) 4)))) (写字节 10))
  (置 E (函数条 (读4 S_函)))
  (若 (== (读4 S_跟踪) 2) (返回))
  (写字节 84) (写字节 32)
  (打印数 (读4 S_函))
  (写字节 58)
  (打印数 (- pc (读4 (+ E 4))))
  (写字节 32)
  (打印十六 op)
  (写字节 32)
  (打印数 (/ (- sp (读4 S_值栈基)) 8))
  (写字节 32)
  (打印数 (/ (- fp (读4 S_值栈基)) 8))
  (写字节 10))
(宏 回收记录 (n) (若 (读4 S_跟踪) (打印零串 "GC 存活 ") (打印数 n) (写字节 32) (打印数 (- (读4 S_堆顶) (读4 S_堆基))) (写字节 10)))
(函数 转换失败 (w ht)
  (打印零串 "转换失败 w=") (打印十六 w)
  (打印零串 " ht=") (打印数 ht)
  (若 (&& (! (& w 7)) w) (打印零串 " 头=") (打印十六 (读4 w)) (打印零串 " 大小=") (打印数 (读4 (+ w 4))))
  (写字节 10)
  (找引用者 w)
  (陷阱退出 135 "类型转换失败"))
(函数 找引用者 (w)
  (局 p 大 头 种 i n 找)
  (置 p (读4 S_值栈基))
  (当 (<u p (读4 S_sp))
    (若 (== (读4 p) w) (打印零串 " 栈引用 槽=") (打印数 (/ (- p (读4 S_值栈基)) 8)) (写字节 10))
    (置 p (+ p 4)))
  (置 p (读4 S_堆基))
  (当 (&& (<u p (读4 S_堆顶)) (< 找 6))
    (置 大 (读4 (+ p 4)))
    (置 头 (读4 p))
    (置 种 (& (>>u 头 24) 7))
    (若 (!= 种 3)
      (置 i 8)
      (当 (< i 大)
        (若 (== (读4 (+ p i)) w)
          (打印零串 " 引用者 ") (打印十六 p) (打印零串 " 头=") (打印十六 头) (打印零串 " 偏移=") (打印数 i) (写字节 10)
          (置 找 (+ 找 1)))
        (置 i (+ i 4))))
    (置 p (+ p 大))))
(函数 野指针 (w)
  (若 (读4 S_跟踪) (打印零串 "野指针 ") (打印十六 w) (写字节 10)))
(宏 监视点 (w) (若 (== w (读4 S_监视)) (打印零串 "监视对象被标记，来自 ") (打印十六 (读4 S_扫描中)) (写字节 10)))
(宏 清扫点 (p) (若 (== p (读4 S_监视)) (打印零串 "监视对象被清扫 头=") (打印十六 (读4 p)) (写字节 10)))
(函数 回收前检查 ()
  (局 p n)
  (打印零串 "GC 开始 栈深槽=") (打印数 (/ (- (读4 S_sp) (读4 S_值栈基)) 8))
  (打印零串 " 帧数=") (打印数 (/ (- (读4 S_帧顶) (读4 S_帧栈基)) 32))
  (写字节 10)
  (置 p (读4 S_值栈基))
  (当 (<u p (读4 S_sp))
    (打印数 (/ (- p (读4 S_值栈基)) 8)) (写字节 58) (打印十六 (读4 p)) (写字节 47) (打印十六 (读4 (+ p 4)))
    (若 (&& (! (& (读4 p) 7)) (>=u (读4 p) (读4 S_堆基)) (<u (读4 p) (读4 S_堆顶)))
      (打印零串 " 头=") (打印十六 (读4 (读4 p))) (打印零串 " 大小=") (打印数 (读4 (+ (读4 p) 4))))
    (写字节 10)
    (置 p (+ p 8)))
  (置 p (读4 S_全局表))
  (置 n 0)
  (当 (<u p (+ (读4 S_全局表) (* (读4 S_全局数) 8)))
    (若 (== (读4 p) (读4 S_监视)) (打印零串 " 全局中含监视对象 号=") (打印数 (/ (- p (读4 S_全局表)) 8)) (写字节 10))
    (置 p (+ p 8))))
(函数 标记后检查 ()
  (局 p 大 头 种 i w 头2 报)
  (置 p (读4 S_堆基))
  (当 (&& (<u p (读4 S_堆顶)) (< 报 8))
    (置 大 (读4 (+ p 4)))
    (置 头 (读4 p))
    (置 种 (& (>>u 头 24) 7))
    (若 (&& (!= 种 3) (& 头 头标记))
      (置 i 8)
      (当 (< i 大)
        (置 w (读4 (+ p i)))
        (若 (&& (! (& w 7)) (>=u w (读4 S_堆基)) (<u w (读4 S_堆顶)) (位图取 w) (! (& (读4 w) 头标记)))
          (打印零串 "遗漏边 对象=") (打印十六 p) (打印零串 " 头=") (打印十六 头) (打印零串 " 偏移=") (打印数 i)
          (打印零串 " → ") (打印十六 w) (打印零串 " 头=") (打印十六 (读4 w)) (写字节 10)
          (置 报 (+ 报 1)))
        (置 i (+ i 4))))
    (置 p (+ p 大))))
(函数 类型表调试 ()
  (局 t 条 i n 描述)
  (若 (! (读4 S_跟踪)) (返回))
  (置 t 17)
  (当 (< t (读4 S_类型数))
    (置 条 (类型条 t))
    (打印零串 "类型 ") (打印数 t) (打印零串 " 种类=") (打印数 (读4 条)) (打印零串 " 甲=") (打印数 (读4 (+ 条 4))) (打印零串 " 乙=") (打印数 (读4 (+ 条 8)))
    (若 (== (读4 条) 2)
      (打印零串 " 字段:")
      (置 描述 (读4 (+ 条 16)))
      (置 i 0)
      (当 (< i (读4 (+ 条 4))) (写字节 (+ 48 (读1 (+ 描述 i)))) (置 i (+ i 1))))
    (写字节 10)
    (置 t (+ t 1))))
(宏 文件系统调试 (类 值) (若 (读4 S_跟踪) (打印零串 "文件系统 步骤") (打印数 类) (写字节 61) (打印数 值) (写字节 10)))
