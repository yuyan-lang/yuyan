; 内核服务 24/25 测试：块搬入静态 / 块搬出静态
(导入 写字节 "平台" "写字节" 1 0)
(导入 搬入 "平台" "搬入静态" 2 1)
(导入 搬出 "平台" "搬出静态" 2 1)
(导入 块数 "平台" "内存块数" 0 1)
(内存 1 512)

(函数 打印数 (n)
  (令 d 1000)
  (当 (> d 0)
    (写字节 (+ 48 (%u (/u n d) 10)))
    (置 d (/u d 10)))
  (写字节 10))

(函数 填 (基 长 种)
  (令 i 0)
  (当 (<u i 长)
    (存1 (+ 基 i) (+ 种 i))
    (置 i (+ i 1))))

(函数 验 (基 长 种)
  (令 i 0)
  (当 (<u i 长)
    (若 (!= (读1 (+ 基 i)) (& (+ 种 i) 255)) (返回 0))
    (置 i (+ i 1)))
  (返回 1))

(函数 清 (基 长)
  (内存填充 基 0 长))

(函数 失败 (n)
  (写字节 70) (写字节 65) (写字节 73) (写字节 76) (写字节 32)
  (打印数 n)
  (陷阱))

(函数 启动 ()
  ; 静态阶段：线性内存仍在静态窗口
  (填 0x1000 64 1)
  (若 (!= (搬入 0x1000 (| 0x100 (<< 64 20))) 0) (失败 1))
  (清 0x1000 64)
  (若 (!= (搬出 0x2000 (| 0x100 (<< 64 20))) 0) (失败 2))
  (若 (== (验 0x2000 64 1) 0) (失败 3))
  ; 越界
  (若 (!= (搬入 0 (| 0x7FFF0 (<< 32 20))) -1) (失败 4))
  (若 (!= (搬入 0x7FFF0 (| 0 (<< 32 20))) -1) (失败 5))
  (若 (!= (搬出 0x90000 (| 0 (<< 16 20))) -1) (失败 6))
  ; 边界恰好合法
  (若 (!= (搬入 0x7FFC0 (| 0x7FFC0 (<< 64 20))) 0) (失败 7))
  ; 迁移到动态块
  (若 (!= (内存增长 15) 1) (失败 8))
  (若 (== (块数) 0) (失败 9))
  ; 增长后线性内存内容保持
  (若 (== (验 0x2000 64 1) 0) (失败 10))
  ; 静态区仍保持增长前写入的内容
  (清 0x3000 64)
  (若 (!= (搬出 0x3000 (| 0x100 (<< 64 20))) 0) (失败 11))
  (若 (== (验 0x3000 64 1) 0) (失败 12))
  ; 动态阶段往返
  (填 0x40000 100 77)
  (若 (!= (搬入 0x40000 (| 0x400 (<< 100 20))) 0) (失败 13))
  (清 0x40000 100)
  (若 (!= (搬出 0x50000 (| 0x400 (<< 100 20))) 0) (失败 14))
  (若 (== (验 0x50000 100 77) 0) (失败 15))
  ; 动态阶段越界（超过块数×2 MiB）
  (若 (!= (搬入 0x1FFFF0 (| 0 (<< 32 20))) -1) (失败 16))
  ; 4095 字节整块
  (填 0x60000 4095 5)
  (若 (!= (搬入 0x60000 (| 0x1000 (<< 4095 20))) 0) (失败 17))
  (清 0x60000 4095)
  (若 (!= (搬出 0x60000 (| 0x1000 (<< 4095 20))) 0) (失败 18))
  (若 (== (验 0x60000 4095 5) 0) (失败 19))
  (写字节 79) (写字节 75) (写字节 10))
(导出 "启动" 启动)
