{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuyan-package-registry",
  "main": "源码/云桥.js",
  // 文言：版本之址不易。汉语：禁用 HTML 自动重定向，保留 /release/<编号> 的浏览器地址。
  "assets": { "directory": "网页", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    { "pattern": "packages.yuyan-lang.org", "custom_domain": true },
    { "pattern": "usercontent.yuyan-lang.org", "custom_domain": true },
    {
      // 「包管理.yuyan-lang.org」的 IDNA ASCII 形式。
      "pattern": "xn--uiry18e4gf.yuyan-lang.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuyan-package-registry",
      "database_id": "93a386e6-128f-49cb-b69a-56c545ea524a",
      "migrations_dir": "迁移"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGES",
      "bucket_name": "yuyan-user-packages"
    }
  ],
  "containers": [
    {
      "class_name": "PackageRegistryContainer",
      "image": "./容器构建文件",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PACKAGE_CONTAINER",
        "class_name": "PackageRegistryContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PackageRegistryContainer"]
    }
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@yuyan-lang.org"] }],
  "vars": {
    "NATIVE_READER_ENABLED": "true",
    "PORTAL_ORIGIN": "https://packages.yuyan-lang.org",
    "USERCONTENT_ORIGIN": "https://usercontent.yuyan-lang.org",
    "MAX_PACKAGE_BYTES": "10485760",
    "REGISTRATION_ENABLED": "true"
  }
}
