@@ -57,6 +57,19 @@
 #[unsafe(no_mangle)]
 pub extern "C" fn wasm_config_new() -> Box<wasm_config_t> {
-    Box::new(wasm_config_t {
-        config: Config::default(),
-    })
+    // 文言：此本专验复制回收。汉语：本地自举宿主显式采用复制式 GC 和 128 MiB 初始堆。
+    let mut config = Config::default();
+    config.collector(wasmtime::Collector::Copying);
+    // 文言：堆额可设，以验搬迁之费。汉语：只调整初始堆，保留默认 128 MiB 以复现旧对照。
+    let heap_mb = std::env::var("YY_WASM_GC_HEAP_MB").ok()
+        .map(|v| v.parse::<u64>().expect("YY_WASM_GC_HEAP_MB must be an integer"))
+        .unwrap_or(128);
+    assert!((64..=2048).contains(&heap_mb), "YY_WASM_GC_HEAP_MB must be in 64..=2048");
+    config.gc_heap_initial_size(heap_mb * 1024 * 1024);
+    config.async_stack_size(128 * 1024 * 1024);
+    config.max_wasm_stack(64 * 1024 * 1024);
+    // 文言：另试内联，循外设而定。汉语：显式设置后才启用内联，保留默认对照的可复现性。
+    if std::env::var("YY_WASM_GC_INLINE").as_deref() == Ok("1") {
+        config.compiler_inlining(wasmtime::Inlining::Yes);
+    }
+    Box::new(wasm_config_t { config })
 }
